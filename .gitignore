# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# FUSE leftovers — stale inode copies created when an open file is replaced.
# They are byte-for-byte old versions of real source files, so without this they
# show up as untracked and can be committed by accident.
.fuse_hidden*

# jetbrains setting folder
.idea/
