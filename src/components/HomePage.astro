---
import ToolCard from './ToolCard.astro';
import SiteSearch from './SiteSearch.astro';
import { categories, type CategoryKey } from '../data/categories';
import { useTranslations, localizedPath } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { getCollection } from 'astro:content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const allTools = (await getCollection('tools')).filter((tool) => tool.data.lang === lang);
const allPrompts = (await getCollection('prompts')).filter((p) => p.data.lang === lang);

const latest = [...allTools]
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 6);
const featured = allTools.filter((tool) => tool.data.featured).slice(0, 6);
const freeTools = allTools.filter((tool) => tool.data.pricingType !== 'paid').slice(0, 6);
const topRated = [...allTools]
  .filter((tool) => typeof tool.data.rating === 'number')
  .sort((a, b) => (b.data.rating ?? 0) - (a.data.rating ?? 0))
  .slice(0, 3);

// Auto-generate a section per category that actually has tools —
// new tools/categories show up here automatically, no manual edits needed.
const categorySections = Object.entries(categories)
  .map(([slug, cat]) => ({
    slug,
    cat,
    tools: allTools.filter((tool) => tool.data.category === slug).slice(0, 6),
  }))
  .filter((section) => section.tools.length > 0);

// Only surface categories that have a real landing page behind them — a pill
// pointing at an empty category would be a dead link.
const availableCategories = (Object.keys(categories) as CategoryKey[]).filter((key) =>
  allTools.some((tool) => tool.data.category === key)
);

// PDF quick actions — mirrors /pdf-tools, shortest path to the actual tool
const pdfQuick =
  lang === 'ar'
    ? [
        { icon: '🔗', name: 'دمج PDF', href: '/pdf-tools/merge-pdf' },
        { icon: '✂️', name: 'تقسيم PDF', href: '/pdf-tools/split-pdf' },
        { icon: '🔄', name: 'تدوير PDF', href: '/pdf-tools/rotate-pdf' },
        { icon: '💧', name: 'علامة مائية', href: '/pdf-tools/watermark-pdf' },
        { icon: '🖼️', name: 'صور إلى PDF', href: '/pdf-tools/images-to-pdf' },
        { icon: '📄', name: 'PDF إلى صور', href: '/pdf-tools/pdf-to-images' },
      ]
    : [
        { icon: '🔗', name: 'Merge PDF', href: '/pdf-tools/merge-pdf' },
        { icon: '✂️', name: 'Split PDF', href: '/pdf-tools/split-pdf' },
        { icon: '🔄', name: 'Rotate PDF', href: '/pdf-tools/rotate-pdf' },
        { icon: '💧', name: 'Watermark PDF', href: '/pdf-tools/watermark-pdf' },
        { icon: '🖼️', name: 'Images to PDF', href: '/pdf-tools/images-to-pdf' },
        { icon: '📄', name: 'PDF to Images', href: '/pdf-tools/pdf-to-images' },
      ];

// Floating hero cards — built from real data, never placeholders
const palette = ['#4fd1c5', '#9b8cfb', '#f5a623', '#34d399', '#f472b6'];
const initialsOf = (name: string) =>
  name
    .replace(/[^\p{L}\p{N} ]/gu, '')
    .split(' ')
    .slice(0, 2)
    .map((w) => w[0])
    .join('')
    .toUpperCase();

const floatCards = [
  ...topRated.map((tool, i) => ({
    badge: initialsOf(tool.data.name),
    color: palette[i % palette.length],
    title: tool.data.name,
    meta: `${categories[tool.data.category].icon} ${categories[tool.data.category][lang]} · ★ ${tool.data.rating?.toFixed(1)}`,
  })),
  {
    badge: '🔗',
    color: '#9b8cfb',
    title: pdfQuick[0].name,
    meta: t('home.hero.floatPdfMeta'),
  },
  {
    badge: '✂️',
    color: '#4fd1c5',
    title: pdfQuick[1].name,
    meta: t('home.hero.floatPdfMeta'),
  },
];

const stats = [
  { num: allTools.length, label: t('home.stats.tools') },
  { num: pdfQuick.length, label: t('home.stats.pdf') },
  { num: allPrompts.length, label: t('home.stats.prompts') },
  { num: Object.keys(categories).length, label: t('home.stats.categories') },
];

const why = [
  { icon: '🈯', title: t('home.why.1.title'), body: t('home.why.1.body') },
  { icon: '🔒', title: t('home.why.2.title'), body: t('home.why.2.body') },
  { icon: '⚖️', title: t('home.why.3.title'), body: t('home.why.3.body') },
  { icon: '🔄', title: t('home.why.4.title'), body: t('home.why.4.body') },
];
---

<!-- ============ HERO ============ -->
<section class="hero">
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-glow"></div>
    <div class="hero-grid"></div>
  </div>

  <div class="wrap hero-inner">
    <div class="hero-copy">
      <span class="eyebrow">
        <span class="pulse"></span>
        {t('home.hero.eyebrow').replace('{tools}', String(allTools.length)).replace('{pdf}', String(pdfQuick.length))}
      </span>

      <h1>
        {t('home.hero.h1a')}<br />
        <span class="grad">{t('home.hero.h1b')}</span>
      </h1>

      <p class="lede">{t('home.hero.lede')}</p>

      <div class="hero-search">
        <SiteSearch
          lang={lang}
          placeholder={t('home.hero.searchPlaceholder')}
          noResultsText={t('search.noResults')}
        />
      </div>

      <div class="cta-row">
        <a href={localizedPath(lang, '/ai-tools')} class="btn btn-primary">{t('home.hero.ctaTools')}</a>
        <a href={localizedPath(lang, '/pdf-tools')} class="btn btn-ghost">{t('home.hero.ctaPdf')}</a>
      </div>
    </div>

    <div class="float-stage" aria-hidden="true">
      {floatCards.map((card, i) => (
        <div class={`fcard f${i + 1}`}>
          <span class="fbadge" style={`background:${card.color}22; color:${card.color}`}>{card.badge}</span>
          <span class="ftext">
            <b>{card.title}</b>
            <small>{card.meta}</small>
          </span>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ============ PDF QUICK ACTIONS ============ -->
<section class="wrap section reveal">
  <div class="sec-head">
    <span class="sec-label">{t('home.pdf.label')}</span>
    <h2>{t('home.pdf.title')}</h2>
    <p>{t('home.pdf.body')}</p>
  </div>
  <div class="quick-grid">
    {pdfQuick.map((tool) => (
      <a href={localizedPath(lang, tool.href)} class="qcard">
        <span class="qicon">{tool.icon}</span>
        <b>{tool.name}</b>
      </a>
    ))}
  </div>
</section>

<!-- ============ POPULAR ============ -->
{featured.length > 0 && (
  <section class="wrap section reveal">
    <div class="sec-head">
      <span class="sec-label">{t('home.label.discover')}</span>
      <h2>{t('home.popular')}</h2>
    </div>
    <div class="grid">
      {featured.map((tool) => (
        <ToolCard
          href={localizedPath(lang, `/ai-tools/${tool.id.split('/')[1]}`)}
          name={tool.data.name}
          tagline={tool.data.tagline}
          category={tool.data.category}
          pricingType={tool.data.pricingType}
          rating={tool.data.rating}
          lang={lang}
        />
      ))}
    </div>
  </section>
)}

<!-- ============ LATEST ============ -->
<section class="wrap section reveal">
  <div class="sec-head">
    <span class="sec-label">{t('home.label.new')}</span>
    <h2>{t('home.latest')}</h2>
  </div>
  <div class="grid">
    {latest.map((tool) => (
      <ToolCard
        href={localizedPath(lang, `/ai-tools/${tool.id.split('/')[1]}`)}
        name={tool.data.name}
        tagline={tool.data.tagline}
        category={tool.data.category}
        pricingType={tool.data.pricingType}
        rating={tool.data.rating}
        lang={lang}
      />
    ))}
  </div>
</section>

<!-- ============ FREE ============ -->
{freeTools.length > 0 && (
  <section class="wrap section reveal">
    <div class="sec-head">
      <span class="sec-label">{t('home.label.free')}</span>
      <h2>{t('home.freeTools')}</h2>
    </div>
    <div class="grid">
      {freeTools.map((tool) => (
        <ToolCard
          href={localizedPath(lang, `/ai-tools/${tool.id.split('/')[1]}`)}
          name={tool.data.name}
          tagline={tool.data.tagline}
          category={tool.data.category}
          pricingType={tool.data.pricingType}
          rating={tool.data.rating}
          lang={lang}
        />
      ))}
    </div>
  </section>
)}

<!-- ============ PER-CATEGORY (auto) ============ -->
{categorySections.map((section) => (
  <section class="wrap section reveal">
    <div class="sec-head">
      <h2>{section.cat.icon} {section.cat[lang]}</h2>
    </div>
    <div class="grid">
      {section.tools.map((tool) => (
        <ToolCard
          href={localizedPath(lang, `/ai-tools/${tool.id.split('/')[1]}`)}
          name={tool.data.name}
          tagline={tool.data.tagline}
          category={tool.data.category}
          pricingType={tool.data.pricingType}
          rating={tool.data.rating}
          lang={lang}
        />
      ))}
    </div>
  </section>
))}

<!-- ============ CATEGORIES ============ -->
<section class="wrap section reveal">
  <div class="sec-head">
    <span class="sec-label">{t('home.label.browse')}</span>
    <h2>{t('home.categories')}</h2>
  </div>
  <div class="cat-grid">
    {availableCategories.map((slug) => (
      <a href={localizedPath(lang, `/ai-tools/category/${slug}`)} class="cat-pill">
        <span>{categories[slug].icon}</span> {categories[slug][lang]}
      </a>
    ))}
  </div>
</section>

<!-- ============ WHY OMXHUB ============ -->
<section class="wrap section reveal">
  <div class="sec-head">
    <span class="sec-label">{t('home.why.label')}</span>
    <h2>{t('home.why.title')}</h2>
  </div>
  <div class="why-grid">
    {why.map((item) => (
      <div class="wcard">
        <span class="wicon">{item.icon}</span>
        <b>{item.title}</b>
        <p>{item.body}</p>
      </div>
    ))}
  </div>
</section>

<!-- ============ STATS ============ -->
<section class="wrap section reveal">
  <div class="stats-band">
    {stats.map((stat) => (
      <div class="stat">
        <div class="stat-num" data-count={stat.num}>0</div>
        <div class="stat-label">{stat.label}</div>
      </div>
    ))}
  </div>
</section>

<!-- ============ SUPPORT ============ -->
<section class="wrap section reveal">
  <div class="support-box">
    <h2>{t('home.support.title')}</h2>
    <p>{t('home.support.body')}</p>
    <a href={localizedPath(lang, '/support')} class="btn btn-kofi">☕ {t('footer.support')}</a>
  </div>
</section>

<script>
  // Scroll reveal
  const revealEls = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
    );
    revealEls.forEach((el) => io.observe(el));
  } else {
    revealEls.forEach((el) => el.classList.add('is-visible'));
  }

  // Animated counters
  const counters = document.querySelectorAll<HTMLElement>('[data-count]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduceMotion || !('IntersectionObserver' in window)) {
    counters.forEach((el) => (el.textContent = el.dataset.count ?? '0'));
  } else {
    const cio = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          const target = Number(el.dataset.count ?? 0);
          const step = Math.max(1, Math.round(target / 24));
          let current = 0;
          const timer = setInterval(() => {
            current += step;
            if (current >= target) {
              current = target;
              clearInterval(timer);
            }
            el.textContent = String(current);
          }, 40);
          cio.unobserve(el);
        });
      },
      { threshold: 0.4 }
    );
    counters.forEach((el) => cio.observe(el));
  }
</script>

<style>
  /* ---------- HERO ---------- */
  .hero {
    position: relative;
    padding: 72px 0 84px;
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 62px 62px;
    -webkit-mask-image: radial-gradient(ellipse 78% 62% at 50% 0%, #000 38%, transparent 100%);
    mask-image: radial-gradient(ellipse 78% 62% at 50% 0%, #000 38%, transparent 100%);
    opacity: 0.55;
  }
  .hero-glow {
    position: absolute;
    top: -300px;
    left: 50%;
    transform: translateX(-50%);
    width: 1000px;
    max-width: 140%;
    height: 620px;
    background:
      radial-gradient(circle at 38% 52%, color-mix(in srgb, var(--accent) 16%, transparent), transparent 62%),
      radial-gradient(circle at 66% 42%, color-mix(in srgb, var(--accent-2) 15%, transparent), transparent 62%);
    filter: blur(16px);
  }
  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 52px;
    align-items: center;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 26%, transparent);
    padding: 6px 14px;
    border-radius: 100px;
    margin-bottom: 20px;
  }
  .pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    animation: pulse 2s infinite;
    flex-shrink: 0;
  }
  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 50%, transparent); }
    50% { box-shadow: 0 0 0 6px transparent; }
  }

  .hero h1 {
    font-size: clamp(1.9rem, 4.8vw, 3.2rem);
    line-height: 1.25;
    letter-spacing: -0.02em;
    margin: 0 0 16px;
  }
  .grad {
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .lede {
    color: var(--text-dim);
    max-width: 520px;
    margin: 0 0 26px;
    font-size: 1.02rem;
  }
  .hero-search :global(.site-search) {
    margin-inline: 0;
    max-width: 540px;
  }

  .cta-row {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 22px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    border-radius: 12px;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    transition: transform 0.18s, border-color 0.18s, box-shadow 0.18s, color 0.18s;
  }
  .btn-primary {
    background: var(--accent);
    color: var(--accent-ink);
  }
  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 26px color-mix(in srgb, var(--accent) 26%, transparent);
  }
  .btn-ghost {
    border: 1px solid color-mix(in srgb, var(--accent-2) 45%, var(--line));
    color: var(--text);
    background: color-mix(in srgb, var(--accent-2) 10%, var(--surface));
  }
  .btn-ghost:hover {
    transform: translateY(-2px);
    border-color: var(--accent-2);
    color: var(--accent-2);
    background: color-mix(in srgb, var(--accent-2) 16%, var(--surface));
  }

  /* floating cards */
  .float-stage {
    position: relative;
    height: 350px;
  }
  .fcard {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 11px;
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    backdrop-filter: blur(10px);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 12px 16px;
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.28);
    animation: float 7s ease-in-out infinite;
    white-space: nowrap;
  }
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-12px); }
  }
  .fbadge {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.82rem;
    flex-shrink: 0;
  }
  .ftext b { display: block; font-size: 0.9rem; line-height: 1.4; }
  .ftext small { display: block; font-size: 0.72rem; color: var(--text-dim); }
  .f1 { top: 6px; inset-inline-end: 26px; animation-delay: 0s; }
  .f2 { top: 92px; inset-inline-end: 132px; animation-delay: 0.9s; }
  .f3 { top: 178px; inset-inline-end: 4px; animation-delay: 1.8s; }
  .f4 { top: 262px; inset-inline-end: 110px; animation-delay: 2.6s; }
  .f5 { top: 100px; inset-inline-start: 0; animation-delay: 1.3s; }

  /* ---------- SECTIONS ---------- */
  .section { padding: 56px 0; }
  .sec-head { margin-bottom: 26px; }
  .sec-label {
    display: block;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 8px;
  }
  .sec-head h2 {
    font-size: clamp(1.35rem, 2.6vw, 1.85rem);
    letter-spacing: -0.015em;
    margin: 0;
  }
  .sec-head p {
    color: var(--text-dim);
    margin: 8px 0 0;
    font-size: 0.95rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 18px;
  }

  /* quick actions */
  .quick-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 12px;
  }
  .qcard {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 20px 10px;
    text-align: center;
    text-decoration: none;
    color: var(--text);
    transition: transform 0.18s, border-color 0.18s;
  }
  .qcard:hover { transform: translateY(-4px); border-color: var(--accent); }
  .qicon { display: block; font-size: 1.5rem; margin-bottom: 8px; }
  .qcard b { font-size: 0.86rem; }

  /* categories */
  .cat-grid { display: flex; flex-wrap: wrap; gap: 12px; }
  .cat-pill {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 100px;
    padding: 10px 18px;
    text-decoration: none;
    color: var(--text);
    font-size: 0.9rem;
    transition: transform 0.18s, border-color 0.18s, color 0.18s;
  }
  .cat-pill:hover { border-color: var(--accent-2); color: var(--accent-2); transform: translateY(-2px); }

  /* why */
  .why-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .wcard {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 24px 20px;
  }
  .wicon { display: block; font-size: 1.6rem; margin-bottom: 12px; }
  .wcard b { display: block; font-size: 1rem; margin-bottom: 6px; }
  .wcard p { margin: 0; font-size: 0.87rem; color: var(--text-dim); }

  /* stats */
  .stats-band {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: var(--surface);
    padding: 40px 22px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    text-align: center;
  }
  .stats-band::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(620px circle at 50% 120%, color-mix(in srgb, var(--accent-2) 12%, transparent), transparent 68%);
  }
  .stat { position: relative; }
  .stat-num {
    font-size: clamp(1.9rem, 4vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    direction: ltr;
    color: var(--accent);
    line-height: 1.2;
  }
  .stat-label { font-size: 0.85rem; color: var(--text-dim); }

  /* support */
  .support-box {
    border: 1px solid color-mix(in srgb, var(--accent-2) 28%, transparent);
    border-radius: 20px;
    background: linear-gradient(160deg, color-mix(in srgb, var(--accent-2) 9%, transparent), var(--surface));
    padding: 48px 32px;
    text-align: center;
  }
  .support-box h2 { margin: 0 0 12px; font-size: clamp(1.35rem, 2.6vw, 1.85rem); }
  .support-box p {
    color: var(--text-dim);
    max-width: 520px;
    margin: 0 auto 24px;
    font-size: 0.95rem;
  }
  .btn-kofi { background: var(--accent-2); color: #0a0d12; }
  .btn-kofi:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 28px color-mix(in srgb, var(--accent-2) 30%, transparent);
  }

  /* reveal */
  .reveal {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.55s ease, transform 0.55s ease;
  }
  .reveal.is-visible { opacity: 1; transform: none; }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width: 900px) {
    .hero { padding: 48px 0 60px; }
    .hero-inner { grid-template-columns: 1fr; gap: 34px; }
