---
/**
 * The homepage, for both locales.
 *
 * ## What this rebuild changed, and why
 *
 * The previous version rendered the same thirty tools **eleven times**: a
 * "popular" grid, a "latest" grid, a "free" grid, and then one auto-generated
 * grid per category — seven more, all identical in shape. It was not a design
 * problem so much as an information problem: a visitor scrolling past the fourth
 * indistinguishable grid of cards learns nothing new and stops reading, and the
 * page's real assets — the free browser tools, the comparisons, the tutorials —
 * were buried under the repetition or missing from the page entirely.
 *
 * So the tool grids collapse into **one** tabbed section, and the space that
 * frees up goes to the sections that were never here: image tools, tutorials and
 * prompts. Every section now answers a different question.
 *
 * ## The ordering is deliberate
 *
 * Free tools come before the directory. The directory is what the site is
 * *about*, but the browser tools are what a first-time visitor can use in ten
 * seconds without trusting us about anything — and they are the part no
 * competitor can copy by writing more listicles. Leading with the thing that
 * works immediately is the same instinct behind putting a live editor at the top
 * of a developer-tool homepage.
 *
 * ## What was removed
 *
 * - **The seven per-category grids.** `/ai-tools` and the category landing pages
 *   cover that job properly; the homepage was competing with them using worse
 *   copy. No tool is orphaned — the categories row still links every landing
 *   page, and the directory link sits under the grid.
 * - **The animated stats band.** With real counts now in the hero, a second set
 *   of the same numbers 900 px further down was repetition wearing a different
 *   coat. Its counter script went with it, which is JavaScript the critical path
 *   no longer pays for.
 * - **The five floating hero cards.** Decorative (`aria-hidden`), three of five
 *   hidden on mobile anyway, and they crowded the one element in the hero that
 *   should dominate it. The hero is centred on the search now.
 */
import ToolCard from './ToolCard.astro';
import ComparisonCard from './ComparisonCard.astro';
import TutorialCard from './TutorialCard.astro';
import PromptCard from './PromptCard.astro';
import SiteSearch from './SiteSearch.astro';
import { byPopularity, comparisonPath, inLang } from '../lib/comparisons';
import {
  byPopularity as tutorialsByPopularity,
  inLang as tutorialsInLang,
  tutorialPath,
} from '../lib/tutorials';
import { categories, type CategoryKey } from '../data/categories';
import { pdfTools, pdfToolPath } from '../data/pdf-tools';
import { imageTools, imageToolPath } from '../data/image-tools';
import { useTranslations, localizedPath } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { getCollection } from 'astro:content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const arrow = lang === 'ar' ? '←' : '→';

const allTools = (await getCollection('tools')).filter((tool) => tool.data.lang === lang);
const allPrompts = (await getCollection('prompts')).filter((p) => p.data.lang === lang);

// Highest-intent pages on the site — surfaced from the homepage so they get the
// strongest internal link available.
const topComparisons = inLang(await getCollection('comparisons'), lang)
  .sort(byPopularity)
  .slice(0, 3);

const topTutorials = tutorialsInLang(await getCollection('tutorials'), lang)
  .sort(tutorialsByPopularity)
  .slice(0, 3);

const topPrompts = allPrompts.slice(0, 3);

const slugOf = (entry: { id: string }) => entry.id.split('/')[1];

/**
 * The three tabs of the single tool grid.
 *
 * All three sets are rendered into the HTML and only hidden with the `hidden`
 * attribute, so every card is in the document on first paint: crawlable, and
 * present for anyone whose JavaScript never runs. The tabs only decide which
 * panel is shown.
 */
const toolTabs = [
  {
    id: 'featured',
    label: t('home.tools.tabFeatured'),
    tools: allTools.filter((tool) => tool.data.featured).slice(0, 6),
  },
  {
    id: 'new',
    label: t('home.tools.tabNew'),
    tools: [...allTools]
      .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
      .slice(0, 6),
  },
  {
    id: 'free',
    label: t('home.tools.tabFree'),
    tools: allTools.filter((tool) => tool.data.pricingType !== 'paid').slice(0, 6),
  },
].filter((tab) => tab.tools.length > 0);

// Only surface categories that have a real landing page behind them — a pill
// pointing at an empty category would be a dead link.
const availableCategories = (Object.keys(categories) as CategoryKey[]).filter((key) =>
  allTools.some((tool) => tool.data.category === key)
);

// Free-tool groups, derived from the catalogues so the homepage can never drift
// out of sync with the hubs. Every tool is linked, which also means the homepage
// alone guarantees no PDF or image tool page is ever orphaned.
const freeGroups = [
  {
    title: t('home.free.pdfGroup'),
    all: '/pdf-tools',
    tools: pdfTools.map((tool) => ({
      icon: tool.icon,
      name: tool.name[lang],
      href: pdfToolPath(tool.slug),
    })),
  },
  {
    title: t('home.free.imageGroup'),
    all: '/image-tools',
    tools: imageTools.map((tool) => ({
      icon: tool.icon,
      name: tool.name[lang],
      href: imageToolPath(tool.slug),
    })),
  },
];

const freeToolCount = pdfTools.length + imageTools.length;

// Trust indicators. Counted from the catalogues, never typed in — a hardcoded
// number here is a claim that goes stale silently, which is the opposite of what
// a trust indicator is for.
const trust = [
  { icon: '🔒', text: t('home.hero.trustFree').replace('{free}', String(freeToolCount)) },
  { icon: '✍️', text: t('home.hero.trustTools').replace('{tools}', String(allTools.length)) },
  { icon: '⚡', text: t('home.hero.trustNoAuth') },
];

/**
 * Search starting points.
 *
 * An empty search box is a blank-page problem: someone who does not already know
 * what this site holds has nothing to type. Each chip is a query that returns
 * real results across more than one content type, which is also the quickest way
 * to show that search covers tools, comparisons *and* our own utilities.
 */
const searchChips =
  lang === 'ar'
    ? [
        { label: 'ChatGPT', query: 'ChatGPT' },
        { label: 'توليد صور', query: 'صور' },
        { label: 'ضغط ملف', query: 'ضغط' },
        { label: 'برمجة', query: 'برمجة' },
      ]
    : [
        { label: 'ChatGPT', query: 'ChatGPT' },
        { label: 'Image generation', query: 'image' },
        { label: 'Compress a file', query: 'compress' },
        { label: 'Coding', query: 'coding' },
      ];

const why = [
  { icon: '🈯', title: t('home.why.1.title'), body: t('home.why.1.body') },
  { icon: '🔒', title: t('home.why.2.title'), body: t('home.why.2.body') },
  { icon: '⚖️', title: t('home.why.3.title'), body: t('home.why.3.body') },
  { icon: '🔄', title: t('home.why.4.title'), body: t('home.why.4.body') },
];
---

<!-- ============ HERO ============ -->
<section class="hero">
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-glow"></div>
    <div class="hero-grid"></div>
  </div>

  <div class="wrap hero-inner">
    <span class="eyebrow">
      <span class="pulse" aria-hidden="true"></span>
      {t('home.hero.eyebrow')}
    </span>

    <h1>
      {t('home.hero.h1a')}<br />
      <span class="grad">{t('home.hero.h1b')}</span>
    </h1>

    <p class="lede">{t('home.hero.lede')}</p>

    <div class="hero-search">
      <SiteSearch
        lang={lang}
        variant="hero"
        shortcut
        placeholder={t('home.hero.searchPlaceholder')}
        noResultsText={t('search.noResults')}
        label={t('home.search.label')}
        searchingText={t('home.search.searching')}
        countTemplate={t('home.search.count')}
        chips={searchChips}
        chipsLabel={t('home.search.chipsLabel')}
      />
    </div>

    <div class="cta-row">
      <a href={localizedPath(lang, '/ai-tools')} class="btn btn-primary">{t('home.hero.ctaTools')}</a>
      <a href="#free-tools" class="btn btn-ghost">{t('home.hero.ctaPdf')}</a>
    </div>

    <ul class="trust-row">
      {trust.map((item) => (
        <li>
          <span aria-hidden="true">{item.icon}</span>
          {item.text}
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- ============ FREE TOOLS ============ -->
<section class="wrap section reveal" id="free-tools">
  <div class="sec-head">
    <div class="sec-head-text">
      <span class="sec-label">{t('home.free.label')}</span>
      <h2>{t('home.free.title')}</h2>
      <p>{t('home.free.body')}</p>
    </div>
  </div>

  {freeGroups.map((group) => (
    <div class="tool-group">
      <div class="group-head">
        <h3>{group.title}</h3>
        <a href={localizedPath(lang, group.all)} class="sec-more">
          {group.title} {arrow}
        </a>
      </div>
      <div class="quick-grid">
        {group.tools.map((tool) => (
          <a href={localizedPath(lang, tool.href)} class="qcard">
            <span class="qicon" aria-hidden="true">{tool.icon}</span>
            <b>{tool.name}</b>
          </a>
        ))}
      </div>
    </div>
  ))}
</section>

<!-- ============ AI DIRECTORY (one grid, three tabs) ============ -->
{toolTabs.length > 0 && (
  <section class="wrap section reveal">
    <div class="sec-head">
      <div class="sec-head-text">
        <span class="sec-label">{t('home.tools.label')}</span>
        <h2>{t('home.tools.title')}</h2>
        <p>{t('home.tools.body')}</p>
      </div>
      <div class="tablist" role="tablist" aria-label={t('home.tools.title')}>
        {toolTabs.map((tab, index) => (
          <button
            type="button"
            role="tab"
            id={`tooltab-${tab.id}`}
            class="tab"
            aria-controls={`toolpanel-${tab.id}`}
            aria-selected={index === 0 ? 'true' : 'false'}
            tabindex={index === 0 ? 0 : -1}
          >
            {tab.label}
          </button>
        ))}
      </div>
    </div>

    {toolTabs.map((tab, index) => (
      <div
        role="tabpanel"
        id={`toolpanel-${tab.id}`}
        aria-labelledby={`tooltab-${tab.id}`}
        tabindex="0"
        hidden={index !== 0}
      >
        <div class="grid">
          {tab.tools.map((tool) => (
            <ToolCard
              href={localizedPath(lang, `/ai-tools/${slugOf(tool)}`)}
              name={tool.data.name}
              slug={slugOf(tool)}
              tagline={tool.data.tagline}
              category={tool.data.category}
              pricingType={tool.data.pricingType}
              rating={tool.data.rating}
              lang={lang}
            />
          ))}
        </div>
      </div>
    ))}

    <a href={localizedPath(lang, '/ai-tools')} class="sec-more">{t('home.tools.all')} {arrow}</a>
  </section>
)}

<!-- ============ COMPARISONS ============ -->
{topComparisons.length > 0 && (
  <section class="wrap section reveal">
    <div class="sec-head">
      <div class="sec-head-text">
        <span class="sec-label">{t('cmp.index.featuredLabel')}</span>
        <h2>{t('cmp.index.title')}</h2>
        <p>{t('cmp.index.lede')}</p>
      </div>
    </div>
    <div class="grid">
      {topComparisons.map((entry) => (
        <ComparisonCard
          href={localizedPath(lang, comparisonPath(entry))}
          title={entry.data.title}
          subtitle={entry.data.subtitle}
          category={entry.data.category}
          toolA={entry.data.toolA.name}
          toolB={entry.data.toolB.name}
          toolASlug={entry.data.toolA.slug}
          toolBSlug={entry.data.toolB.slug}
          verdictLabel={entry.data.quickPicks[0].label}
          verdictPick={entry.data.quickPicks[0].pick}
          lang={lang}
        />
      ))}
    </div>
    <a href={localizedPath(lang, '/comparisons')} class="sec-more">{t('cmp.breadcrumb')} {arrow}</a>
  </section>
)}

<!-- ============ TUTORIALS ============ -->
{topTutorials.length > 0 && (
  <section class="wrap section reveal">
    <div class="sec-head">
      <div class="sec-head-text">
        <span class="sec-label">{t('home.tutorials.label')}</span>
        <h2>{t('home.tutorials.title')}</h2>
        <p>{t('home.tutorials.body')}</p>
      </div>
    </div>
    <div class="grid">
      {topTutorials.map((entry) => (
        <TutorialCard
          href={localizedPath(lang, tutorialPath(entry))}
          title={entry.data.title}
          subtitle={entry.data.subtitle}
          category={entry.data.category}
          level={entry.data.level}
          readingTime={entry.data.readingTime}
          search={`${entry.data.title} ${entry.data.subtitle}`.toLowerCase()}
          lang={lang}
        />
      ))}
    </div>
    <a href={localizedPath(lang, '/tutorials')} class="sec-more">{t('home.tutorials.all')} {arrow}</a>
  </section>
)}

<!-- ============ PROMPTS ============ -->
{topPrompts.length > 0 && (
  <section class="wrap section reveal">
    <div class="sec-head">
      <div class="sec-head-text">
        <span class="sec-label">{t('home.prompts.label')}</span>
        <h2>{t('home.prompts.title')}</h2>
        <p>{t('home.prompts.body')}</p>
      </div>
    </div>
    <div class="grid">
      {topPrompts.map((entry) => (
        <PromptCard
          href={localizedPath(lang, `/prompts/${slugOf(entry)}`)}
          title={entry.data.title}
          description={entry.data.description}
          category={entry.data.category}
          tool={entry.data.tool}
          difficulty={entry.data.difficulty}
          lang={lang}
        />
      ))}
    </div>
    <a href={localizedPath(lang, '/prompts')} class="sec-more">{t('home.prompts.all')} {arrow}</a>
  </section>
)}

<!-- ============ CATEGORIES ============ -->
<section class="wrap section reveal">
  <div class="sec-head">
    <div class="sec-head-text">
      <span class="sec-label">{t('home.label.browse')}</span>
      <h2>{t('home.categories')}</h2>
    </div>
  </div>
  <div class="cat-grid">
    {availableCategories.map((slug) => (
      <a href={localizedPath(lang, `/ai-tools/category/${slug}`)} class="cat-pill">
        <span aria-hidden="true">{categories[slug].icon}</span> {categories[slug][lang]}
      </a>
    ))}
  </div>
</section>

<!-- ============ WHY OMXHUB ============ -->
<section class="wrap section reveal">
  <div class="sec-head">
    <div class="sec-head-text">
      <span class="sec-label">{t('home.why.label')}</span>
      <h2>{t('home.why.title')}</h2>
    </div>
  </div>
  <div class="why-grid">
    {why.map((item) => (
      <div class="wcard">
        <span class="wicon" aria-hidden="true">{item.icon}</span>
        <b>{item.title}</b>
        <p>{item.body}</p>
      </div>
    ))}
  </div>
</section>

<!-- ============ SUPPORT ============ -->
<section class="wrap section reveal">
  <div class="support-box">
    <h2>{t('home.support.title')}</h2>
    <p>{t('home.support.body')}</p>
    <a href={localizedPath(lang, '/support')} class="btn btn-kofi">☕ {t('footer.support')}</a>
  </div>
</section>

<script>
  // Scroll reveal
  const revealEls = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
    );
    revealEls.forEach((el) => io.observe(el));
  } else {
    revealEls.forEach((el) => el.classList.add('is-visible'));
  }

  /**
   * Tool grid tabs, to the WAI-ARIA tabs pattern.
   *
   * Every panel is in the HTML already and only the `hidden` attribute moves, so
   * with JavaScript unavailable the first panel is shown and the rest are still
   * in the document for a crawler. Arrow keys move between tabs and wrap, and
   * only the selected tab is in the tab order — pressing Tab from the tablist
   * should land in the panel, not walk through two more buttons.
   */
  const tablist = document.querySelector<HTMLElement>('.tablist');
  if (tablist) {
    const tabs = [...tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]')];

    const select = (index: number, focus = true) => {
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.setAttribute('aria-selected', on ? 'true' : 'false');
        tab.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(tab.getAttribute('aria-controls') ?? '');
        if (panel) panel.hidden = !on;
      });
      if (focus) tabs[index].focus();
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(index, false));
      tab.addEventListener('keydown', (e) => {
        const isRtl = document.documentElement.dir === 'rtl';
        // In RTL the visual "next" tab is the one to the left, so the arrow keys
        // have to be swapped or they move the highlight the wrong way.
        let delta = 0;
        if (e.key === 'ArrowRight') delta = isRtl ? -1 : 1;
        else if (e.key === 'ArrowLeft') delta = isRtl ? 1 : -1;
        else if (e.key === 'Home') return select(0);
        else if (e.key === 'End') return select(tabs.length - 1);
        if (!delta) return;
        e.preventDefault();
        select((index + delta + tabs.length) % tabs.length);
      });
    });
  }
</script>

<style>
  /* ---------- HERO ---------- */
  /* Centred rather than split. The old two-column layout gave half the hero to
     five decorative floating cards and squeezed the search — the one element a
     visitor is most likely to use — into the remainder. */
  .hero {
    position: relative;
    padding: 96px 0 88px;
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 62px 62px;
    -webkit-mask-image: radial-gradient(ellipse 70% 58% at 50% 0%, #000 30%, transparent 100%);
    mask-image: radial-gradient(ellipse 70% 58% at 50% 0%, #000 30%, transparent 100%);
    opacity: 0.5;
  }
  .hero-glow {
    position: absolute;
    top: -320px;
    left: 50%;
    transform: translateX(-50%);
    width: 1100px;
    max-width: 150%;
    height: 660px;
    background:
      radial-gradient(circle at 38% 52%, color-mix(in srgb, var(--accent) 15%, transparent), transparent 62%),
      radial-gradient(circle at 66% 42%, color-mix(in srgb, var(--accent-2) 14%, transparent), transparent 62%);
    filter: blur(18px);
  }
  .hero-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 9%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 24%, transparent);
    padding: 6px 15px;
    border-radius: 100px;
    margin-bottom: 26px;
  }
  .pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    animation: pulse 2s infinite;
    flex-shrink: 0;
  }
  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 50%, transparent); }
    50% { box-shadow: 0 0 0 6px transparent; }
  }

  /* Larger and tighter than before. A hero headline is the one place on the site
     where display-scale type is correct, and the previous 3.2rem ceiling read as
     a section heading that happened to be at the top of the page. */
  .hero h1 {
    font-size: clamp(2rem, 5.4vw, 3.75rem);
    line-height: 1.18;
    letter-spacing: -0.035em;
    margin: 0 0 20px;
    max-width: 16ch;
  }
  .grad {
    background: linear-gradient(92deg, var(--accent), var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .lede {
    color: var(--text-dim);
    max-width: 62ch;
    margin: 0 0 34px;
    font-size: 1.05rem;
    line-height: 1.75;
  }

  .hero-search { width: 100%; }
  .hero-search :global(.site-search) { margin-inline: auto; }
  /* The chips sit under a centred box, so they centre too. */
  .hero-search :global(.search-chips) { justify-content: center; }

  .cta-row {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 30px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 13px 26px;
    border-radius: 12px;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    transition: transform 0.18s, border-color 0.18s, box-shadow 0.18s, color 0.18s, background 0.18s;
  }
  .btn-primary {
    background: var(--accent);
    color: var(--accent-ink);
  }
  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 26px color-mix(in srgb, var(--accent) 26%, transparent);
  }
  .btn-ghost {
    border: 1px solid color-mix(in srgb, var(--accent-2) 45%, var(--line));
    color: var(--text);
    background: color-mix(in srgb, var(--accent-2) 10%, var(--surface));
  }
  .btn-ghost:hover {
    transform: translateY(-2px);
    border-color: var(--accent-2);
    color: var(--accent-2);
    background: color-mix(in srgb, var(--accent-2) 16%, var(--surface));
  }

  /* Trust row: quiet by design. These are facts a reader checks, not a banner —
     the moment they are styled like a feature band they read as marketing and
     stop doing the job they are there for. */
  .trust-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 26px;
    list-style: none;
    margin: 36px 0 0;
    padding: 0;
  }
  .trust-row li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.86rem;
    color: var(--text-dim);
  }
  .trust-row li span { font-size: 0.95rem; }

  /* ---------- SECTIONS ---------- */
  .section { padding: 72px 0; }
  .sec-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }
  .sec-head-text { max-width: 62ch; }
  .sec-label {
    display: block;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 9px;
  }
  .sec-head h2 {
