---
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  placeholder: string;
  noResultsText: string;
}
const { lang, placeholder, noResultsText } = Astro.props;
const indexUrl = lang === 'ar' ? '/search-index.json' : '/en/search-index.json';
---
<div class="site-search" data-index-url={indexUrl} data-no-results={noResultsText}>
  <form class="search-bar" role="search" autocomplete="off">
    <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
    <input type="search" name="q" class="search-input" placeholder={placeholder} />
  </form>
  <div class="search-results" hidden></div>
</div>

<script>
  class SiteSearchController {
    root: HTMLElement;
    input: HTMLInputElement;
    resultsBox: HTMLElement;
    indexUrl: string;
    noResultsText: string;
    data: any[] | null = null;
    loading: Promise<any[]> | null = null;

    constructor(root: HTMLElement) {
      this.root = root;
      this.input = root.querySelector('.search-input')!;
      this.resultsBox = root.querySelector('.search-results')!;
      this.indexUrl = root.dataset.indexUrl!;
      this.noResultsText = root.dataset.noResults!;

      this.input.addEventListener('input', () => this.onInput());
      this.input.addEventListener('focus', () => this.onInput());
      document.addEventListener('click', (e) => {
        if (!this.root.contains(e.target as Node)) this.hide();
      });
      root.querySelector('form')?.addEventListener('submit', (e) => e.preventDefault());

      // Support deep links like `/?q=chatgpt`. This is what the WebSite
      // SearchAction in our JSON-LD points at, so the endpoint has to be real.
      const initial = new URLSearchParams(window.location.search).get('q');
      if (initial && initial.trim().length >= 2) {
        this.input.value = initial.trim();
        this.onInput();
      }
    }

    async loadData(): Promise<any[]> {
      if (this.data) return this.data;
      if (!this.loading) {
        this.loading = fetch(this.indexUrl)
          .then((r) => r.json())
          .then((d) => (this.data = d));
      }
      return this.loading;
    }

    async onInput() {
      const query = this.input.value.trim();
      if (query.length < 2) {
        this.hide();
        return;
      }
      const data = await this.loadData();
      const q = query.toLowerCase();
      const results = data
        .filter(
          (item) =>
            item.title.toLowerCase().includes(q) ||
            item.description.toLowerCase().includes(q) ||
            item.category.toLowerCase().includes(q)
        )
        .slice(0, 8);
      this.render(results);
    }

    render(results: any[]) {
      if (results.length === 0) {
        this.resultsBox.innerHTML = `<div class="no-results">${this.noResultsText}</div>`;
      } else {
        this.resultsBox.innerHTML = results
          .map(
            (item) => `
            <a href="${item.url}" class="result-item">
              <span class="result-type" data-type="${item.type}">${item.typeLabel}</span>
              <span class="result-text">
                <span class="result-title">${item.title}</span>
                <span class="result-desc">${item.description}</span>
              </span>
            </a>`
          )
          .join('');
      }
      this.resultsBox.hidden = false;
    }

    hide() {
      this.resultsBox.hidden = true;
    }
  }

  document.querySelectorAll<HTMLElement>('.site-search').forEach((el) => new SiteSearchController(el));
</script>

<style is:global>
  .site-search {
    position: relative;
    max-width: 520px;
    margin: 0 auto;
  }
  .search-bar {
    display: flex;
    align-items: center;
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: 100px;
    overflow: hidden;
    padding-inline-start: 18px;
    gap: 10px;
  }
  .search-icon { color: var(--text-dim); flex-shrink: 0; }
  .search-input {
    flex: 1;
    border: none;
    background: transparent;
    color: var(--text);
    padding: 15px 18px 15px 4px;
    font-family: inherit;
    font-size: 0.92rem;
  }
  .search-input:focus { outline: none; }
  .search-input::placeholder { color: var(--text-dim); }

  .search-results {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
    z-index: 20;
    text-align: start;
    max-height: 360px;
    overflow-y: auto;
  }
  .result-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    text-decoration: none;
    color: var(--text);
    border-bottom: 1px solid var(--line);
  }
  .result-item:last-child { border-bottom: none; }
  .result-item:hover { background: var(--surface-2); }
  .result-type {
    flex-shrink: 0;
    font-size: 0.68rem;
    font-family: 'JetBrains Mono', monospace;
    padding: 3px 8px;
    border-radius: 100px;
    background: var(--surface-2);
    color: var(--accent-2);
  }
  .result-type[data-type="tool"] { color: var(--accent); }
  .result-type[data-type="comparison"] { color: var(--paid); }
  .result-text { display: flex; flex-direction: column; min-width: 0; }
  .result-title { font-weight: 700; font-size: 0.92rem; }
  .result-desc {
    font-size: 0.8rem;
    color: var(--text-dim);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .no-results {
    padding: 20px;
    text-align: center;
    color: var(--text-dim);
    font-size: 0.88rem;
  }
</style>
