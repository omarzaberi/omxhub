---
/**
 * Site-wide search.
 *
 * ## What changed, and why it was worth changing
 *
 * This was an input in a rounded box: type two characters, get a list, click
 * something. It worked, and it was the single most prominent element on the
 * homepage — which meant the homepage's most prominent element behaved like a
 * form field on a 2015 blog. The rebuild is about making it behave like the
 * product it sits at the top of:
 *
 * - **It is reachable from the keyboard as a destination**, not just as the next
 *   tab stop. `⌘K` / `Ctrl+K` focuses it, arrows move through results, Enter
 *   opens one, Escape backs out. The hint is only rendered where the shortcut is
 *   actually wired up — a visible `⌘K` badge that does nothing is worse than no
 *   badge, because it is a small promise broken on first try.
 * - **It is a real combobox.** `role="combobox"` with `aria-expanded`,
 *   `aria-activedescendant` and a `listbox` of options, plus a polite live
 *   region announcing how many results there are. A screen-reader user gets the
 *   same information a sighted user gets from the list appearing.
 * - **It says when it is working.** The index is fetched on the first keystroke,
 *   which on a slow connection is a visible pause with no explanation. There is
 *   now a spinner and a "searching" line, shown only while that first fetch is
 *   in flight — never on subsequent queries, which are instant and where a
 *   spinner would just be flicker.
 * - **It suggests where to start.** Empty search boxes are a blank-page problem:
 *   a visitor who does not already know what this site holds has nothing to
 *   type. The chips are real queries that return real results.
 *
 * ## Results are built as nodes, not as HTML strings
 *
 * The old renderer interpolated titles and descriptions into `innerHTML`. The
 * data is our own generated index rather than user input, so this was not a
 * security hole — but a tool named `C & C` or a description containing `<` would
 * render as broken markup, and the fix costs nothing.
 */
import type { Lang } from '../i18n/ui';

interface Chip {
  label: string;
  /** What gets typed into the box when the chip is pressed. */
  query: string;
}

interface Props {
  lang: Lang;
  placeholder: string;
  noResultsText: string;
  /** `hero` is the large homepage treatment; `default` is everything else. */
  variant?: 'default' | 'hero';
  /** Wire up ⌘K / Ctrl+K and render the hint. Only one per page should own it. */
  shortcut?: boolean;
  /** Starting points shown under the box. Omit for no chip row. */
  chips?: Chip[];
  chipsLabel?: string;
  /** Shown while the index is being fetched for the first time. */
  searchingText?: string;
  /** Announced to assistive tech. `{count}` is replaced with the result count. */
  countTemplate?: string;
  /** Accessible name for the input, since the box has no visible <label>. */
  label?: string;
}

const {
  lang,
  placeholder,
  noResultsText,
  variant = 'default',
  shortcut = false,
  chips = [],
  chipsLabel,
  searchingText,
  countTemplate,
  label,
} = Astro.props;

const indexUrl = lang === 'ar' ? '/search-index.json' : '/en/search-index.json';
const fallbackLabel = lang === 'ar' ? 'ابحث في الموقع' : 'Search the site';
const fallbackSearching = lang === 'ar' ? 'جاري البحث…' : 'Searching…';
const fallbackCount = lang === 'ar' ? '{count} نتيجة' : '{count} results';

// Stable ids so `aria-controls` / `aria-activedescendant` resolve even when two
// search boxes exist on one page (the homepage hero and a future header one).
const uid = Math.random().toString(36).slice(2, 8);
const listId = `search-list-${uid}`;
const statusId = `search-status-${uid}`;
---
<div
  class:list={['site-search', variant === 'hero' && 'is-hero']}
  data-index-url={indexUrl}
  data-no-results={noResultsText}
  data-searching={searchingText ?? fallbackSearching}
  data-count-template={countTemplate ?? fallbackCount}
  data-shortcut={shortcut ? 'true' : null}
  data-list-id={listId}
>
  <form class="search-bar" role="search" autocomplete="off">
    <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
    <input
      type="search"
      name="q"
      class="search-input"
      placeholder={placeholder}
      aria-label={label ?? fallbackLabel}
      role="combobox"
      aria-expanded="false"
      aria-controls={listId}
      aria-autocomplete="list"
      aria-haspopup="listbox"
    />
    <span class="search-spinner" hidden aria-hidden="true"></span>
    {shortcut && (
      /* Hidden from assistive tech: it is a hint about a pointer-and-keyboard
         affordance, and announcing it mid-label would just be noise. Hidden on
         touch devices via CSS, where there is no keyboard to press it on. */
      <kbd class="search-kbd" aria-hidden="true"><span data-kbd-mod>Ctrl</span> K</kbd>
    )}
  </form>

  <div class="search-results" id={listId} role="listbox" aria-label={label ?? fallbackLabel} hidden></div>
  <p class="search-status" id={statusId} role="status" aria-live="polite"></p>

  {chips.length > 0 && (
    <div class="search-chips">
      {chipsLabel && <span class="chips-label">{chipsLabel}</span>}
      {chips.map((chip) => (
        <button type="button" class="chip" data-query={chip.query}>{chip.label}</button>
      ))}
    </div>
  )}
</div>

<script>
  interface SearchItem {
    title: string;
    description: string;
    category: string;
    url: string;
    type: string;
    typeLabel: string;
  }

  class SiteSearchController {
    root: HTMLElement;
    input: HTMLInputElement;
    resultsBox: HTMLElement;
    status: HTMLElement | null;
    spinner: HTMLElement | null;
    indexUrl: string;
    noResultsText: string;
    searchingText: string;
    countTemplate: string;
    listId: string;
    data: SearchItem[] | null = null;
    loading: Promise<SearchItem[]> | null = null;
    /** Index of the highlighted option, or -1 for "none". */
    active = -1;
    items: HTMLAnchorElement[] = [];

    constructor(root: HTMLElement) {
      this.root = root;
      this.input = root.querySelector('.search-input')!;
      this.resultsBox = root.querySelector('.search-results')!;
      this.status = root.querySelector('[role="status"]');
      this.spinner = root.querySelector('.search-spinner');
      this.indexUrl = root.dataset.indexUrl!;
      this.noResultsText = root.dataset.noResults!;
      this.searchingText = root.dataset.searching!;
      this.countTemplate = root.dataset.countTemplate!;
      this.listId = root.dataset.listId!;

      this.input.addEventListener('input', () => void this.onInput());
      this.input.addEventListener('focus', () => void this.onInput());
      this.input.addEventListener('keydown', (e) => this.onKeyDown(e));
      document.addEventListener('click', (e) => {
        if (!this.root.contains(e.target as Node)) this.hide();
      });
      root.querySelector('form')?.addEventListener('submit', (e) => {
        e.preventDefault();
        // Enter with nothing highlighted should still do something useful:
        // open the first result rather than silently doing nothing.
        if (this.active === -1 && this.items.length) this.items[0].click();
      });

      for (const chip of root.querySelectorAll<HTMLElement>('.chip')) {
        chip.addEventListener('click', () => {
          this.input.value = chip.dataset.query ?? '';
          this.input.focus();
          void this.onInput();
        });
      }

      if (root.dataset.shortcut === 'true') this.wireShortcut();

      // Support deep links like `/?q=chatgpt`. This is what the WebSite
      // SearchAction in our JSON-LD points at, so the endpoint has to be real.
      const initial = new URLSearchParams(window.location.search).get('q');
      if (initial && initial.trim().length >= 2) {
        this.input.value = initial.trim();
        void this.onInput();
      }
    }

    /**
     * ⌘K on Apple platforms, Ctrl+K elsewhere.
     *
     * The label is corrected here rather than guessed at render time, because
     * the page is static: one build serves both platforms, so the server cannot
     * know which modifier to print.
     */
    wireShortcut() {
      const isApple = /mac|iphone|ipad|ipod/i.test(navigator.platform || navigator.userAgent);
      const mod = this.root.querySelector('[data-kbd-mod]');
      if (mod && isApple) mod.textContent = '⌘';

      document.addEventListener('keydown', (e) => {
        if (e.key.toLowerCase() !== 'k') return;
        if (!(isApple ? e.metaKey : e.ctrlKey)) return;
        e.preventDefault();
        this.input.focus();
        this.input.select();
      });
    }

    async loadData(): Promise<SearchItem[]> {
      if (this.data) return this.data;
      if (!this.loading) {
        this.loading = fetch(this.indexUrl)
          .then((r) => r.json())
          .then((d: SearchItem[]) => (this.data = d));
      }
      return this.loading;
    }

    async onInput() {
      const query = this.input.value.trim();
      if (query.length < 2) {
        this.hide();
        return;
      }

      // Only the very first query waits on the network. Showing a spinner on
      // the instant ones afterwards would be flicker pretending to be feedback.
      if (!this.data) this.setBusy(true);
      const data = await this.loadData();
      this.setBusy(false);

      // A slower fetch can resolve after the user has typed further; render only
      // if this is still the current query.
      if (this.input.value.trim() !== query) return;

      const q = query.toLowerCase();
      const results = data
        .filter(
          (item) =>
            item.title.toLowerCase().includes(q) ||
            item.description.toLowerCase().includes(q) ||
            item.category.toLowerCase().includes(q)
        )
        .slice(0, 8);
      this.render(results);
    }

    setBusy(busy: boolean) {
      if (this.spinner) this.spinner.hidden = !busy;
      if (!busy) return;
      this.resultsBox.replaceChildren(this.line('searching', this.searchingText));
      this.open();
    }

    /** A non-result row: the "searching" and "nothing found" states. */
    line(kind: string, text: string): HTMLElement {
      const el = document.createElement('div');
      el.className = kind === 'searching' ? 'search-note' : 'no-results';
      el.textContent = text;
      return el;
    }

    render(results: SearchItem[]) {
      this.active = -1;
      this.items = [];

      if (results.length === 0) {
        this.resultsBox.replaceChildren(this.line('none', this.noResultsText));
        this.announce(0);
        this.open();
        return;
      }

      const frag = document.createDocumentFragment();
      results.forEach((item, index) => {
        const a = document.createElement('a');
        a.href = item.url;
        a.className = 'result-item';
        a.id = `${this.listId}-opt-${index}`;
        a.setAttribute('role', 'option');
        a.setAttribute('aria-selected', 'false');

        const type = document.createElement('span');
        type.className = 'result-type';
        type.dataset.type = item.type;
        type.textContent = item.typeLabel;

        const text = document.createElement('span');
        text.className = 'result-text';
        const title = document.createElement('span');
        title.className = 'result-title';
        title.textContent = item.title;
        const desc = document.createElement('span');
        desc.className = 'result-desc';
        desc.textContent = item.description;
        text.append(title, desc);

        a.append(type, text);
        this.items.push(a);
        frag.append(a);
      });

      this.resultsBox.replaceChildren(frag);
      this.announce(results.length);
      this.open();
    }

    announce(count: number) {
      if (this.status) this.status.textContent = this.countTemplate.replace('{count}', String(count));
    }

    onKeyDown(e: KeyboardEvent) {
      if (e.key === 'Escape') {
        this.hide();
        this.input.blur();
        return;
      }
      if (e.key === 'Enter' && this.active >= 0) {
        e.preventDefault();
        this.items[this.active]?.click();
        return;
      }
      if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
      if (this.items.length === 0) return;

      e.preventDefault();
      const delta = e.key === 'ArrowDown' ? 1 : -1;
      // Wrapping means Up from the top lands on the last result, which is how
      // every command palette behaves and saves a long press to reach it.
      this.active = (this.active + delta + this.items.length) % this.items.length;
      this.highlight();
    }

    highlight() {
      this.items.forEach((item, index) => {
        const on = index === this.active;
        item.classList.toggle('is-active', on);
        item.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      const current = this.items[this.active];
      if (!current) return;
      this.input.setAttribute('aria-activedescendant', current.id);
      current.scrollIntoView({ block: 'nearest' });
    }

    open() {
      this.resultsBox.hidden = false;
      this.input.setAttribute('aria-expanded', 'true');
    }

    hide() {
      this.resultsBox.hidden = true;
      this.active = -1;
      this.items = [];
      this.input.setAttribute('aria-expanded', 'false');
      this.input.removeAttribute('aria-activedescendant');
    }
  }

  document.querySelectorAll<HTMLElement>('.site-search').forEach((el) => new SiteSearchController(el));
</script>

<style is:global>
  .site-search {
    position: relative;
    max-width: 520px;
    margin: 0 auto;
  }

  .search-bar {
    display: flex;
    align-items: center;
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: 100px;
    padding-inline-start: 18px;
    padding-inline-end: 8px;
    gap: 10px;
    transition: border-color 0.18s, box-shadow 0.18s, background 0.18s;
  }
  .search-bar:hover { border-color: color-mix(in srgb, var(--accent) 40%, var(--line)); }
  /* The ring lives on the bar rather than the input, because the input has no
     border of its own — without this, keyboard focus would be invisible. */
  .search-bar:focus-within {
    border-color: var(--accent);
    background: var(--surface);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 14%, transparent);
  }
  .search-icon { color: var(--text-dim); flex-shrink: 0; transition: color 0.18s; }
  .search-bar:focus-within .search-icon { color: var(--accent); }

  .search-input {
    flex: 1;
    min-width: 0;
    border: none;
    background: transparent;
    color: var(--text);
    padding: 15px 4px;
    font-family: inherit;
    font-size: 0.92rem;
  }
  .search-input:focus { outline: none; }
  .search-input::placeholder { color: var(--text-dim); }
  /* Safari draws its own clear button on type=search, which collides with the
     shortcut badge. */
  .search-input::-webkit-search-decoration,
  .search-input::-webkit-search-cancel-button { -webkit-appearance: none; }

  .search-spinner {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
    border: 2px solid var(--line);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: search-spin 0.7s linear infinite;
  }
  @keyframes search-spin { to { transform: rotate(360deg); } }

  .search-kbd {
    display: none;
    align-items: center;
    gap: 3px;
    flex-shrink: 0;
    font-family: 'JetBrains Mono', 'JetBrains Mono Fallback', monospace;
    font-size: 0.68rem;
    color: var(--text-dim);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 7px;
    padding: 5px 9px;
    direction: ltr;
  }
  /* Only offered where there is a keyboard to press it on. `any-hover` is the
     honest test — a tablet with a keyboard case gets it, a phone does not. */
  @media (any-hover: hover) and (any-pointer: fine) {
    .search-kbd { display: inline-flex; }
  }

  /* ---------- HERO VARIANT ---------- */
  .site-search.is-hero { max-width: 620px; }
  .site-search.is-hero .search-bar {
    border-radius: 16px;
    padding-inline-start: 22px;
    padding-inline-end: 10px;
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    backdrop-filter: blur(8px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.14);
  }
  .site-search.is-hero .search-input { padding: 19px 4px; font-size: 1rem; }
  .site-search.is-hero .search-bar:focus-within {
    box-shadow:
      0 0 0 4px color-mix(in srgb, var(--accent) 15%, transparent),
      0 12px 34px rgba(0, 0, 0, 0.18);
  }

  /* ---------- RESULTS ---------- */
  .search-results {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
    z-index: 20;
    text-align: start;
    max-height: 380px;
    overflow-y: auto;
  }
  .result-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    text-decoration: none;
    color: var(--text);
    border-bottom: 1px solid var(--line);
  }
  .result-item:last-child { border-bottom: none; }
  /* Hover and keyboard highlight are the same state deliberately: two different
     "current row" treatments in one list is a way to lose track of both. */
  .result-item:hover,
  .result-item.is-active {
    background: var(--surface-2);
    box-shadow: inset 3px 0 0 var(--accent);
  }
  [dir='rtl'] .result-item:hover,
  [dir='rtl'] .result-item.is-active { box-shadow: inset -3px 0 0 var(--accent); }
  .result-type {
    flex-shrink: 0;
    font-size: 0.68rem;
    font-family: 'JetBrains Mono', 'JetBrains Mono Fallback', monospace;
    padding: 3px 8px;
    border-radius: 100px;
    background: var(--surface-2);
    color: var(--accent-2);
  }
  .result-type[data-type="tool"] { color: var(--accent); }
  .result-type[data-type="comparison"] { color: var(--paid); }
  .result-type[data-type="tutorial"] { color: var(--free); }
  /* Our own PDF and image tools. Green, matching the "runs in your browser"
     note every one of those pages carries. */
  .result-type[data-type="utility"] { color: var(--free); }
  .result-text { display: flex; flex-direction: column; min-width: 0; }
  .result-title { font-weight: 700; font-size: 0.92rem; }
  .result-desc {
    font-size: 0.8rem;
    color: var(--text-dim);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .no-results,
  .search-note {
    padding: 20px;
    text-align: center;
    color: var(--text-dim);
    font-size: 0.88rem;
  }

  /* The result count, for assistive tech only. Not named `.sr-only`: that class
     is defined (identically) inside four scoped component styles, and adding a
     fifth definition from a global block is how one of them quietly changes. */
  .search-status {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* ---------- CHIPS ---------- */
  .search-chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
  }
  .chips-label {
    font-size: 0.8rem;
    color: var(--text-dim);
    margin-inline-end: 2px;
  }
  .chip {
    background: color-mix(in srgb, var(--surface) 70%, transparent);
    border: 1px solid var(--line);
    border-radius: 100px;
    padding: 7px 15px;
    font-size: 0.82rem;
    font-family: inherit;
    color: var(--text-dim);
    cursor: pointer;
    transition: color 0.16s, border-color 0.16s, transform 0.16s, background 0.16s;
  }
  .chip:hover {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 50%, var(--line));
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    transform: translateY(-1px);
  }
  .chip:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .search-spinner { animation: none; }
    .chip:hover { transform: none; }
  }
</style>
