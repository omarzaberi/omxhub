---
import { categories, pricingLabels } from '../data/categories';
import type { Lang } from '../i18n/ui';

interface Props {
  href: string;
  name: string;
  tagline: string;
  category: keyof typeof categories;
  pricingType: keyof typeof pricingLabels;
  rating?: number;
  lang: Lang;
}
const { href, name, tagline, category, pricingType, rating, lang } = Astro.props;
const cat = categories[category];
const priceLabel = pricingLabels[pricingType][lang];
---
<a href={href} class="card">
  <div class="card-top">
    <span class="cat-badge">{cat.icon} {cat[lang]}</span>
    {rating && <span class="rating">★ {rating.toFixed(1)}</span>}
  </div>
  <h3>{name}</h3>
  <p>{tagline}</p>
  <span class="price-badge" data-type={pricingType}>
    <span class="dot"></span>{priceLabel}
  </span>
</a>

<style>
  .card {
    display: block;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 20px;
    text-decoration: none;
    color: var(--text);
    transition: transform 0.15s, border-color 0.15s;
  }
  .card:hover {
    transform: translateY(-3px);
    border-color: var(--accent);
  }
  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
    font-size: 0.75rem;
  }
  .cat-badge { color: var(--text-dim); }
  .rating { color: var(--paid); font-weight: 600; }
  h3 { margin: 0 0 6px; font-size: 1.15rem; font-weight: 700; }
  p { margin: 0 0 14px; font-size: 0.9rem; color: var(--text-dim); }
  .price-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
    padding: 4px 10px;
    border-radius: 100px;
    background: var(--surface-2);
    color: var(--paid);
  }
  .dot { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
  .price-badge[data-type="free"] { color: var(--free); }
  .price-badge[data-type="freemium"] { color: var(--accent-2); }
</style>
