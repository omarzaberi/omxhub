---
import { categories, pricingLabels } from '../data/categories';
import type { Lang } from '../i18n/ui';
import ToolLogo from './ToolLogo.astro';

interface Props {
  href: string;
  name: string;
  tagline: string;
  category: keyof typeof categories;
  pricingType: keyof typeof pricingLabels;
  rating?: number;
  lang: Lang;
  /** Content slug, so the logo resolves by slug rather than display name. */
  slug?: string;
}
const { href, name, tagline, category, pricingType, rating, lang, slug } = Astro.props;
const cat = categories[category];
const priceLabel = pricingLabels[pricingType][lang];

const ctaLabel = lang === 'ar' ? 'التفاصيل الكاملة' : 'View details';
const arrow = lang === 'ar' ? '←' : '→';
---
<a href={href} class="card">
  <div class="card-head">
    <ToolLogo name={name} slug={slug} size={40} radius={10} />
    <div class="head-text">
      <h3>{name}</h3>
      <span class="cat-badge">{cat.icon} {cat[lang]}</span>
    </div>
    {rating && <span class="rating">★ {rating.toFixed(1)}</span>}
  </div>
  <p>{tagline}</p>
  <div class="card-footer">
    <span class="price-badge" data-type={pricingType}>
      <span class="dot"></span>{priceLabel}
    </span>
    <span class="cta-hint">{ctaLabel} {arrow}</span>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 18px;
    text-decoration: none;
    color: var(--text);
    transition: transform 0.15s, border-color 0.15s;
    height: 100%;
  }
  .card:hover {
    transform: translateY(-3px);
    border-color: var(--accent);
  }
  .card-head {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-bottom: 10px;
  }
  .head-text { flex: 1; min-width: 0; }
  h3 { margin: 0 0 4px; font-size: 1.05rem; font-weight: 700; }
  .cat-badge { font-size: 0.72rem; color: var(--text-dim); }
  .rating { color: var(--paid); font-weight: 600; font-size: 0.8rem; white-space: nowrap; }
  p { margin: 0 0 14px; font-size: 0.88rem; color: var(--text-dim); flex: 1; }
  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
  }
  .price-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.72rem;
    padding: 4px 10px;
    border-radius: 100px;
    background: var(--surface-2);
    color: var(--paid);
  }
  .dot { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
  .price-badge[data-type="free"] { color: var(--free); }
  .price-badge[data-type="freemium"] { color: var(--accent-2); }
  .cta-hint {
    font-size: 0.78rem;
    color: var(--accent);
    font-weight: 600;
    white-space: nowrap;
  }
</style>
