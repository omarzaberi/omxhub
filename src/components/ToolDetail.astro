---
/**
 * Full review page for a single AI tool.
 *
 * Shared by `/ai-tools/[slug]` and `/en/ai-tools/[slug]` so the markup, styles,
 * and structured data stay in one place — the same pattern as CategoryListing.
 */
import Layout from '../layouts/Layout.astro';
import { categories } from '../data/categories';
import { useTranslations, localizedPath } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { getEntry, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { breadcrumbs, faqPage, graph, softwareApplication } from '../lib/schema';

interface Props {
  lang: Lang;
  tool: CollectionEntry<'tools'>;
}
const { lang, tool } = Astro.props;
const t = useTranslations(lang);

const { Content } = await render(tool);
const cat = categories[tool.data.category];
const slug = tool.id.split('/')[1];
const path = `/ai-tools/${slug}`;

const copy =
  lang === 'ar'
    ? {
        home: 'الرئيسية',
        tools: 'أدوات الذكاء الاصطناعي',
        faqHeading: '❓ أسئلة شائعة',
        title: `${tool.data.name} — المميزات والأسعار والبدائل`,
        description: `${tool.data.tagline} — مراجعة كاملة لـ${tool.data.name}: المميزات، الأسعار، الإيجابيات والسلبيات، وأفضل البدائل.`,
      }
    : {
        home: 'Home',
        tools: 'AI Tools',
        faqHeading: '❓ Frequently Asked Questions',
        title: `${tool.data.name} — Features, Pricing & Alternatives`,
        description: `${tool.data.tagline} — A full review of ${tool.data.name}: features, pricing, pros and cons, and the best alternatives.`,
      };

const faq = tool.data.faq ?? [];

const alternativeEntries = tool.data.alternatives
  ? (
      await Promise.all(
        tool.data.alternatives.map((altSlug: string) => getEntry('tools', `${lang}/${altSlug}`))
      )
    ).filter(Boolean)
  : [];

// One JSON-LD graph per page: the trail, the tool itself (with our editorial
// review), and the FAQ that is actually rendered below.
const schema = graph(
  breadcrumbs(lang, [
    { name: copy.home, path: '/' },
    { name: copy.tools, path: '/ai-tools' },
    { name: cat[lang], path: `/ai-tools/category/${tool.data.category}` },
    { name: tool.data.name },
  ]),
  softwareApplication({
    lang,
    name: tool.data.name,
    description: tool.data.tagline,
    path,
    category: tool.data.category,
    pricingType: tool.data.pricingType,
    officialUrl: tool.data.officialUrl,
    rating: tool.data.rating,
    datePublished: tool.data.publishDate,
  }),
  faqPage(faq)
);
---
<Layout title={copy.title} description={copy.description} schema={schema}>
  <article class="wrap tool-page">
    <nav class="breadcrumb" aria-label="breadcrumb">
      <a href={localizedPath(lang, '/')}>{copy.home}</a>
      <span aria-hidden="true">/</span>
      <a href={localizedPath(lang, '/ai-tools')}>{copy.tools}</a>
      <span aria-hidden="true">/</span>
      <a href={localizedPath(lang, `/ai-tools/category/${tool.data.category}`)}>{cat[lang]}</a>
      <span aria-hidden="true">/</span>
      <span class="current">{tool.data.name}</span>
    </nav>

    <a href={localizedPath(lang, `/ai-tools/category/${tool.data.category}`)} class="cat-badge">{cat.icon} {cat[lang]}</a>
    <h1>{tool.data.name}</h1>
    <p class="tagline">{tool.data.tagline}</p>

    <div class="content">
      <Content />
    </div>

    <div class="cols">
      <div class="pros">
        <h2>✅ {t('tool.pros')}</h2>
        <ul>
          {tool.data.pros.map((p: string) => <li>{p}</li>)}
        </ul>
      </div>
      <div class="cons">
        <h2>❌ {t('tool.cons')}</h2>
        <ul>
          {tool.data.cons.map((c: string) => <li>{c}</li>)}
        </ul>
      </div>
    </div>

    <h2>💰 {t('tool.pricing')}</h2>
    <div class="table-scroll">
    <table>
      <thead>
        <tr><th>{t('tool.plan')}</th><th>{t('tool.price')}</th><th>{t('tool.features')}</th></tr>
      </thead>
      <tbody>
        {tool.data.pricingPlans.map((plan: { name: string; price: string; features: string }) => (
          <tr>
            <td>{plan.name}</td>
            <td>{plan.price}</td>
            <td>{plan.features}</td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>

    {alternativeEntries.length > 0 && (
      <>
        <h2>🔄 {t('tool.alternatives')}</h2>
        <div class="alt-links">
          {alternativeEntries.map((alt) => (
            <a href={localizedPath(lang, `/ai-tools/${alt!.id.split('/')[1]}`)}>{alt!.data.name}</a>
          ))}
        </div>
      </>
    )}

    {faq.length > 0 && (
      <section class="tool-faq">
        <h2>{copy.faqHeading}</h2>
        {faq.map((item: { q: string; a: string }) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </section>
    )}

    <a class="cta" href={tool.data.affiliateUrl ?? tool.data.officialUrl} target="_blank" rel="noopener nofollow sponsored">
      🔗 {t('tool.cta')}
    </a>
  </article>
</Layout>

<style>
  .tool-page { padding: 28px 0 80px; max-width: 780px; }
  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    font-size: 0.85rem;
    color: var(--text-dim);
    margin-bottom: 20px;
  }
  .breadcrumb a { color: var(--text-dim); text-decoration: none; }
  .breadcrumb a:hover { color: var(--accent); }
  .breadcrumb .current { color: var(--text); }

  .cat-badge {
    display: inline-block;
    font-size: 0.8rem;
    color: var(--accent);
    background: var(--surface-2);
    padding: 4px 12px;
    border-radius: 100px;
    margin-bottom: 14px;
    font-family: 'JetBrains Mono', monospace;
    text-decoration: none;
    border: 1px solid transparent;
    transition: border-color 0.18s;
  }
  .cat-badge:hover { border-color: var(--accent); }
  h1 { margin: 0 0 8px; font-size: 2rem; }
  .tagline { color: var(--text-dim); margin-bottom: 30px; font-size: 1.05rem; }
  .content :global(h2) { margin-top: 34px; }
  .cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin: 34px 0;
  }
  .cols h2 { font-size: 1.1rem; margin-bottom: 12px; }
  .cols ul { margin: 0; padding-inline-start: 20px; }
  .cols li { margin-bottom: 8px; }
  table {
    width: 100%;
    border-collapse: collapse;
    margin: 16px 0 34px;
  }
  th, td {
    text-align: start;
    padding: 12px 14px;
    border-bottom: 1px solid var(--line);
    font-size: 0.88rem;
  }
  th { color: var(--accent); }
  .alt-links { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 30px; }
  .alt-links a {
    background: var(--surface);
    border: 1px solid var(--line);
    padding: 8px 16px;
    border-radius: 100px;
    text-decoration: none;
    font-size: 0.9rem;
    color: var(--text);
  }
  .alt-links a:hover { border-color: var(--accent); color: var(--accent); }
  .cta {
    display: inline-block;
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 700;
    padding: 14px 28px;
    border-radius: 10px;
    text-decoration: none;
    margin-top: 10px;
  }
  .tool-faq { margin: 34px 0 30px; }
  .tool-faq h2 { font-size: 1.2rem; margin-bottom: 16px; }
  .tool-faq details {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 14px 18px;
    margin-bottom: 10px;
  }
  .tool-faq summary { cursor: pointer; font-weight: 600; }
  .tool-faq p { color: var(--text-dim); margin: 10px 0 0; font-size: 0.92rem; }

  @media (max-width: 820px) {
    .tool-page { padding: 22px 0 60px; }
    h1 { font-size: 1.55rem; }
    .tagline { font-size: 0.98rem; margin-bottom: 22px; }
    .cta { display: block; text-align: center; }
  }
  @media (max-width: 640px) {
    .cols { grid-template-columns: 1fr; gap: 18px; margin: 26px 0; }
  }
</style>
