---
/**
 * The square brand chip used wherever a tool is named: tool cards, the tool
 * detail header, comparison cards, and the homepage hero.
 *
 * One component so the chip is the same size, radius, and background in all
 * four places — and so a tool that gains a logo file gains it everywhere at
 * once. When `src/lib/logos.ts` has no asset for the tool, this falls back to
 * the original deterministic initials chip rather than a broken image.
 *
 * Logos sit on a light plate on purpose. Several brand marks are solid black
 * (Notion, GitHub Copilot, Grok) and would vanish against the dark theme, so
 * the plate is what makes a single asset work in both colour schemes.
 */
import { logoFor, initialsBadge } from '../lib/logos';

interface Props {
  /** Display name — used for the initials fallback and the alt text. */
  name: string;
  /** Slug, when the caller has one. Resolved before `name`. */
  slug?: string;
  /** Chip edge length in px. */
  size?: number;
  /** Corner radius in px. */
  radius?: number;
  /**
   * Set when the tool's name is already rendered next to the chip, which is the
   * usual case — the image is then decorative and should stay out of the
   * accessibility tree instead of repeating the name to a screen reader.
   */
  decorative?: boolean;
}
const { name, slug, size = 40, radius = 10, decorative = true } = Astro.props;

const src = logoFor(slug, name);
const { color, initials } = initialsBadge(name);

const box = `--logo-size:${size}px; --logo-radius:${radius}px`;
---
{
  src ? (
    <span class="tool-logo" style={box}>
      <img
        src={src}
        alt={decorative ? '' : `${name} logo`}
        aria-hidden={decorative ? 'true' : undefined}
        width={size}
        height={size}
        loading="lazy"
        decoding="async"
      />
    </span>
  ) : (
    <span
      class="tool-logo is-initials"
      style={`${box}; --logo-tint:${color}`}
      aria-hidden={decorative ? 'true' : undefined}
    >
      {initials}
    </span>
  )
}

<style>
  .tool-logo {
    flex-shrink: 0;
    width: var(--logo-size);
    height: var(--logo-size);
    border-radius: var(--logo-radius);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    /* Light plate keeps dark brand marks legible on the dark theme. */
    background: #fff;
    border: 1px solid var(--line);
    box-sizing: border-box;
  }
  .tool-logo img {
    width: 72%;
    height: 72%;
    object-fit: contain;
    display: block;
  }
  /* No asset for this tool yet — original tinted initials chip. */
  .tool-logo.is-initials {
    background: color-mix(in srgb, var(--logo-tint) 13%, transparent);
    border-color: color-mix(in srgb, var(--logo-tint) 25%, transparent);
    color: var(--logo-tint);
    font-weight: 700;
    font-size: calc(var(--logo-size) * 0.34);
    font-family: 'JetBrains Mono', 'JetBrains Mono Fallback', monospace;
    letter-spacing: -0.02em;
  }
</style>
