---
/**
 * Full tutorial page.
 *
 * Shared by `/tutorials/[slug]` and `/en/tutorials/[slug]` — same pattern as
 * ToolDetail, CategoryListing, and ComparisonDetail, so markup, styles, and
 * structured data live in exactly one place.
 *
 * Structured data follows the house rule: we only mark up what is rendered.
 * `HowTo` is emitted only when the tutorial actually has visible numbered steps;
 * a conceptual guide gets `Article` alone. The FAQ block is visible, and the
 * breadcrumb trail is visible.
 */
import Layout from '../layouts/Layout.astro';
import TutorialCard from './TutorialCard.astro';
import { categories } from '../data/categories';
import { useTranslations, localizedPath } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { getCollection, getEntry, render } from 'astro:content';
import {
  article,
  breadcrumbs,
  faqPage,
  graph,
  howTo,
  HOME_LABEL,
} from '../lib/schema';
import {
  fill,
  inLang,
  resolveRelated,
  slugOf,
  tutorialPath,
  type Tutorial,
} from '../lib/tutorials';
import { slugOf as comparisonSlugOf } from '../lib/comparisons';

interface Props {
  lang: Lang;
  entry: Tutorial;
}
const { lang, entry } = Astro.props;
const t = useTranslations(lang);
const d = entry.data;

const { Content } = await render(entry);
const cat = categories[d.category];
const path = tutorialPath(entry);
const isRtl = lang === 'ar';
const arrow = isRtl ? '←' : '→';
const hasSteps = d.steps.length > 0;

// --- Related content ------------------------------------------------------
// Every link below is resolved against a real collection entry first. A slug
// that does not exist is silently dropped instead of rendering a 404.
const allTutorials = await getCollection('tutorials');
const related = resolveRelated(allTutorials, entry, 3);

const toolEntries = (
  await Promise.all(
    d.relatedTools.map((slug) => getEntry('tools', `${lang}/${slug}`))
  )
).filter(Boolean);

const promptEntries = (
  await Promise.all(
    d.relatedPrompts.map((slug) => getEntry('prompts', `${lang}/${slug}`))
  )
).filter(Boolean);

const comparisonEntries = (
  await Promise.all(
    d.relatedComparisons.map((slug) => getEntry('comparisons', `${lang}/${slug}`))
  )
).filter(Boolean);

// --- Sections index (visible, no JS) --------------------------------------
const sections = [
  { id: 'intro', label: t('tut.intro'), show: true },
  { id: 'steps', label: t('tut.steps'), show: hasSteps },
  { id: 'mistakes', label: t('tut.mistakes'), show: d.mistakes.length > 0 },
  { id: 'faq', label: t('tut.faq'), show: true },
].filter((s) => s.show);

// --- Formatting helpers ---------------------------------------------------
const locale = isRtl ? 'ar' : 'en-GB';
const fmtDate = (date: Date) =>
  new Intl.DateTimeFormat(locale, {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(date);

const levelLabel = t(`tut.level.${d.level}` as 'tut.level.beginner');

// --- Structured data ------------------------------------------------------
const schema = graph(
  breadcrumbs(lang, [
    { name: HOME_LABEL[lang], path: '/' },
    { name: t('tut.breadcrumb'), path: '/tutorials' },
    { name: d.title },
  ]),
  article({
    lang,
    headline: d.metaTitle,
    description: d.metaDescription,
    path,
    datePublished: d.publishDate,
    dateModified: d.updatedDate,
    about: toolEntries.map((tool) => tool!.data.name),
    keywords: [d.title, cat[lang], levelLabel],
  }),
  // Only when there are steps on the page to back it up.
  hasSteps
    ? howTo({
        lang,
        name: d.title,
        description: d.subtitle,
        path,
        totalTime: `PT${d.readingTime}M`,
        // `prerequisites` is deliberately NOT mapped to `HowToTool`. Those lines
        // are prose conditions ("no credit card needed"), not instruments, and
        // marking them up as tools would be inaccurate. Every tutorial here
        // genuinely needs nothing but a browser, which is the builder's default.
        steps: d.steps.map((step) => ({ name: step.title, text: step.body })),
      })
    : null,
  faqPage(d.faq)
);
---
<Layout title={d.metaTitle} description={d.metaDescription} schema={schema}>
  <article class="wrap tut">
    <nav class="breadcrumb" aria-label="breadcrumb">
      <a href={localizedPath(lang, '/')}>{HOME_LABEL[lang]}</a>
      <span aria-hidden="true">/</span>
      <a href={localizedPath(lang, '/tutorials')}>{t('tut.breadcrumb')}</a>
      <span aria-hidden="true">/</span>
      <span class="current">{d.title}</span>
    </nav>

    <!-- ===================== HERO ===================== -->
    <header class="hero">
      <a href={localizedPath(lang, `/ai-tools/category/${d.category}`)} class="cat-badge">
        {cat.icon} {cat[lang]}
      </a>
      <h1>{d.title}</h1>
      <p class="subtitle">{d.subtitle}</p>

      <p class="dateline">
        <span class="level" data-level={d.level}>{levelLabel}</span>
        <span aria-hidden="true">·</span>
        <span>{fill(t('tut.readingTime'), { count: d.readingTime })}</span>
        <span aria-hidden="true">·</span>
        <time datetime={(d.updatedDate ?? d.publishDate).toISOString().slice(0, 10)}>
          {d.updatedDate
            ? `${t('tut.updated')}: ${fmtDate(d.updatedDate)}`
            : `${t('tut.published')}: ${fmtDate(d.publishDate)}`}
        </time>
      </p>

      <section class="takeaways" aria-labelledby="takeaways-h">
        <h2 id="takeaways-h">{t('tut.takeaways')}</h2>
        <ul>
          {d.takeaways.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      {d.prerequisites.length > 0 && (
        <section class="prereq" aria-labelledby="prereq-h">
          <h2 id="prereq-h">{t('tut.prerequisites')}</h2>
          <ul>
            {d.prerequisites.map((item) => <li>{item}</li>)}
          </ul>
        </section>
      )}

      <nav class="jump" aria-label={t('tut.jump')}>
        {sections.map((s) => <a href={`#${s.id}`}>{s.label}</a>)}
      </nav>
    </header>

    <!-- ===================== EDITORIAL BODY ===================== -->
    <div id="intro" class="content">
      <Content />
    </div>

    <!-- ===================== STEPS ===================== -->
    {hasSteps && (
      <section id="steps" class="block">
        <h2>{t('tut.steps')}</h2>
        <ol class="steps">
          {d.steps.map((step, i) => (
            <li id={`step-${i + 1}`} class="step">
              <span class="step-num" aria-hidden="true">{i + 1}</span>
              <div class="step-body">
                <h3>
                  <span class="sr-only">{t('tut.step')} {i + 1}: </span>
                  {step.title}
                </h3>
                <p>{step.body}</p>
                {step.tip && (
                  <p class="tip">
                    <strong>{t('tut.tip')}:</strong> {step.tip}
                  </p>
                )}
              </div>
            </li>
          ))}
        </ol>
      </section>
    )}

    <!-- ===================== COMMON MISTAKES ===================== -->
    {d.mistakes.length > 0 && (
      <section id="mistakes" class="block">
        <h2>{t('tut.mistakes')}</h2>
        <div class="mistakes">
          {d.mistakes.map((m) => (
            <div class="mistake">
              <p class="wrong">
                <span class="tag">{t('tut.mistakeWrong')}</span>
                {m.wrong}
              </p>
              <p class="right">
                <span class="tag">{t('tut.mistakeRight')}</span>
                {m.right}
              </p>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- ===================== FAQ ===================== -->
    <section id="faq" class="block">
      <h2>❓ {t('tut.faq')}</h2>
      {d.faq.map((item) => (
        <details>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </section>

    <!-- ===================== RELATED TUTORIALS ===================== -->
    {related.length > 0 && (
      <section id="related-tutorials" class="block">
        <h2>{t('tut.relatedTutorials')}</h2>
        <div class="rel-grid">
          {related.map((rel) => (
            <TutorialCard
              href={localizedPath(lang, tutorialPath(rel))}
              title={rel.data.title}
              subtitle={rel.data.subtitle}
              category={rel.data.category}
              level={rel.data.level}
              readingTime={rel.data.readingTime}
              search=""
              lang={lang}
            />
          ))}
        </div>
      </section>
    )}

    <!-- ===================== RELATED PAGES ===================== -->
    <section id="related" class="block related">
      <h2>{t('tut.related')}</h2>

      {toolEntries.length > 0 && (
        <>
          <h3>{t('tut.relatedTools')}</h3>
          <div class="pills">
            {toolEntries.map((tool) => (
              <a href={localizedPath(lang, `/ai-tools/${slugOf(tool!)}`)}>
                {tool!.data.name} {arrow}
              </a>
            ))}
          </div>
        </>
      )}

      {comparisonEntries.length > 0 && (
        <>
          <h3>{t('tut.relatedComparisons')}</h3>
          <div class="pills">
            {comparisonEntries.map((cmp) => (
              <a href={localizedPath(lang, `/comparisons/${comparisonSlugOf(cmp!)}`)}>
                {cmp!.data.title} {arrow}
              </a>
            ))}
          </div>
        </>
      )}

      {promptEntries.length > 0 && (
        <>
          <h3>{t('tut.relatedPrompts')}</h3>
          <div class="pills">
            {promptEntries.map((prompt) => (
              <a href={localizedPath(lang, `/prompts/${slugOf(prompt!)}`)}>
                {prompt!.data.title}
              </a>
            ))}
          </div>
        </>
      )}

      <h3>{t('cmp.relatedMore')}</h3>
      <div class="pills">
        <a href={localizedPath(lang, `/ai-tools/category/${d.category}`)}>
          {cat.icon} {cat[lang]}
        </a>
        <a href={localizedPath(lang, '/ai-tools')}>{t('nav.tools')}</a>
        <a href={localizedPath(lang, '/prompts')}>{t('nav.prompts')}</a>
        <a href={localizedPath(lang, '/comparisons')}>{t('nav.comparisons')}</a>
        <a href={localizedPath(lang, '/pdf-tools')}>{t('nav.pdf')}</a>
        <a href={localizedPath(lang, '/tutorials')} class="all">
          {t('tut.breadcrumb')} {arrow}
        </a>
      </div>
    </section>
  </article>
</Layout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .tut { padding: 28px 0 20px; max-width: 860px; }

  /* ---------- breadcrumb (same as ToolDetail / ComparisonDetail) ---------- */
  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    font-size: 0.85rem;
    color: var(--text-dim);
    margin-bottom: 20px;
  }
  .breadcrumb a { color: var(--text-dim); text-decoration: none; }
  .breadcrumb a:hover { color: var(--accent); }
  .breadcrumb .current { color: var(--text); }

  /* ---------- hero ---------- */
  .cat-badge {
    display: inline-block;
    font-size: 0.8rem;
    color: var(--accent);
    background: var(--surface-2);
    padding: 4px 12px;
    border-radius: 100px;
    margin-bottom: 14px;
    font-family: 'JetBrains Mono', 'JetBrains Mono Fallback', 'IBM Plex Sans Arabic', monospace;
    text-decoration: none;
    border: 1px solid transparent;
    transition: border-color 0.18s;
  }
  .cat-badge:hover { border-color: var(--accent); }

  h1 { margin: 0 0 10px; font-size: 2rem; line-height: 1.3; }
  .subtitle { color: var(--text-dim); font-size: 1.05rem; line-height: 1.8; margin: 0 0 12px; }

  .dateline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 9px;
    margin: 0 0 26px;
    font-size: 0.78rem;
    color: var(--text-dim);
    font-family: 'JetBrains Mono', 'JetBrains Mono Fallback', 'IBM Plex Sans Arabic', monospace;
  }
  .level { color: var(--accent); font-weight: 700; }
  .level[data-level='advanced'] { color: var(--paid); }

  .takeaways {
    background: color-mix(in srgb, var(--accent) 7%, var(--surface));
    border: 1px solid color-mix(in srgb, var(--accent) 28%, transparent);
    border-radius: 14px;
    padding: 18px 22px;
  }
  .takeaways h2 { margin: 0 0 12px; font-size: 1rem; }
  .takeaways ul { margin: 0; padding-inline-start: 20px; display: grid; gap: 8px; }
  .takeaways li { font-size: 0.92rem; line-height: 1.75; }

  .prereq {
    margin-top: 14px;
    border: 1px dashed var(--line);
    border-radius: 14px;
    padding: 16px 22px;
    background: var(--surface-2);
  }
  .prereq h2 { margin: 0 0 10px; font-size: 0.95rem; }
  .prereq ul { margin: 0; padding-inline-start: 20px; display: grid; gap: 6px; }
  .prereq li { font-size: 0.87rem; color: var(--text-dim); line-height: 1.7; }

  .jump { display: flex; flex-wrap: wrap; gap: 8px; margin: 22px 0 4px; }
  .jump a {
    font-size: 0.78rem;
    color: var(--text-dim);
    text-decoration: none;
    border: 1px solid var(--line);
    border-radius: 100px;
    padding: 5px 12px;
    transition: color 0.18s, border-color 0.18s;
  }
  .jump a:hover { color: var(--accent); border-color: var(--accent); }

  /* ---------- shared block rhythm ---------- */
  .block { margin-top: 52px; scroll-margin-top: 90px; }
  .block > h2 { font-size: 1.35rem; margin: 0 0 18px; }
  .block h3 { font-size: 1rem; }

  .content { margin-top: 40px; scroll-margin-top: 90px; }
  .content :global(h2) { margin-top: 40px; font-size: 1.35rem; }
  .content :global(h3) { margin-top: 28px; font-size: 1.05rem; }
  .content :global(p) { line-height: 1.9; }
  .content :global(ul),
  .content :global(ol) { line-height: 1.9; padding-inline-start: 22px; }
  .content :global(li) { margin-bottom: 6px; }
  .content :global(a) { color: var(--accent); }
  .content :global(blockquote) {
    margin: 24px 0;
    padding: 14px 20px;
    border-inline-start: 3px solid var(--accent);
    background: var(--surface-2);
    border-radius: 0 10px 10px 0;
    color: var(--text-dim);
  }
  .content :global(code) {
    font-family: 'JetBrains Mono', 'JetBrains Mono Fallback', monospace;
    font-size: 0.86em;
    background: var(--surface-2);
    padding: 2px 6px;
    border-radius: 5px;
  }
  .content :global(pre) {
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 16px 18px;
    overflow-x: auto;
    direction: ltr;
    text-align: start;
  }
  .content :global(pre code) { background: none; padding: 0; }

  /* ---------- steps ---------- */
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 16px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 18px 20px;
    scroll-margin-top: 90px;
  }
  .step-num {
    width: 30px;
    height: 30px;
    border-radius: 9px;
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    color: var(--accent);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 0.9rem;
    font-family: 'JetBrains Mono', 'JetBrains Mono Fallback', monospace;
    flex-shrink: 0;
  }
  .step-body { min-width: 0; }
  .step-body h3 { margin: 4px 0 8px; font-size: 1.02rem; }
  .step-body p { margin: 0; font-size: 0.92rem; line-height: 1.85; color: var(--text-dim); }
  .tip {
    margin-top: 10px !important;
    padding: 10px 14px;
    border-radius: 9px;
    background: var(--surface-2);
    font-size: 0.86rem !important;
  }
  .tip strong { color: var(--accent); }

  /* ---------- common mistakes ---------- */
  .mistakes { display: grid; gap: 12px; }
  .mistake {
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
    background: var(--surface);
  }
  .mistake p { margin: 0; padding: 14px 18px; font-size: 0.9rem; line-height: 1.8; }
  .mistake .wrong { border-bottom: 1px solid var(--line); color: var(--text-dim); }
  .tag {
    display: inline-block;
    font-size: 0.68rem;
    font-family: 'JetBrains Mono', 'JetBrains Mono Fallback', 'IBM Plex Sans Arabic', monospace;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-radius: 100px;
    padding: 3px 9px;
    margin-inline-end: 9px;
    vertical-align: middle;
  }
  .wrong .tag { background: color-mix(in srgb, var(--paid) 16%, transparent); color: var(--paid); }
  .right .tag { background: color-mix(in srgb, var(--free) 16%, transparent); color: var(--free); }

  /* ---------- FAQ ---------- */
  details {
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
    margin-bottom: 10px;
    overflow: hidden;
  }
  summary {
    cursor: pointer;
    padding: 15px 18px;
    font-weight: 600;
    font-size: 0.95rem;
    list-style: none;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after {
    content: '+';
    float: inline-end;
    color: var(--accent);
    font-weight: 700;
  }
  details[open] summary::after { content: '−'; }
  details p {
    margin: 0;
    padding: 0 18px 16px;
    color: var(--text-dim);
    font-size: 0.9rem;
    line-height: 1.85;
  }

  /* ---------- related ---------- */
  .rel-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 16px;
  }
  .related h3 {
    margin: 22px 0 10px;
    font-size: 0.85rem;
    color: var(--text-dim);
    font-weight: 600;
  }
  .pills { display: flex; flex-wrap: wrap; gap: 9px; }
  .pills a {
    font-size: 0.83rem;
    color: var(--text);
    text-decoration: none;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 100px;
    padding: 8px 15px;
    transition: border-color 0.18s, color 0.18s;
  }
  .pills a:hover { border-color: var(--accent); color: var(--accent); }
  .pills a.all { color: var(--accent); font-weight: 600; }

  @media (max-width: 820px) {
    h1 { font-size: 1.55rem; }
    .subtitle { font-size: 0.95rem; }
    .block { margin-top: 40px; }
    .block > h2 { font-size: 1.15rem; }
    .step { padding: 16px; gap: 12px; }
  }
</style>
