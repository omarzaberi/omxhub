---
/**
 * `/tutorials` landing page, shared by both locales.
 *
 * Layout order: hero → search + filters → featured → latest → categories →
 * all tutorials → CTA.
 *
 * Same two decisions as the comparisons landing page, for the same reasons:
 *
 * 1. Search and filtering run entirely over markup that is already in the HTML —
 *    no fetch, no index file, no framework. Every tutorial is a real crawlable
 *    link on first paint, and filtering costs one attribute toggle.
 * 2. There are no `/tutorials/category/<x>` or `/tutorials/level/<x>` routes.
 *    With this few tutorials those pages would be thin content, which SEO.md
 *    forbids. The pills filter in place, and get promoted to real routes once a
 *    facet has enough entries to justify one.
 */
import Layout from '../layouts/Layout.astro';
import TutorialCard from './TutorialCard.astro';
import { categories, type CategoryKey } from '../data/categories';
import { useTranslations, localizedPath } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { getCollection } from 'astro:content';
import { breadcrumbs, collectionPage, graph, HOME_LABEL } from '../lib/schema';
import {
  byNewest,
  byPopularity,
  fill,
  inLang,
  tutorialPath,
  type Level,
  type Tutorial,
} from '../lib/tutorials';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const arrow = lang === 'ar' ? '←' : '→';

const all = inLang(await getCollection('tutorials'), lang);

const latest = [...all].sort(byNewest);
const popular = [...all].sort(byPopularity);
const featured = popular.filter((entry) => entry.data.featured);

// Only render facets that actually have tutorials — an empty filter is a dead
// control, and a zero-result category card is worse than no card at all.
const usedCategories = (Object.keys(categories) as CategoryKey[])
  .map((key) => ({ key, count: all.filter((e) => e.data.category === key).length }))
  .filter((c) => c.count > 0);

const LEVELS: Level[] = ['beginner', 'intermediate', 'advanced'];
const usedLevels = LEVELS.map((key) => ({
  key,
  count: all.filter((e) => e.data.level === key).length,
})).filter((l) => l.count > 0);

/** Lowercased haystack the client-side filter matches against. */
function haystack(entry: Tutorial): string {
  return [
    entry.data.title,
    entry.data.subtitle,
    entry.data.metaDescription,
    ...entry.data.takeaways,
    categories[entry.data.category][lang],
    t(`tut.level.${entry.data.level}` as 'tut.level.beginner'),
  ]
    .join(' ')
    .toLowerCase();
}

/** Props for a card, so every rail stays in sync without repeating itself. */
function cardProps(entry: Tutorial) {
  return {
    href: localizedPath(lang, tutorialPath(entry)),
    title: entry.data.title,
    subtitle: entry.data.subtitle,
    category: entry.data.category,
    level: entry.data.level,
    readingTime: entry.data.readingTime,
    search: haystack(entry),
    lang,
  };
}

const schema = graph(
  breadcrumbs(lang, [
    { name: HOME_LABEL[lang], path: '/' },
    { name: t('tut.breadcrumb') },
  ]),
  collectionPage({
    lang,
    name: t('tut.index.title'),
    description: t('tut.index.metaDescription'),
    path: '/tutorials',
    items: latest.map((entry) => ({
      name: entry.data.title,
      path: tutorialPath(entry),
    })),
  })
);
---
<Layout
  title={t('tut.index.metaTitle')}
  description={t('tut.index.metaDescription')}
  schema={schema}
>
  <div class="tut-index" data-tutorials-index>
    <!-- ===================== HERO + SEARCH ===================== -->
    <section class="wrap hero">
      <nav class="breadcrumb" aria-label="breadcrumb">
        <a href={localizedPath(lang, '/')}>{HOME_LABEL[lang]}</a>
        <span aria-hidden="true">/</span>
        <span class="current">{t('tut.breadcrumb')}</span>
      </nav>

      <p class="eyebrow">{fill(t('tut.index.eyebrow'), { count: all.length })}</p>
      <h1>
        <span class="h1a">{t('tut.index.h1a')}</span>{' '}
        <span class="h1b">{t('tut.index.h1b')}</span>
      </h1>
      <p class="lede">{t('tut.index.lede')}</p>

      <form class="tut-search" role="search" autocomplete="off" data-search-form>
        <label class="sr-only" for="tut-q">{t('tut.index.searchPlaceholder')}</label>
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
        <input
          id="tut-q"
          type="search"
          name="q"
          placeholder={t('tut.index.searchPlaceholder')}
          data-search-input
        />
      </form>

      <div class="filter-groups">
        <div class="filters" role="group" aria-label={t('tut.index.levels')}>
          <button type="button" class="filter is-active" data-level-filter="all">
            {t('tut.index.all')}
          </button>
          {usedLevels.map((l) => (
            <button type="button" class="filter" data-level-filter={l.key}>
              {t(`tut.level.${l.key}` as 'tut.level.beginner')} ({l.count})
            </button>
          ))}
        </div>

        <div class="filters" role="group" aria-label={t('tut.index.categories')}>
          <button type="button" class="filter is-active" data-cat-filter="all">
            {t('tut.index.all')}
          </button>
          {usedCategories.map((c) => (
            <button type="button" class="filter" data-cat-filter={c.key}>
              {categories[c.key].icon} {categories[c.key][lang]} ({c.count})
            </button>
          ))}
        </div>
      </div>
    </section>

    <!-- ===================== FILTERED RESULTS ===================== -->
    <!-- Hidden until the reader searches or picks a facet. The cards below are
         the same DOM nodes the rails render, so nothing is duplicated. -->
    <section class="wrap results" data-results hidden aria-live="polite">
      <div class="grid" data-results-grid></div>
      <p class="no-results" data-no-results hidden>{t('tut.index.empty')}</p>
    </section>

    <div data-rails>
      {featured.length > 0 && (
        <section class="wrap band">
          <p class="label">{t('tut.index.featuredLabel')}</p>
          <h2 class="section-title">{t('tut.index.featured')}</h2>
          <div class="grid">
            {featured.map((entry) => <TutorialCard {...cardProps(entry)} />)}
          </div>
        </section>
      )}

      <section class="wrap band">
        <p class="label">{t('tut.index.latestLabel')}</p>
        <h2 class="section-title">{t('tut.index.latest')}</h2>
        <div class="grid">
          {latest.map((entry) => <TutorialCard {...cardProps(entry)} />)}
        </div>
      </section>

      {usedCategories.length > 1 && (
        <section class="wrap band">
          <p class="label">{t('tut.index.categoriesLabel')}</p>
          <h2 class="section-title">{t('tut.index.categories')}</h2>
          <div class="cat-cards">
            {usedCategories.map((c) => (
              <button type="button" class="cat-card" data-cat-jump={c.key}>
                <span class="cat-icon" aria-hidden="true">{categories[c.key].icon}</span>
                <span class="cat-name">{categories[c.key][lang]}</span>
                <span class="cat-count">{fill(t('tut.index.count'), { count: c.count })}</span>
              </button>
            ))}
          </div>
        </section>
      )}

      <section class="wrap band">
        <div class="cta">
          <h2>{t('tut.index.ctaTitle')}</h2>
          <p>{t('tut.index.ctaBody')}</p>
          <div class="cta-actions">
            <a class="btn-primary" href={localizedPath(lang, '/ai-tools')}>
              {t('tut.index.ctaBtn')} {arrow}
            </a>
            <a class="btn-ghost" href={localizedPath(lang, '/contact')}>
              {t('tut.index.ctaBtn2')}
            </a>
          </div>
        </div>
      </section>
    </div>
  </div>
</Layout>

<script>
  /**
   * Filters the pre-rendered tutorial cards.
   *
   * The results grid is populated by *moving* the existing card nodes into it
   * rather than cloning them, so a card never exists twice in the document and
   * the DOM stays exactly as large as the server rendered it. When filtering
   * clears, every card goes back to the rail it came from, in its original slot.
   */
  class TutorialFilter {
    root: HTMLElement;
    input: HTMLInputElement;
    results: HTMLElement;
    grid: HTMLElement;
    rails: HTMLElement;
    empty: HTMLElement;
    cards: HTMLElement[];
    /** Where each card lives when no filter is active. */
    home = new Map<HTMLElement, { parent: HTMLElement; next: Node | null }>();
    level = 'all';
    category = 'all';

    constructor(root: HTMLElement) {
      this.root = root;
      this.input = root.querySelector('[data-search-input]')!;
      this.results = root.querySelector('[data-results]')!;
      this.grid = root.querySelector('[data-results-grid]')!;
      this.rails = root.querySelector('[data-rails]')!;
      this.empty = root.querySelector('[data-no-results]')!;
      this.cards = Array.from(root.querySelectorAll<HTMLElement>('[data-tutorial]'));

      for (const card of this.cards) {
        this.home.set(card, {
          parent: card.parentElement as HTMLElement,
          next: card.nextSibling,
        });
      }

      root
        .querySelector('[data-search-form]')
        ?.addEventListener('submit', (e) => e.preventDefault());
      this.input.addEventListener('input', () => this.apply());

      this.bindGroup('[data-level-filter]', 'levelFilter', (v) => (this.level = v));
      this.bindGroup('[data-cat-filter]', 'catFilter', (v) => (this.category = v));

      // The category cards lower down reuse the same filter rather than
      // navigating to a thin category page.
      root.querySelectorAll<HTMLElement>('[data-cat-jump]').forEach((card) => {
        card.addEventListener('click', () => {
          const key = card.dataset.catJump!;
          this.root
            .querySelector<HTMLButtonElement>(`[data-cat-filter="${key}"]`)
            ?.click();
          this.results.scrollIntoView({
            behavior: matchMedia('(prefers-reduced-motion: reduce)').matches
              ? 'auto'
              : 'smooth',
            block: 'start',
          });
        });
      });
    }

    private bindGroup(selector: string, key: string, set: (value: string) => void) {
      const buttons = Array.from(
        this.root.querySelectorAll<HTMLButtonElement>(selector)
      );
      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          set(btn.dataset[key]!);
          buttons.forEach((b) => b.classList.toggle('is-active', b === btn));
          this.apply();
        });
      });
    }

    apply() {
      const query = this.input.value.trim().toLowerCase();
      const filtering =
        query.length > 0 || this.level !== 'all' || this.category !== 'all';

      this.results.hidden = !filtering;
      this.rails.hidden = filtering;

      if (!filtering) {
        // Put every card back exactly where it was rendered.
        for (const card of this.cards) {
          const slot = this.home.get(card)!;
          slot.parent.insertBefore(card, slot.next);
          card.hidden = false;
        }
        return;
      }

      let visible = 0;
      for (const card of this.cards) {
        const matches =
          (!query || card.dataset.search!.includes(query)) &&
          (this.level === 'all' || card.dataset.level === this.level) &&
          (this.category === 'all' || card.dataset.category === this.category);

        if (matches) {
          this.grid.appendChild(card);
          card.hidden = false;
          visible++;
        } else {
          card.hidden = true;
        }
      }
      this.empty.hidden = visible > 0;
    }
  }

  document
    .querySelectorAll<HTMLElement>('[data-tutorials-index]')
    .forEach((el) => new TutorialFilter(el));
</script>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* ---------- hero ---------- */
  .hero { padding: 28px 0 8px; }
  .breadcrumb {
    display: flex;
    gap: 8px;
    align-items: center;
    font-size: 0.85rem;
    color: var(--text-dim);
    margin-bottom: 24px;
  }
  .breadcrumb a { color: var(--text-dim); text-decoration: none; }
  .breadcrumb a:hover { color: var(--accent); }
  .breadcrumb .current { color: var(--text); }

  .eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-family: 'JetBrains Mono', 'JetBrains Mono Fallback', 'IBM Plex Sans Arabic', monospace;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 26%, transparent);
    border-radius: 100px;
    padding: 5px 13px;
    margin: 0 0 16px;
  }
  h1 { margin: 0 0 14px; font-size: 2.4rem; line-height: 1.25; max-width: 20ch; }
  .h1b { color: var(--accent); }
  .lede {
    max-width: 62ch;
    color: var(--text-dim);
    line-height: 1.9;
    margin: 0 0 26px;
  }

  .tut-search {
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: 100px;
    padding-inline-start: 18px;
    max-width: 520px;
    color: var(--text-dim);
  }
  .tut-search input {
    flex: 1;
    border: none;
    background: transparent;
    color: var(--text);
    padding: 14px 18px 14px 4px;
    font-family: inherit;
    font-size: 0.92rem;
  }
  .tut-search input:focus { outline: none; }
  .tut-search:focus-within { border-color: var(--accent); }

  .filter-groups { display: flex; flex-direction: column; gap: 10px; margin-top: 18px; }
  .filters { display: flex; flex-wrap: wrap; gap: 9px; }
  .filter {
    background: var(--surface);
    border: 1px solid var(--line);
    color: var(--text-dim);
    border-radius: 100px;
    padding: 7px 14px;
    font-family: inherit;
    font-size: 0.82rem;
    cursor: pointer;
    transition: color 0.18s, border-color 0.18s;
  }
  .filter:hover { color: var(--text); border-color: var(--accent); }
  .filter.is-active {
    color: var(--accent-ink);
    background: var(--accent);
    border-color: var(--accent);
    font-weight: 700;
  }

  /* ---------- shared band rhythm ---------- */
  .band { padding: 44px 0 0; }
  .results { padding: 34px 0 0; }
  .label {
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-2);
    font-family: 'JetBrains Mono', 'JetBrains Mono Fallback', 'IBM Plex Sans Arabic', monospace;
    margin: 0 0 6px;
  }
  .section-title { font-size: 1.35rem; margin: 0 0 20px; }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 18px;
  }
  .no-results {
    text-align: center;
    color: var(--text-dim);
    padding: 40px 0;
    font-size: 0.9rem;
  }

  /* ---------- category cards ---------- */
  .cat-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
    gap: 12px;
  }
  .cat-card {
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-align: start;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 16px 18px;
    color: var(--text);
    font-family: inherit;
    cursor: pointer;
    transition: border-color 0.18s, transform 0.15s;
  }
  .cat-card:hover { border-color: var(--accent); transform: translateY(-2px); }
  .cat-icon { font-size: 1.3rem; }
  .cat-name { font-weight: 700; font-size: 0.95rem; }
  .cat-count { font-size: 0.75rem; color: var(--text-dim); }

  /* ---------- CTA ---------- */
  .cta {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 34px;
    text-align: center;
  }
  .cta h2 { margin: 0 0 10px; font-size: 1.4rem; }
  .cta p {
    margin: 0 auto 22px;
    max-width: 58ch;
    color: var(--text-dim);
    line-height: 1.85;
  }
  .cta-actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .btn-primary {
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 700;
    padding: 13px 26px;
    border-radius: 10px;
    text-decoration: none;
  }
  .btn-ghost {
    border: 1px solid var(--line);
    color: var(--text);
    font-weight: 600;
    padding: 13px 26px;
    border-radius: 10px;
    text-decoration: none;
  }
  .btn-ghost:hover { border-color: var(--accent); color: var(--accent); }

  @media (max-width: 820px) {
    h1 { font-size: 1.8rem; max-width: none; }
    .lede { font-size: 0.95rem; }
    .band { padding: 36px 0 0; }
    .section-title { font-size: 1.2rem; }
    .cta { padding: 26px 20px; }
    .cta h2 { font-size: 1.2rem; }
  }
</style>
