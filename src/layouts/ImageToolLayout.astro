---
/**
 * Image-tool chrome: `ToolLayout` with the image section's labels and hub, plus
 * the preview, crop-stage and result CSS the image tools share.
 *
 * The link across to the PDF hub started as scaffolding: with one tool live,
 * `relatedImageTools` returned nothing and a page with no outbound link is a
 * dead end for a reader and a leaf for a crawler. With four tools the chain
 * closes on itself and the link is no longer load-bearing — it stays because
 * the two sections serve the same person for the same reason (everything runs
 * in the browser, nothing is uploaded), and because it is the only path between
 * them that does not go via the homepage.
 */
import ToolLayout from './ToolLayout.astro';
import { useTranslations, localizedPath } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface FaqItem { q: string; a: string; }
interface RelatedTool { label: string; href: string; }
interface Step { name: string; text: string; }

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Usage steps. Rendered visibly on the page and mirrored as HowTo JSON-LD. */
  steps?: Step[];
  faq?: FaqItem[];
  related?: RelatedTool[];
}
const { lang, title, description, steps = [], faq = [], related = [] } = Astro.props;
const t = useTranslations(lang);
---
<ToolLayout
  lang={lang}
  title={title}
  description={description}
  hub={{ label: t('nav.image'), path: '/image-tools' }}
  labels={{
    privacyNote: t('image.privacyNote'),
    relatedTools: t('image.relatedTools'),
    allTools: t('image.allTools'),
  }}
  steps={steps}
  faq={faq}
  related={related}
>
  <slot />

  <Fragment slot="related-extra">
    <a href={localizedPath(lang, '/pdf-tools')}>{t('nav.pdf')}</a>
  </Fragment>
</ToolLayout>

<style is:global>
  /* ---------- IMAGE PREVIEW ---------- */
  /* A single decoded image shown before and after processing. The box is sized
     by aspect-ratio rather than by the image, so choosing a file does not shift
     the button underneath it downward while the bitmap decodes. */
  .image-preview {
    margin-top: 18px;
    display: grid;
    place-items: center;
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 12px;
    min-height: 160px;
  }
  .image-preview img {
    max-width: 100%;
    max-height: 280px;
    display: block;
    border-radius: 6px;
    /* A transparent PNG on a flat panel is unreadable; the chequerboard makes
       alpha visible, which matters because transparency changes what formats
       this tool is allowed to offer. */
    background-image:
      linear-gradient(45deg, var(--line) 25%, transparent 25%),
      linear-gradient(-45deg, var(--line) 25%, transparent 25%),
      linear-gradient(45deg, transparent 75%, var(--line) 75%),
      linear-gradient(-45deg, transparent 75%, var(--line) 75%);
    background-size: 16px 16px;
    background-position: 0 0, 0 8px, 8px -8px, -8px 0;
  }

  /* Before / after figures for a size comparison. */
  .size-compare {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 12px;
    margin-top: 16px;
    text-align: center;
  }
  .size-compare .size-cell {
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 12px 10px;
  }
  .size-compare .size-label {
    display: block;
    font-size: 0.75rem;
    color: var(--text-dim);
    margin-bottom: 4px;
  }
  .size-compare .size-value {
    font-family: 'JetBrains Mono', 'JetBrains Mono Fallback', monospace;
    font-size: 1rem;
    color: var(--text);
    direction: ltr;
    display: block;
  }
  .size-compare .size-cell.after .size-value { color: var(--free); }
  /* Growth is shown at the same prominence a saving would have been. Convert,
     Resize and Crop can all legitimately produce a larger file, and the rule
     they inherit from Compress is that the direction is never hidden — so this
     is a visible colour, not a muted one. */
  .size-compare .size-cell.worse .size-value { color: var(--paid); }
  /* The glyph points from the original to the result, so it must follow the
     reading direction rather than stay pinned to one side. */
  .size-compare .size-arrow { color: var(--text-dim); font-size: 1.1rem; }
  [dir='rtl'] .size-compare .size-arrow { transform: scaleX(-1); }

  .saving-badge {
    display: inline-block;
    margin-top: 14px;
    background: color-mix(in srgb, var(--free) 16%, transparent);
    color: var(--free);
    border-radius: 100px;
    padding: 6px 16px;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .saving-badge.grew {
    background: color-mix(in srgb, var(--paid) 16%, transparent);
    color: var(--paid);
  }

  /* ---------- LIVE OUTCOME ---------- */
  /* Resize and Crop both answer "what will I get?" before the button is pressed.
     The arithmetic is pure and runs on numbers rather than pixels, so there is
     no reason to make someone press a button to find out whether they asked the
     right question. */
  .outcome {
    margin-top: 16px;
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-inline-start: 3px solid var(--accent);
    border-radius: 8px;
    padding: 12px 16px;
    font-size: 0.88rem;
    color: var(--text);
  }

  /* ---------- CROP STAGE ---------- */
  /* The image and the rectangle share one positioned box, sized from the
     image's own aspect ratio so the rectangle never has to be repositioned
     once the bitmap lands — the same reason the PDF crop tool sets
     `aspect-ratio` on its canvas holder. */
  .crop-stage {
    margin-top: 18px;
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 12px;
  }
  .crop-stage .stage {
    position: relative;
    width: 100%;
    aspect-ratio: var(--crop-ratio, 4 / 3);
    max-height: 420px;
    margin-inline: auto;
    /* The chequerboard makes alpha visible, which matters because a crop on a
       transparent logo has to show what is being kept. */
    background-image:
      linear-gradient(45deg, var(--line) 25%, transparent 25%),
      linear-gradient(-45deg, var(--line) 25%, transparent 25%),
      linear-gradient(45deg, transparent 75%, var(--line) 75%),
      linear-gradient(-45deg, transparent 75%, var(--line) 75%);
    background-size: 16px 16px;
    background-position: 0 0, 0 8px, 8px -8px, -8px 0;
    /* The rectangle is positioned in percentages of this box, so it must not be
       able to escape it. */
    overflow: hidden;
    touch-action: none;
  }
  .crop-stage .stage img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    user-select: none;
    -webkit-user-drag: none;
  }
  .crop-rect {
    position: absolute;
    border: 2px solid var(--accent);
    /* A dimmed surround rather than a dimmed selection: the shadow darkens
       everything outside the rectangle, so the kept area is the bright one. */
    box-shadow: 0 0 0 9999px color-mix(in srgb, #000 55%, transparent);
    cursor: move;
    touch-action: none;
  }
  .crop-rect span[data-handle] {
    position: absolute;
    width: 18px;
    height: 18px;
    background: var(--accent);
    border-radius: 3px;
  }
  .crop-rect span[data-handle='nw'] { inset-block-start: -9px; inset-inline-start: -9px; cursor: nwse-resize; }
  .crop-rect span[data-handle='ne'] { inset-block-start: -9px; inset-inline-end: -9px; cursor: nesw-resize; }
  .crop-rect span[data-handle='sw'] { inset-block-end: -9px; inset-inline-start: -9px; cursor: nesw-resize; }
  .crop-rect span[data-handle='se'] { inset-block-end: -9px; inset-inline-end: -9px; cursor: nwse-resize; }

  /* The four number fields: the keyboard-accessible way to set a crop, and the
     only one assistive technology can actually perform. */
  .crop-fields {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin-top: 14px;
  }
  .crop-fields label { font-size: 0.8rem; }
  .crop-fields input { text-align: center; direction: ltr; }

  /* Two controls side by side — a select and a button — without either
     stretching to the full width of the panel. */
  .inline-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 10px;
  }
  .inline-row > div { flex: 1 1 200px; }
  .inline-row .action-btn { margin-top: 0; width: auto; flex: 0 0 auto; }

  /* A pair of number fields that belong together, e.g. an exact width×height. */
  .field-pair { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }

  @media (max-width: 560px) {
    .size-compare { grid-template-columns: 1fr; gap: 8px; }
    .size-compare .size-arrow { transform: rotate(90deg); }
    [dir='rtl'] .size-compare .size-arrow { transform: rotate(90deg); }
    .crop-fields { grid-template-columns: repeat(2, 1fr); }
  }
</style>
