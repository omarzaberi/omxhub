---
import { getLangFromUrl, useTranslations, localizedPath } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const dir = lang === 'ar' ? 'rtl' : 'ltr';
const otherLang = lang === 'ar' ? 'en' : 'ar';

// build the equivalent path in the other language for the switcher
const currentPath = Astro.url.pathname.replace(/^\/en/, '') || '/';
const switchHref = localizedPath(otherLang, currentPath);
---
<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | OMXHub</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1192147959258733"
     crossorigin="anonymous"></script>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-W8MG2DBF3F"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-W8MG2DBF3F');
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;900&family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&family=Space+Grotesk:wght@500;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Set theme before paint to avoid flash. Default: dark.
      (function () {
        const stored = localStorage.getItem('omxhub-theme');
        const theme = stored || 'dark';
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a href={localizedPath(lang, '/')} class="logo" dir="ltr">
          <span class="caret">&gt;</span><span class="omx">OMX</span><span class="hub">Hub</span><span class="cursor">_</span>
        </a>
        <nav>
          <a href={localizedPath(lang, '/ai-tools')}>{t('nav.tools')}</a>
          <a href={localizedPath(lang, '/prompts')}>{t('nav.prompts')}</a>
          <a href={localizedPath(lang, '/pdf-tools')}>{t('nav.pdf')}</a>
        </nav>
        <div class="controls">
          <button id="theme-toggle" class="icon-btn" aria-label={t('theme.toggle')} type="button">
            <svg class="icon-sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            <svg class="icon-moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z"/></svg>
          </button>
          <a href={switchHref} class="icon-btn lang-switch">{t('lang.switch')}</a>
          <a href={localizedPath(lang, '/support')} class="btn-support" aria-label={t('footer.support')}>
            <span aria-hidden="true">❤️</span><span class="support-label">{t('footer.support')}</span>
          </a>
        </div>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>© 2026 OMXHub — {t('footer.tagline')}</p>
        <div class="footer-links">
          <a href={localizedPath(lang, '/about')}>{t('footer.about')}</a>
          <a href={localizedPath(lang, '/contact')}>{t('footer.contact')}</a>
          <a href={localizedPath(lang, '/support')} class="support-link">❤️ {t('footer.support')}</a>
          <a href={localizedPath(lang, '/privacy-policy')}>{t('footer.privacy')}</a>
        </div>
      </div>
    </footer>

    <script is:inline>
      const btn = document.getElementById('theme-toggle');
      btn?.addEventListener('click', () => {
        const current = document.documentElement.getAttribute('data-theme');
        const next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('omxhub-theme', next);
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    /* Dark theme (default) — modern tech palette */
    --bg: #0a0d12;
    --surface: #12161f;
    --surface-2: #1a212c;
    --text: #e7eaf0;
    --text-dim: #8b93a7;
    --line: rgba(255, 255, 255, 0.09);
    --accent: #4fd1c5;
    --accent-ink: #06231f;
    --accent-2: #9b8cfb;
    --free: #34d399;
    --paid: #f5a623;
  }

  html[data-theme='light'] {
    --bg: #f4f5f7;
    --surface: #ffffff;
    --surface-2: #eceff2;
    --text: #12161f;
    --text-dim: #5b6470;
    --line: rgba(10, 13, 18, 0.1);
    --accent: #0f9e92;
    --accent-ink: #ffffff;
    --accent-2: #6e5beb;
    --free: #1f9d6e;
    --paid: #b4720f;
  }

  * { box-sizing: border-box; }

  html[dir='rtl'] body { font-family: 'IBM Plex Sans Arabic', 'Tajawal', sans-serif; }
  html[dir='ltr'] body { font-family: 'Inter', sans-serif; }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    line-height: 1.75;
    transition: background 0.2s, color 0.2s;
  }

  html[dir='rtl'] h1, html[dir='rtl'] h2, html[dir='rtl'] h3, html[dir='rtl'] .logo {
    font-family: 'Tajawal', sans-serif;
  }
  html[dir='ltr'] h1, html[dir='ltr'] h2, html[dir='ltr'] h3, html[dir='ltr'] .logo {
    font-family: 'Space Grotesk', sans-serif;
  }
  /* Latin glyphs use JetBrains Mono; Arabic falls back to the Arabic UI face
     so mixed-language badges never render with broken letterforms. */
  .mono, code, .price-badge, .cat-badge, table {
    font-family: 'JetBrains Mono', 'IBM Plex Sans Arabic', monospace;
  }

  .wrap {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .site-header {
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    border-bottom: 1px solid var(--line);
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .site-header .wrap {
    display: flex;
    align-items: center;
    gap: 28px;
    padding-block: 16px;
    flex-wrap: wrap;
  }

  .logo {
    font-weight: 900;
    font-size: 1.22rem;
    letter-spacing: -0.02em;
    color: var(--text);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 2px;
  }
  .logo .caret { color: var(--accent-2); }
  .logo .omx { color: var(--accent); }
  .logo .hub { color: var(--text); }
  .cursor {
    color: var(--accent);
    animation: blink 1.1s step-end infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }

  nav {
    display: flex;
    gap: 22px;
    flex-wrap: wrap;
    margin-inline-start: 8px;
  }
  nav a {
    position: relative;
    color: var(--text-dim);
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 500;
    padding-block: 4px;
    transition: color 0.2s;
  }
  nav a::after {
    content: '';
    position: absolute;
    bottom: -2px;
    inset-inline-start: 0;
    width: 0;
    height: 2px;
    border-radius: 2px;
    background: var(--accent);
    transition: width 0.25s ease;
  }
  nav a:hover { color: var(--text); }
  nav a:hover::after { width: 100%; }

  .controls { display: flex; align-items: center; gap: 10px; margin-inline-start: auto; }

  .icon-btn {
    width: 38px;
    height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
    color: var(--text-dim);
    cursor: pointer;
    text-decoration: none;
    font-size: 0.78rem;
    font-weight: 700;
    transition: color 0.2s, border-color 0.2s;
    padding: 0;
  }
  .icon-btn:hover { color: var(--text); border-color: var(--line); }
  .lang-switch { width: auto; padding: 0 12px; font-family: 'JetBrains Mono', 'IBM Plex Sans Arabic', monospace; }

  .icon-sun, .icon-moon { display: none; }
  html[data-theme='dark'] .icon-sun { display: block; }
  html[data-theme='light'] .icon-moon { display: block; }

  .btn-support {
    padding: 9px 16px;
    border-radius: 10px;
    font-weight: 700;
    font-size: 0.86rem;
    text-decoration: none;
    color: var(--accent-2);
    border: 1px solid color-mix(in srgb, var(--accent-2) 35%, transparent);
    background: color-mix(in srgb, var(--accent-2) 8%, transparent);
    transition: background 0.2s;
    white-space: nowrap;
  }
  .btn-support:hover { background: color-mix(in srgb, var(--accent-2) 16%, transparent); }

  main { min-height: 60vh; }

  .site-footer {
    background: var(--surface);
    border-top: 1px solid var(--line);
    color: var(--text-dim);
    margin-top: 60px;
  }
  .site-footer .wrap {
    display: flex;
    justify-content: space-between;
    padding-block: 24px;
    flex-wrap: wrap;
    gap: 10px;
    font-size: 0.9rem;
  }
  .site-footer a { color: var(--accent); text-decoration: none; }
  .footer-links { display: flex; gap: 18px; flex-wrap: wrap; }
  .support-link { color: var(--accent-2) !important; }

  a { color: var(--accent); }

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .btn-support {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  /* Any wide table (e.g. pricing plans) scrolls sideways instead of
     squeezing its columns unreadably on narrow screens. */
  .table-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin: 16px 0 34px;
  }
  .table-scroll table { margin: 0; min-width: 460px; }

  /* ---------- MOBILE ---------- */
  @media (max-width: 820px) {
    .wrap { padding: 0 18px; }

    .site-header .wrap {
      padding-block: 12px;
      gap: 10px;
      row-gap: 12px;
    }
    .logo { font-size: 1.12rem; }

    /* Nav drops to its own full-width row and scrolls sideways
       rather than wrapping into a tall stack. */
    nav {
      order: 3;
      width: 100%;
      margin-inline-start: 0;
      gap: 18px;
      overflow-x: auto;
      flex-wrap: nowrap;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    nav::-webkit-scrollbar { display: none; }
    nav a { white-space: nowrap; }

    .controls { gap: 8px; }
    .icon-btn { width: 34px; height: 34px; }
    .btn-support { padding: 8px 12px; font-size: 0.8rem; }

    .site-footer .wrap { flex-direction: column; align-items: flex-start; }
    .footer-links { gap: 14px; }
  }

  @media (max-width: 430px) {
    .wrap { padding: 0 14px; }
    /* Collapse the support button to just the heart to protect the top row. */
    .support-label { display: none; }
    .btn-support { padding: 8px 10px; }
    .lang-switch { padding: 0 10px; }
  }

  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; animation: none !important; }
  }
</style>
