---
import Layout from '../layouts/Layout.astro';
import { useTranslations, localizedPath } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { breadcrumbs, faqPage, graph, howTo } from '../lib/schema';

interface FaqItem { q: string; a: string; }
interface RelatedTool { label: string; href: string; }
interface Step { name: string; text: string; }

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Usage steps. Rendered visibly on the page and mirrored as HowTo JSON-LD. */
  steps?: Step[];
  faq?: FaqItem[];
  related?: RelatedTool[];
}
const { lang, title, description, steps = [], faq = [], related = [] } = Astro.props;
const t = useTranslations(lang);

// Language-neutral path (`/pdf-tools/merge-pdf`) for building canonical schema URLs.
const path = Astro.url.pathname.replace(/^\/en/, '').replace(/\/+$/, '') || '/';

const homeLabel = lang === 'ar' ? 'الرئيسية' : 'Home';
const stepsHeading = lang === 'ar' ? 'طريقة الاستخدام' : 'How to use it';
const faqHeading = lang === 'ar' ? 'أسئلة شائعة' : 'Frequently Asked Questions';

const schema = graph(
  breadcrumbs(lang, [
    { name: homeLabel, path: '/' },
    { name: t('nav.pdf'), path: '/pdf-tools' },
    { name: title },
  ]),
  // Only claim HowTo when the steps are actually rendered below.
  steps.length ? howTo({ lang, name: title, description, path, steps }) : null,
  faqPage(faq)
);
---
<Layout title={title} description={description} schema={schema}>
  <div class="wrap pdf-tool-page">
    <nav class="breadcrumb" aria-label="breadcrumb">
      <a href={localizedPath(lang, '/')}>{lang === 'ar' ? 'الرئيسية' : 'Home'}</a>
      <span>/</span>
      <a href={localizedPath(lang, '/pdf-tools')}>{t('nav.pdf')}</a>
      <span>/</span>
      <span class="current">{title}</span>
    </nav>

    <h1>{title}</h1>
    <p class="tool-desc">{description}</p>

    <div class="tool-panel">
      <slot />

      {/*
        Rendered on every tool page and revealed by `guardEncrypted()` when a
        password-protected file is chosen. It lives here rather than in each
        page because the copy is bilingual and a client bundle must not import
        the i18n dictionary — this way the right language is already in the HTML
        and each tool needs a single line of JavaScript.

        Without it, pdf-lib fails on an encrypted file with "Trying to parse
        invalid object" and every tool reports that the document is invalid,
        which is untrue and sends people off to repair a perfectly good file.
      */}
      <div id="encrypted-notice" class="estimate-box warn" hidden>
        {lang === 'ar' ? (
          <span>
            <strong>هذا الملف محمي بكلمة مرور</strong>، فما نقدر نقرأ محتواه — وملفك سليم تمامًا.
            شِل الحماية أول من <a href="/pdf-tools/unlock-pdf">فك حماية PDF</a> وبعدين ارجع لهنا.
          </span>
        ) : (
          <span>
            <strong>This PDF is password-protected</strong>, so its contents cannot be read — there
            is nothing wrong with your file. Remove the password with{' '}
            <a href="/en/pdf-tools/unlock-pdf">Unlock PDF</a> first, then come back.
          </span>
        )}
      </div>
    </div>

    <p class="privacy-note">{t('pdf.privacyNote')}</p>

    {steps.length > 0 && (
      <section class="howto">
        <h2>{stepsHeading}</h2>
        <ol class="howto-steps">
          {steps.map((step, index) => (
            <li id={`step-${index + 1}`}>
              <strong>{step.name}</strong>
              <span>{step.text}</span>
            </li>
          ))}
        </ol>
      </section>
    )}

    <p class="support-hint">
      {lang === 'ar' ? 'عجبتك الأداة؟ ساعدنا نخليها مجانية للأبد — ' : 'Enjoying the tool? Help us keep it free forever — '}
      <a href={lang === 'ar' ? '/support' : '/en/support'}>{lang === 'ar' ? 'ادعم OMXHub ❤️' : 'Support OMXHub ❤️'}</a>
    </p>

    {faq.length > 0 && (
      <section class="faq">
        <h2>{faqHeading}</h2>
        {faq.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </section>
    )}

    {related.length > 0 && (
      <section class="related">
        <h2>{t('pdf.relatedTools')}</h2>
        <div class="related-links">
          {related.map((r) => <a href={r.href}>{r.label}</a>)}
          <a href={localizedPath(lang, '/pdf-tools')} class="all-tools-link">{t('pdf.allTools')} ←</a>
        </div>
      </section>
    )}
  </div>
</Layout>

<style is:global>
  .pdf-tool-page { padding: 32px 0 70px; max-width: 760px; }
  .breadcrumb {
    display: flex;
    gap: 8px;
    align-items: center;
    font-size: 0.8rem;
    color: var(--text-dim);
    margin-bottom: 22px;
    flex-wrap: wrap;
  }
  .breadcrumb a { color: var(--text-dim); text-decoration: none; }
  .breadcrumb a:hover { color: var(--accent); }
  .breadcrumb .current { color: var(--text); }

  .pdf-tool-page h1 { font-size: 1.8rem; margin: 0 0 10px; }
  .tool-desc { color: var(--text-dim); margin-bottom: 28px; font-size: 1rem; }

  .tool-panel {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 28px;
    margin-bottom: 16px;
  }

  .privacy-note {
    font-size: 0.82rem;
    color: var(--free);
    text-align: center;
    margin-bottom: 12px;
  }
  .support-hint {
    font-size: 0.82rem;
    color: var(--text-dim);
    text-align: center;
    margin-bottom: 50px;
  }
  .support-hint a { color: var(--accent-2); }

  /* ---------- HOW TO ---------- */
  .howto { margin: 34px 0 40px; }
  .howto h2 { font-size: 1.2rem; margin-bottom: 16px; }
  .howto-steps {
    counter-reset: step;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .howto-steps li {
    counter-increment: step;
    position: relative;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 14px 18px;
    padding-inline-start: 58px;
  }
  .howto-steps li::before {
    content: counter(step);
    position: absolute;
    inset-inline-start: 16px;
    top: 14px;
    width: 26px;
    height: 26px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: color-mix(in srgb, var(--accent) 16%, transparent);
    color: var(--accent);
    font-family: 'JetBrains Mono', 'JetBrains Mono Fallback', monospace;
    font-size: 0.8rem;
    font-weight: 700;
  }
  .howto-steps strong { display: block; margin-bottom: 4px; }
  .howto-steps span { color: var(--text-dim); font-size: 0.92rem; }

  .faq { margin-bottom: 50px; }
  .faq h2, .related h2 { font-size: 1.2rem; margin-bottom: 16px; }
  .faq details {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 14px 18px;
    margin-bottom: 10px;
  }
  .faq summary { cursor: pointer; font-weight: 600; }
  .faq p { color: var(--text-dim); margin: 10px 0 0; font-size: 0.92rem; }

  .related-links { display: flex; flex-wrap: wrap; gap: 10px; }
  .related-links a {
    background: var(--surface);
    border: 1px solid var(--line);
    padding: 9px 16px;
    border-radius: 100px;
    text-decoration: none;
    color: var(--text);
    font-size: 0.88rem;
  }
  .related-links a:hover { border-color: var(--accent); color: var(--accent); }
  .all-tools-link { color: var(--accent) !important; }

  @media (max-width: 820px) {
    .pdf-tool-page { padding: 24px 0 56px; }
    .pdf-tool-page h1 { font-size: 1.45rem; }
    .tool-desc { font-size: 0.95rem; margin-bottom: 22px; }
    .tool-panel { padding: 18px 16px; border-radius: 14px; }
    .faq details { padding: 12px 14px; }
  }

  /* Shared drop-zone + tool UI styles used by every PDF tool page */
  .drop-zone {
    border: 2px dashed var(--line);
    border-radius: 12px;
    padding: 40px 16px;
    text-align: center;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s;
  }
  .drop-zone:hover, .drop-zone.dragover {
    border-color: var(--accent);
    background: var(--surface-2);
  }
  .drop-zone svg { color: var(--text-dim); margin-bottom: 10px; }
  .drop-zone .drop-text { color: var(--text-dim); font-size: 0.92rem; margin-bottom: 14px; }
  .drop-zone input[type="file"] { display: none; }
  .choose-btn {
    display: inline-block;
    min-height: 44px;
    background: var(--accent);
    color: var(--accent-ink);
    border: none;
    padding: 10px 22px;
    border-radius: 100px;
    font-weight: 700;
    font-size: 0.88rem;
    cursor: pointer;
    font-family: inherit;
  }

  .file-list { margin-top: 18px; display: flex; flex-direction: column; gap: 8px; }
  .file-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    background: var(--surface-2);
    border-radius: 8px;
    padding: 10px 14px;
    font-size: 0.85rem;
  }
  .file-item .file-name {
    font-family: 'JetBrains Mono', 'JetBrains Mono Fallback', monospace;
    color: var(--text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    direction: ltr;
    text-align: left;
  }
  .file-item .file-remove {
    background: none;
    border: none;
    color: var(--text-dim);
    cursor: pointer;
    font-size: 1rem;
    flex-shrink: 0;
  }
  .file-item .file-remove:hover { color: var(--paid); }

  .tool-options { margin-top: 20px; display: flex; flex-direction: column; gap: 14px; }
  .tool-options label { font-size: 0.88rem; color: var(--text-dim); display: block; margin-bottom: 6px; }
  .tool-options input[type="text"],
  .tool-options input[type="password"],
  .tool-options input[type="number"],
  .tool-options select {
    width: 100%;
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 10px 14px;
    color: var(--text);
    font-family: inherit;
    font-size: 0.9rem;
  }
  .tool-options input[type="range"] { width: 100%; }

  /* Checkbox option. The whole row is the label, so the hit target is the
     sentence rather than the 16 px box beside it. */
  .tool-check {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    cursor: pointer;
    font-size: 0.88rem;
    color: var(--text);
  }
  .tool-check input[type="checkbox"] {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    accent-color: var(--accent);
    cursor: pointer;
  }

  /* Inline guidance under a field — advice and validation, not an alert box. */
  .field-note {
    font-size: 0.8rem;
    color: var(--text-dim);
    margin: 0;
  }
  .field-note.warn { color: var(--paid); }

  /* Pre-flight summary: what a tool can achieve on this file, before committing. */
  .estimate-box {
    margin-top: 18px;
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-inline-start: 3px solid var(--accent);
    border-radius: 8px;
    padding: 14px 16px;
    font-size: 0.88rem;
    color: var(--text-dim);
    line-height: 1.6;
  }
  .estimate-box strong { color: var(--text); }
  .estimate-box a { color: var(--accent-2); }
  .estimate-box.warn { border-inline-start-color: var(--paid); }

  .action-btn {
    display: block;
    width: 100%;
    background: var(--accent);
    color: var(--accent-ink);
    border: none;
    padding: 14px;
    border-radius: 10px;
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
    font-family: inherit;
    margin-top: 22px;
  }
  .action-btn:disabled { opacity: 0.5; cursor: not-allowed; }
  .action-btn.secondary {
    background: var(--surface-2);
    color: var(--text);
    border: 1px solid var(--line);
  }

  .status-msg { text-align: center; padding: 20px 0; color: var(--text-dim); font-size: 0.9rem; }
  .status-msg.error { color: var(--paid); }
  .status-msg .spinner {
    display: inline-block;
    width: 16px;
    height: 16px;
    border: 2px solid var(--line);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
    margin-inline-end: 8px;
    vertical-align: middle;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  .result-box {
    text-align: center;
    padding: 24px 0 0;
  }
  .thumb-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(90px, 1fr));
    gap: 10px;
    margin-top: 18px;
  }
  .thumb-grid img {
    width: 100%;
    border-radius: 6px;
    border: 1px solid var(--line);
  }

  /* ---------- PAGE GRID (extract / delete / organize) ---------- */
  /* Shared by the three page-management tools via src/lib/pdf-page-grid.ts. */
  .page-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(104px, 1fr));
    gap: 12px;
    margin-top: 20px;
  }
  .page-tile {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    background: var(--surface-2);
    border: 2px solid var(--line);
    border-radius: 10px;
    padding: 8px 8px 6px;
    cursor: pointer;
    font-family: inherit;
    color: var(--text);
    transition: border-color 0.15s, transform 0.15s;
  }
  .page-tile:hover { border-color: var(--accent); }
  .page-tile:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  /* Selected state, select mode. */
  .page-tile[aria-pressed='true'] {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, var(--surface-2));
  }
  .page-tile[aria-pressed='true']::after {
    content: '✓';
    position: absolute;
    top: 6px;
    inset-inline-end: 6px;
    width: 20px;
    height: 20px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--accent);
    color: var(--accent-ink);
    font-size: 0.72rem;
    font-weight: 700;
  }
  .page-tile[draggable='true'] { cursor: grab; }
  .page-tile.dragging { opacity: 0.4; cursor: grabbing; }

  .tile-thumb {
    width: 100%;
    aspect-ratio: 1 / 1.414; /* A4 — keeps the grid from reflowing as canvases land */
    display: grid;
    place-items: center;
    overflow: hidden;
    border-radius: 4px;
    background: var(--surface);
  }
  .tile-thumb canvas {
    max-width: 100%;
    max-height: 100%;
    display: block;
  }
  .tile-skeleton {
    width: 100%;
    height: 100%;
    background: linear-gradient(
      100deg,
      var(--surface) 30%,
      var(--surface-2) 50%,
      var(--surface) 70%
    );
    background-size: 300% 100%;
    animation: tile-shimmer 1.4s linear infinite;
  }
  @keyframes tile-shimmer { to { background-position: -150% 0; } }
  @media (prefers-reduced-motion: reduce) {
    .tile-skeleton { animation: none; }
    .page-tile { transition: none; }
  }

  .tile-num {
    font-family: 'JetBrains Mono', 'JetBrains Mono Fallback', monospace;
    font-size: 0.72rem;
    color: var(--text-dim);
  }

  .tile-moves { display: flex; gap: 4px; }
  .tile-move {
    width: 26px;
    height: 26px;
    min-height: 26px;
    display: grid;
    place-items: center;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 6px;
    color: var(--text-dim);
    cursor: pointer;
    font-family: inherit;
    font-size: 0.9rem;
    line-height: 1;
  }
  .tile-move:hover { border-color: var(--accent); color: var(--accent); }
  .tile-move:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
  /* The glyphs read as "earlier / later"; mirror them when the page is RTL. */
  [dir='rtl'] .tile-move { transform: scaleX(-1); }

  .grid-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: 20px;
  }
  .grid-toolbar button {
    min-height: 36px;
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: 100px;
    padding: 7px 16px;
    color: var(--text);
    font-family: inherit;
    font-size: 0.82rem;
    cursor: pointer;
  }
  .grid-toolbar button:hover { border-color: var(--accent); color: var(--accent); }
  .grid-count {
    margin-inline-start: auto;
    font-size: 0.82rem;
    color: var(--text-dim);
  }
  .grid-hint {
    font-size: 0.8rem;
    color: var(--text-dim);
    margin: 14px 0 0;
  }

  @media (max-width: 820px) {
    .page-grid { grid-template-columns: repeat(auto-fill, minmax(84px, 1fr)); gap: 10px; }
    .grid-count { margin-inline-start: 0; width: 100%; }
  }

  /* ---------- CROP STAGE ---------- */
  /* Driven by src/lib/pdf-crop-box.ts. Geometry here is deliberately physical
     (left/right, not inline-start/end): a crop is a fact about the page, so it
     must not flip when the surrounding UI is right-to-left. */
  .crop-stage { margin-top: 20px; }

  .crop-preview {
    position: relative;
    max-width: 520px;
    margin: 0 auto;
    border-radius: 8px;
    overflow: hidden;
    /* Stops the browser panning the page out from under a crop drag on touch. */
    touch-action: none;
  }
  .crop-canvas {
    display: block;
    width: 100%;
    background: var(--surface-2);
  }
  .crop-canvas canvas { display: block; }

  .crop-rect {
    position: absolute;
    border: 2px solid var(--accent);
    /* The oversized spread dims everything outside the selection in one
       declaration; the parent's overflow clip keeps it on the preview. */
    box-shadow: 0 0 0 9999px color-mix(in srgb, var(--bg) 62%, transparent);
    cursor: move;
    touch-action: none;
  }

  .crop-handle {
    position: absolute;
    width: 16px;
    height: 16px;
    background: var(--accent);
    border: 2px solid var(--accent-ink);
    border-radius: 3px;
  }
  .crop-handle[data-handle='nw'] { top: -9px; left: -9px; cursor: nwse-resize; }
  .crop-handle[data-handle='ne'] { top: -9px; right: -9px; cursor: nesw-resize; }
  .crop-handle[data-handle='sw'] { bottom: -9px; left: -9px; cursor: nesw-resize; }
  .crop-handle[data-handle='se'] { bottom: -9px; right: -9px; cursor: nwse-resize; }

  .crop-hint {
    font-size: 0.8rem;
    color: var(--text-dim);
    text-align: center;
    margin: 14px 0 0;
  }

  .crop-fields {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin-top: 16px;
  }
  .crop-fields label {
    display: block;
    font-size: 0.82rem;
    color: var(--text-dim);
    margin-bottom: 6px;
  }
  .crop-fields input[type='number'] {
    width: 100%;
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 9px 10px;
    color: var(--text);
    font-family: inherit;
    font-size: 0.9rem;
    /* Percentages read left-to-right in both languages. */
    direction: ltr;
    text-align: center;
  }

  @media (max-width: 560px) {
    .crop-fields { grid-template-columns: repeat(2, 1fr); }
    .crop-handle { width: 22px; height: 22px; }
    .crop-handle[data-handle='nw'] { top: -12px; left: -12px; }
    .crop-handle[data-handle='ne'] { top: -12px; right: -12px; }
    .crop-handle[data-handle='sw'] { bottom: -12px; left: -12px; }
    .crop-handle[data-handle='se'] { bottom: -12px; right: -12px; }
  }
</style>
