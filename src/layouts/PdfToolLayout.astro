---
/**
 * PDF-tool chrome: everything `ToolLayout` provides, plus the two things that
 * are specific to operating on PDFs — the encrypted-file notice, and the CSS for
 * the page-thumbnail grid and crop stage.
 *
 * The props are unchanged from when this file held the whole implementation, so
 * the 28 pages importing it never had to know the base was extracted.
 */
import ToolLayout from './ToolLayout.astro';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface FaqItem { q: string; a: string; }
interface RelatedTool { label: string; href: string; }
interface Step { name: string; text: string; }

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Usage steps. Rendered visibly on the page and mirrored as HowTo JSON-LD. */
  steps?: Step[];
  faq?: FaqItem[];
  related?: RelatedTool[];
}
const { lang, title, description, steps = [], faq = [], related = [] } = Astro.props;
const t = useTranslations(lang);
---
<ToolLayout
  lang={lang}
  title={title}
  description={description}
  hub={{ label: t('nav.pdf'), path: '/pdf-tools' }}
  labels={{
    privacyNote: t('pdf.privacyNote'),
    relatedTools: t('pdf.relatedTools'),
    allTools: t('pdf.allTools'),
  }}
  steps={steps}
  faq={faq}
  related={related}
>
  <slot />

  {/*
    Rendered on every tool page and revealed by `guardEncrypted()` when a
    password-protected file is chosen. It lives here rather than in each
    page because the copy is bilingual and a client bundle must not import
    the i18n dictionary — this way the right language is already in the HTML
    and each tool needs a single line of JavaScript.

    Without it, pdf-lib fails on an encrypted file with "Trying to parse
    invalid object" and every tool reports that the document is invalid,
    which is untrue and sends people off to repair a perfectly good file.
  */}
  <Fragment slot="panel-extra">
    <div id="encrypted-notice" class="estimate-box warn" hidden>
      {lang === 'ar' ? (
        <span>
          <strong>هذا الملف محمي بكلمة مرور</strong>، فما نقدر نقرأ محتواه — وملفك سليم تمامًا.
          شِل الحماية أول من <a href="/pdf-tools/unlock-pdf">فك حماية PDF</a> وبعدين ارجع لهنا.
        </span>
      ) : (
        <span>
          <strong>This PDF is password-protected</strong>, so its contents cannot be read — there
          is nothing wrong with your file. Remove the password with{' '}
          <a href="/en/pdf-tools/unlock-pdf">Unlock PDF</a> first, then come back.
        </span>
      )}
    </div>
  </Fragment>
</ToolLayout>

<style is:global>
  /* ---------- PAGE GRID (extract / delete / organize) ---------- */
  /* Shared by the three page-management tools via src/lib/pdf-page-grid.ts. */
  .page-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(104px, 1fr));
    gap: 12px;
    margin-top: 20px;
  }
  .page-tile {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    background: var(--surface-2);
    border: 2px solid var(--line);
    border-radius: 10px;
    padding: 8px 8px 6px;
    cursor: pointer;
    font-family: inherit;
    color: var(--text);
    transition: border-color 0.15s, transform 0.15s;
  }
  .page-tile:hover { border-color: var(--accent); }
  .page-tile:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  /* Selected state, select mode. */
  .page-tile[aria-pressed='true'] {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, var(--surface-2));
  }
  .page-tile[aria-pressed='true']::after {
    content: '✓';
    position: absolute;
    top: 6px;
    inset-inline-end: 6px;
    width: 20px;
    height: 20px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--accent);
    color: var(--accent-ink);
    font-size: 0.72rem;
    font-weight: 700;
  }
  .page-tile[draggable='true'] { cursor: grab; }
  .page-tile.dragging { opacity: 0.4; cursor: grabbing; }

  .tile-thumb {
    width: 100%;
    aspect-ratio: 1 / 1.414; /* A4 — keeps the grid from reflowing as canvases land */
    display: grid;
    place-items: center;
    overflow: hidden;
    border-radius: 4px;
    background: var(--surface);
  }
  .tile-thumb canvas {
    max-width: 100%;
    max-height: 100%;
    display: block;
  }
  .tile-skeleton {
    width: 100%;
    height: 100%;
    background: linear-gradient(
      100deg,
      var(--surface) 30%,
      var(--surface-2) 50%,
      var(--surface) 70%
    );
    background-size: 300% 100%;
    animation: tile-shimmer 1.4s linear infinite;
  }
  @keyframes tile-shimmer { to { background-position: -150% 0; } }
  @media (prefers-reduced-motion: reduce) {
    .tile-skeleton { animation: none; }
    .page-tile { transition: none; }
  }

  .tile-num {
    font-family: 'JetBrains Mono', 'JetBrains Mono Fallback', monospace;
    font-size: 0.72rem;
    color: var(--text-dim);
  }

  .tile-moves { display: flex; gap: 4px; }
  .tile-move {
    width: 26px;
    height: 26px;
    min-height: 26px;
    display: grid;
    place-items: center;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 6px;
    color: var(--text-dim);
    cursor: pointer;
    font-family: inherit;
    font-size: 0.9rem;
    line-height: 1;
  }
  .tile-move:hover { border-color: var(--accent); color: var(--accent); }
  .tile-move:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
  /* The glyphs read as "earlier / later"; mirror them when the page is RTL. */
  [dir='rtl'] .tile-move { transform: scaleX(-1); }

  .grid-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: 20px;
  }
  .grid-toolbar button {
    min-height: 36px;
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: 100px;
    padding: 7px 16px;
    color: var(--text);
    font-family: inherit;
    font-size: 0.82rem;
    cursor: pointer;
  }
  .grid-toolbar button:hover { border-color: var(--accent); color: var(--accent); }
  .grid-count {
    margin-inline-start: auto;
    font-size: 0.82rem;
    color: var(--text-dim);
  }
  .grid-hint {
    font-size: 0.8rem;
    color: var(--text-dim);
    margin: 14px 0 0;
  }

  @media (max-width: 820px) {
    .page-grid { grid-template-columns: repeat(auto-fill, minmax(84px, 1fr)); gap: 10px; }
    .grid-count { margin-inline-start: 0; width: 100%; }
  }

  /* ---------- CROP STAGE ---------- */
  /* Driven by src/lib/pdf-crop-box.ts. Geometry here is deliberately physical
     (left/right, not inline-start/end): a crop is a fact about the page, so it
     must not flip when the surrounding UI is right-to-left. */
  .crop-stage { margin-top: 20px; }

  .crop-preview {
    position: relative;
    max-width: 520px;
    margin: 0 auto;
    border-radius: 8px;
    overflow: hidden;
    /* Stops the browser panning the page out from under a crop drag on touch. */
    touch-action: none;
  }
  .crop-canvas {
    display: block;
    width: 100%;
    background: var(--surface-2);
  }
  .crop-canvas canvas { display: block; }

  .crop-rect {
    position: absolute;
    border: 2px solid var(--accent);
    /* The oversized spread dims everything outside the selection in one
       declaration; the parent's overflow clip keeps it on the preview. */
    box-shadow: 0 0 0 9999px color-mix(in srgb, var(--bg) 62%, transparent);
    cursor: move;
    touch-action: none;
  }

  .crop-handle {
    position: absolute;
    width: 16px;
    height: 16px;
    background: var(--accent);
    border: 2px solid var(--accent-ink);
    border-radius: 3px;
  }
  .crop-handle[data-handle='nw'] { top: -9px; left: -9px; cursor: nwse-resize; }
  .crop-handle[data-handle='ne'] { top: -9px; right: -9px; cursor: nesw-resize; }
  .crop-handle[data-handle='sw'] { bottom: -9px; left: -9px; cursor: nesw-resize; }
  .crop-handle[data-handle='se'] { bottom: -9px; right: -9px; cursor: nwse-resize; }

  .crop-hint {
    font-size: 0.8rem;
    color: var(--text-dim);
    text-align: center;
    margin: 14px 0 0;
  }

  .crop-fields {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin-top: 16px;
  }
  .crop-fields label {
    display: block;
    font-size: 0.82rem;
    color: var(--text-dim);
    margin-bottom: 6px;
  }
  .crop-fields input[type='number'] {
    width: 100%;
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 9px 10px;
    color: var(--text);
    font-family: inherit;
    font-size: 0.9rem;
    /* Percentages read left-to-right in both languages. */
    direction: ltr;
    text-align: center;
  }

  @media (max-width: 560px) {
    .crop-fields { grid-template-columns: repeat(2, 1fr); }
    .crop-handle { width: 22px; height: 22px; }
    .crop-handle[data-handle='nw'] { top: -12px; left: -12px; }
    .crop-handle[data-handle='ne'] { top: -12px; right: -12px; }
    .crop-handle[data-handle='sw'] { bottom: -12px; left: -12px; }
    .crop-handle[data-handle='se'] { bottom: -12px; right: -12px; }
  }
</style>
