---
import Layout from '../../layouts/Layout.astro';
import ToolCard from '../../components/ToolCard.astro';
import { useTranslations, localizedPath } from '../../i18n/utils';
import { getCollection } from 'astro:content';

const lang = 'ar' as const;
const t = useTranslations(lang);
const allTools = (await getCollection('tools')).filter((tool) => tool.data.lang === lang);
---
<Layout title={t('tools.title')} description="دليل عربي لأدوات الذكاء الاصطناعي: شرح مفصل، المميزات، الأسعار، الإيجابيات والسلبيات، وأفضل البدائل لكل أداة.">
  <section class="wrap section">
    <h1>{t('tools.title')}</h1>
    <p class="count">{allTools.length} {t('tools.count')}</p>
    <div class="grid">
      {allTools.map((tool) => (
        <ToolCard
          href={localizedPath(lang, `/ai-tools/${tool.id.split('/')[1]}`)}
          name={tool.data.name}
          tagline={tool.data.tagline}
          category={tool.data.category}
          pricingType={tool.data.pricingType}
          rating={tool.data.rating}
          lang={lang}
        />
      ))}
    </div>
  </section>
</Layout>

<style>
  .section { padding: 40px 0 70px; }
  h1 { margin-bottom: 4px; }
  .count { color: var(--text-dim); margin-bottom: 28px; font-size: 0.9rem; font-family: 'JetBrains Mono', monospace; }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 18px;
  }
</style>
