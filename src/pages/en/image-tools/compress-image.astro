---
import ImageToolLayout from '../../../layouts/ImageToolLayout.astro';
import { useTranslations } from '../../../i18n/utils';
import { relatedImageTools } from '../../../data/image-tools';

const lang = 'en' as const;
const t = useTranslations(lang);

const faq = [
  {
    q: 'Does compressing reduce image quality?',
    a: 'Yes — compression discards detail your eye normally does not notice. At 80% most images drop to half their size or less with no visible difference. Push the quality much lower and you will start to see noise around edges and text.',
  },
  {
    q: 'Why does it sometimes say my image cannot be compressed?',
    a: 'Because this tool never hands back a file larger than the one you gave it. If your image is already well compressed, every attempt comes out bigger than the original, so we say so plainly instead of giving you a worse file.',
  },
  {
    q: 'What happens to images with a transparent background?',
    a: 'Transparency is detected automatically and JPEG is never suggested in auto mode, because JPEG has no alpha channel and would turn the transparent background black. If you pick JPEG yourself we warn you first and fill the background with white rather than black.',
  },
  {
    q: 'Why does WebP usually win?',
    a: 'WebP compresses harder than JPEG at roughly the same quality, and it is the only format here that supports transparency and lossy compression at once. Every current browser displays it. If yours cannot encode it, the option is removed automatically.',
  },
  {
    q: 'Is my image uploaded to a server?',
    a: 'No. Everything happens inside your browser — the image never leaves your device, and there is no daily usage limit.',
  },
  {
    q: 'What happens to EXIF data and GPS location?',
    a: 'It is removed. Re-encoding strips all attached metadata, including GPS coordinates and camera model. That is useful if you are publishing the image, but worth knowing if you need to keep that data.',
  },
  {
    q: 'Why is my photo not rotated sideways like on other sites?',
    a: 'Because this tool reads the EXIF orientation flag before processing. Many tools ignore it, which is why phone photos so often come back lying on their side.',
  },
];

const steps = [
  { name: 'Upload an image', text: 'Drag it onto the drop zone or click "Choose image". JPG, PNG, WebP and more are supported.' },
  { name: 'Set the quality', text: 'Start at 80% — that is the sweet spot between file size and sharpness for most images.' },
  { name: 'Optionally cap the dimensions', text: 'For an image going on a web page, resizing to 1920px saves far more than any quality setting.' },
  { name: 'Click "Compress Image"', text: 'Several formats are tried and the smallest one wins — and you never get back a file larger than the original.' },
];

const related = relatedImageTools(lang, 'compress-image');
---
<ImageToolLayout
  lang={lang}
  title="Compress Image"
  description="Shrink JPG, PNG and WebP images without visibly losing quality — free and entirely in your browser"
  steps={steps}
  faq={faq}
  related={related}
>
  <div id="drop-zone" class="drop-zone">
    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
    <p class="drop-text">{t('image.dropHereSingle')}</p>
    <button type="button" class="choose-btn" id="choose-btn">{t('image.chooseFile')}</button>
    <input type="file" id="file-input" accept="image/*" />
  </div>

  <div id="file-list" class="file-list"></div>

  <div id="preview" class="image-preview" hidden>
    <img id="preview-img" alt="" />
  </div>

  <div id="options" class="tool-options" hidden>
    <div>
      <label for="quality-range">Quality — <output id="quality-out">80%</output></label>
      <input type="range" id="quality-range" min="0.1" max="1" step="0.05" value="0.8" />
      <p class="field-note">Lower quality means a smaller file. 80% suits most images.</p>
    </div>

    <div>
      <label for="maxedge-select">Maximum width or height</label>
      <select id="maxedge-select">
        <option value="0">Keep original dimensions</option>
        <option value="2560">2560px — large displays</option>
        <option value="1920">1920px — good for the web</option>
        <option value="1280">1280px — articles and blogs</option>
        <option value="800">800px — thumbnails</option>
      </select>
      <p class="field-note">Resizing saves more than any quality setting, and an image smaller than the cap is never enlarged.</p>
    </div>

    <div>
      <label for="format-select">Format</label>
      <select id="format-select">
        <option value="auto">Auto — try all and keep the smallest</option>
        <option value="webp">WebP</option>
        <option value="jpeg">JPEG</option>
        <option value="png">PNG</option>
      </select>
      <p class="field-note warn" id="format-note" hidden>
        This image has a transparent background and JPEG cannot store transparency — it will be filled with white. Choose WebP or PNG to keep it.
      </p>
    </div>
  </div>

  <button type="button" id="action-btn" class="action-btn" disabled>Compress Image</button>
  <div id="status" class="status-msg" hidden></div>
</ImageToolLayout>

<script>
  import { mountCompressTool } from '../../../lib/image-compress-ui';

  mountCompressTool({
    processing: 'Compressing...',
    error: 'Something went wrong — make sure the file is a valid image and try again',
    download: 'Download Compressed Image',
    originalLabel: 'Original',
    resultLabel: 'Compressed',
    noImprovement: 'Your image is already well compressed — every attempt came out larger than the original, so nothing was changed. Try lowering the quality or capping the dimensions.',
    noFormat: 'Your browser cannot encode that format. Try "Auto" or pick another one.',
    tooLarge: 'That image is too large (50 MB limit). Resize it first or try another one.',
    smaller: (percent) => `${percent}% smaller`,
    // Compress never returns a larger file, so these two are unreachable here.
    // They exist because the result panel is shared with the tools where growth
    // is a legitimate outcome, and a shared panel with per-tool gaps in it is
    // how one of them ends up silently showing nothing.
    larger: (percent) => `${percent}% larger`,
    same: 'Same size as the original',
    resizedTo: (width, height) => `New dimensions: ${width}×${height}px`,
  });
</script>
