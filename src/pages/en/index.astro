---
import Layout from '../../layouts/Layout.astro';
import ToolCard from '../../components/ToolCard.astro';
import SiteSearch from '../../components/SiteSearch.astro';
import { categories } from '../../data/categories';
import { useTranslations, localizedPath } from '../../i18n/utils';
import { getCollection } from 'astro:content';

const lang = 'en' as const;
const t = useTranslations(lang);

const allTools = (await getCollection('tools')).filter((t) => t.data.lang === lang);
const latest = [...allTools]
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 6);
const featured = allTools.filter((tool) => tool.data.featured).slice(0, 6);
const freeTools = allTools.filter((tool) => tool.data.pricingType !== 'paid').slice(0, 6);

// Auto-generate a section per category that actually has tools —
// new tools/categories show up here automatically, no manual edits needed.
const categorySections = Object.entries(categories)
  .map(([slug, cat]) => ({
    slug,
    cat,
    tools: allTools.filter((tool) => tool.data.category === slug).slice(0, 6),
  }))
  .filter((section) => section.tools.length > 0);
---
<Layout
  title={t('home.hero.title')}
  description={t('home.hero.subtitle')}
>
  <section class="hero">
    <div class="wrap">
      <h1>{t('home.hero.title')}</h1>
      <p>{t('home.hero.subtitle')}</p>
      <SiteSearch lang={lang} placeholder={t('home.hero.searchPlaceholder')} noResultsText={t('search.noResults')} />
    </div>
  </section>

  <section class="wrap section">
    <h2>{t('home.latest')}</h2>
    <div class="grid">
      {latest.map((tool) => (
        <ToolCard
          href={localizedPath(lang, `/ai-tools/${tool.id.split('/')[1]}`)}
          name={tool.data.name}
          tagline={tool.data.tagline}
          category={tool.data.category}
          pricingType={tool.data.pricingType}
          rating={tool.data.rating}
          lang={lang}
        />
      ))}
    </div>
  </section>

  <section class="wrap section">
    <h2>{t('home.popular')}</h2>
    <div class="grid">
      {featured.map((tool) => (
        <ToolCard
          href={localizedPath(lang, `/ai-tools/${tool.id.split('/')[1]}`)}
          name={tool.data.name}
          tagline={tool.data.tagline}
          category={tool.data.category}
          pricingType={tool.data.pricingType}
          rating={tool.data.rating}
          lang={lang}
        />
      ))}
    </div>
  </section>

  <section class="wrap section">
    <h2>{t('home.freeTools')}</h2>
    <div class="grid">
      {freeTools.map((tool) => (
        <ToolCard
          href={localizedPath(lang, `/ai-tools/${tool.id.split('/')[1]}`)}
          name={tool.data.name}
          tagline={tool.data.tagline}
          category={tool.data.category}
          pricingType={tool.data.pricingType}
          rating={tool.data.rating}
          lang={lang}
        />
      ))}
    </div>
  </section>

  {categorySections.map((section) => (
    <section class="wrap section">
      <h2>{section.cat.icon} {section.cat[lang]}</h2>
      <div class="grid">
        {section.tools.map((tool) => (
          <ToolCard
            href={localizedPath(lang, `/ai-tools/${tool.id.split('/')[1]}`)}
            name={tool.data.name}
            tagline={tool.data.tagline}
            category={tool.data.category}
            pricingType={tool.data.pricingType}
            rating={tool.data.rating}
            lang={lang}
          />
        ))}
      </div>
    </section>
  ))}

  <section class="wrap section">
    <h2>{t('home.categories')}</h2>
    <div class="cat-grid">
      {Object.entries(categories).map(([slug, cat]) => (
        <a href={localizedPath(lang, `/ai-tools/${slug}`)} class="cat-pill">
          <span>{cat.icon}</span> {cat[lang]}
        </a>
      ))}
    </div>
  </section>
</Layout>

<style>
  .hero {
    background: linear-gradient(180deg, var(--surface) 0%, var(--bg) 100%);
    border-bottom: 1px solid var(--line);
    padding: 70px 0 90px;
    text-align: center;
  }
  .hero h1 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    margin: 0 0 16px;
  }
  .hero p {
    max-width: 560px;
    margin: 0 auto 32px;
    color: var(--text-dim);
  }

  .section { padding: 50px 0; }
  .section h2 {
    font-size: 1.3rem;
    margin-bottom: 22px;
    border-inline-start: 3px solid var(--accent);
    padding-inline-start: 12px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 18px;
  }
  .cat-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .cat-pill {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 100px;
    padding: 10px 18px;
    text-decoration: none;
    color: var(--text);
    font-size: 0.9rem;
  }
  .cat-pill:hover { border-color: var(--accent); color: var(--accent); }
</style>
