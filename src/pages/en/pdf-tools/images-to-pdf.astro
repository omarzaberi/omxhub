---
import PdfToolLayout from '../../../layouts/PdfToolLayout.astro';
import { useTranslations, localizedPath } from '../../../i18n/utils';

const lang = 'en' as const;
const t = useTranslations(lang);

const faq = [
  { q: 'What formats are supported?', a: 'JPG and PNG are supported. Each image becomes its own PDF page at the same dimensions.' },
  { q: 'Does image order matter?', a: 'Yes, images are placed as consecutive pages in the order you upload them.' },
];
const steps = [
  { name: 'Upload your images', text: 'Drag JPG or PNG files onto the drop zone or click "Choose files". One image or many.' },
  { name: 'Check the order', text: 'Each image becomes its own PDF page at the same dimensions, in the order you uploaded them.' },
  { name: 'Click "Convert to PDF"', text: 'Conversion runs in your browser — your images are never uploaded anywhere.' },
  { name: 'Download the result', text: 'You get a single PDF with every image as a consecutive page.' },
];
const related = [
  { label: 'PDF to Images', href: localizedPath(lang, '/pdf-tools/pdf-to-images') },
  { label: 'Merge PDF', href: localizedPath(lang, '/pdf-tools/merge-pdf') },
];
---
<PdfToolLayout
  lang={lang}
  title="Convert Images to PDF"
  description="Convert one or more images (JPG/PNG) into a single PDF file, free and entirely in your browser"
  steps={steps}
  faq={faq}
  related={related}
>
  <div id="drop-zone" class="drop-zone">
    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
    <p class="drop-text">{t('pdf.dropHere')}</p>
    <button type="button" class="choose-btn" id="choose-btn">{t('pdf.chooseFiles')}</button>
    <input type="file" id="file-input" accept="image/jpeg,image/png" multiple />
  </div>

  <div id="file-list" class="file-list"></div>

  <button type="button" id="action-btn" class="action-btn" disabled>Convert to PDF</button>
  <div id="status" class="status-msg" hidden></div>
</PdfToolLayout>

<script>
  import { PDFDocument } from 'pdf-lib';

  const dropZone = document.getElementById('drop-zone')!;
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const chooseBtn = document.getElementById('choose-btn')!;
  const fileListEl = document.getElementById('file-list')!;
  const actionBtn = document.getElementById('action-btn') as HTMLButtonElement;
  const statusEl = document.getElementById('status')!;

  let files: File[] = [];

  function renderFileList() {
    fileListEl.innerHTML = files
      .map(
        (f, i) => `
        <div class="file-item">
          <span class="file-name">🖼️ ${f.name}</span>
          <button type="button" class="file-remove" data-index="${i}">✕</button>
        </div>`
      )
      .join('');
    actionBtn.disabled = files.length === 0;
    fileListEl.querySelectorAll('.file-remove').forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = Number((btn as HTMLElement).dataset.index);
        files.splice(idx, 1);
        renderFileList();
      });
    });
  }

  function addFiles(newFiles: FileList | File[]) {
    for (const f of Array.from(newFiles)) {
      if (f.type === 'image/jpeg' || f.type === 'image/png') files.push(f);
    }
    renderFileList();
  }

  chooseBtn.addEventListener('click', () => fileInput.click());
  dropZone.addEventListener('click', (e) => {
    if (e.target === dropZone || (e.target as HTMLElement).tagName !== 'BUTTON') fileInput.click();
  });
  fileInput.addEventListener('change', () => addFiles(fileInput.files!));
  dropZone.addEventListener('dragover', (e) => { e.preventDefault(); dropZone.classList.add('dragover'); });
  dropZone.addEventListener('dragleave', () => dropZone.classList.remove('dragover'));
  dropZone.addEventListener('drop', (e) => {
    e.preventDefault();
    dropZone.classList.remove('dragover');
    if (e.dataTransfer?.files) addFiles(e.dataTransfer.files);
  });

  actionBtn.addEventListener('click', async () => {
    statusEl.hidden = false;
    statusEl.className = 'status-msg';
    statusEl.innerHTML = '<span class="spinner"></span> Converting...';
    actionBtn.disabled = true;
    try {
      const doc = await PDFDocument.create();
      for (const file of files) {
        const bytes = await file.arrayBuffer();
        const img = file.type === 'image/png' ? await doc.embedPng(bytes) : await doc.embedJpg(bytes);
        const page = doc.addPage([img.width, img.height]);
        page.drawImage(img, { x: 0, y: 0, width: img.width, height: img.height });
      }
      const outBytes = await doc.save();
      const blob = new Blob([outBytes], { type: 'application/pdf' });
      const url = URL.createObjectURL(blob);
      statusEl.innerHTML = `<a class="action-btn" href="${url}" download="images.pdf">⬇ Download PDF</a>`;
    } catch (err) {
      console.error(err);
      statusEl.className = 'status-msg error';
      statusEl.textContent = 'Something went wrong — make sure your images are valid JPG or PNG files';
    } finally {
      actionBtn.disabled = files.length === 0;
    }
  });
</script>
