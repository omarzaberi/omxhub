---
import PdfToolLayout from '../../../layouts/PdfToolLayout.astro';
import { useTranslations } from '../../../i18n/utils';
import { relatedPdfTools } from '../../../data/pdf-tools';

const lang = 'en' as const;
const t = useTranslations(lang);

const faq = [
  { q: 'Is my data safe?', a: 'Completely. Merging happens entirely in your browser via JavaScript — your files are never uploaded to any server.' },
  { q: 'How many files can I merge at once?', a: "There's no strict limit, but very large or numerous files may slow your browser down." },
  { q: 'Does file order matter?', a: 'Yes, files are merged in the order you upload them. You can remove and re-add files in a different order if needed.' },
];
const steps = [
  { name: 'Upload your files', text: 'Drag your PDF files onto the drop zone or click "Choose files". You can select several at once.' },
  { name: 'Set the order', text: 'Files are merged in the order you upload them. Remove any file with the ✕ button and re-add it to change the order.' },
  { name: 'Click "Merge Files"', text: 'Merging happens inside your browser — nothing is uploaded to a server and there is no queue to wait in.' },
  { name: 'Download the result', text: 'You get a single PDF containing every page in the order you set.' },
];
const related = relatedPdfTools(lang, 'merge-pdf');
---
<PdfToolLayout
  lang={lang}
  title="Merge PDF Files"
  description="Combine multiple PDF files into one organized document, free and entirely in your browser"
  steps={steps}
  faq={faq}
  related={related}
>
  <div id="drop-zone" class="drop-zone">
    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
    <p class="drop-text">{t('pdf.dropHere')}</p>
    <button type="button" class="choose-btn" id="choose-btn">{t('pdf.chooseFiles')}</button>
    <input type="file" id="file-input" accept="application/pdf" multiple />
  </div>

  <div id="file-list" class="file-list"></div>

  <button type="button" id="action-btn" class="action-btn" disabled>Merge Files</button>
  <div id="status" class="status-msg" hidden></div>
</PdfToolLayout>

<script>
  import { loadPdfLib } from '../../../lib/pdf-libs';
  import { guardEncrypted } from '../../../lib/pdf-encrypted';

  const dropZone = document.getElementById('drop-zone')!;
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const chooseBtn = document.getElementById('choose-btn')!;
  const fileListEl = document.getElementById('file-list')!;
  const actionBtn = document.getElementById('action-btn') as HTMLButtonElement;
  const statusEl = document.getElementById('status')!;

  let files: File[] = [];

  function renderFileList() {
    fileListEl.innerHTML = files
      .map(
        (f, i) => `
        <div class="file-item">
          <span class="file-name">📄 ${f.name}</span>
          <button type="button" class="file-remove" data-index="${i}">✕</button>
        </div>`
      )
      .join('');
    actionBtn.disabled = files.length < 2;
    fileListEl.querySelectorAll('.file-remove').forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = Number((btn as HTMLElement).dataset.index);
        files.splice(idx, 1);
        renderFileList();
      });
    });
  }

  function addFiles(newFiles: FileList | File[]) {
    for (const f of Array.from(newFiles)) {
      if (f.type === 'application/pdf') files.push(f);
    }
    renderFileList();
    // Choosing a file is a commitment to the action, so start fetching the
    // engine now. It is normally parsed and ready before the button is pressed.
    void loadPdfLib();
  }

  chooseBtn.addEventListener('click', () => fileInput.click());
  dropZone.addEventListener('click', (e) => {
    if (e.target === dropZone || (e.target as HTMLElement).tagName !== 'BUTTON') fileInput.click();
  });
  fileInput.addEventListener('change', () => addFiles(fileInput.files!));

  dropZone.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropZone.classList.add('dragover');
  });
  dropZone.addEventListener('dragleave', () => dropZone.classList.remove('dragover'));
  dropZone.addEventListener('drop', (e) => {
    e.preventDefault();
    dropZone.classList.remove('dragover');
    if (e.dataTransfer?.files) addFiles(e.dataTransfer.files);
  });

  actionBtn.addEventListener('click', async () => {
    statusEl.hidden = false;
    statusEl.className = 'status-msg';
    statusEl.innerHTML = '<span class="spinner"></span> Merging...';
    actionBtn.disabled = true;
    try {
      const { PDFDocument } = await loadPdfLib();
      const merged = await PDFDocument.create();
      for (const file of files) {
        const bytes = await file.arrayBuffer();
        if (guardEncrypted(bytes)) return;
        const doc = await PDFDocument.load(bytes);
        const pages = await merged.copyPages(doc, doc.getPageIndices());
        pages.forEach((p) => merged.addPage(p));
      }
      const outBytes = await merged.save();
      const blob = new Blob([outBytes], { type: 'application/pdf' });
      const url = URL.createObjectURL(blob);
      statusEl.innerHTML = `<a class="action-btn" href="${url}" download="merged.pdf">⬇ Download Merged File</a>`;
    } catch (err) {
      console.error(err);
      statusEl.className = 'status-msg error';
      statusEl.textContent = 'Something went wrong — make sure your files are valid PDFs and try again';
    } finally {
      actionBtn.disabled = files.length < 2;
    }
  });
</script>
