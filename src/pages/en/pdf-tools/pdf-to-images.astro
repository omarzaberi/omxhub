---
import PdfToolLayout from '../../../layouts/PdfToolLayout.astro';
import { useTranslations, localizedPath } from '../../../i18n/utils';

const lang = 'en' as const;
const t = useTranslations(lang);

const faq = [
  { q: 'What quality are the output images?', a: 'Images are saved as high-quality PNG (roughly 150 DPI equivalent), suitable for most uses.' },
  { q: 'How do I download all the images at once?', a: "If the file has more than one page, you'll get a ZIP with all images. For a single page, it downloads directly as a PNG." },
];
const steps = [
  { name: 'Upload a PDF', text: 'Drag the file onto the drop zone or click "Choose file".' },
  { name: 'Click "Convert to Images"', text: 'Every page is rendered to a PNG inside your browser at roughly 150 DPI.' },
  { name: 'Review the previews', text: 'Thumbnails of all pages appear so you can check the output before downloading.' },
  { name: 'Download the result', text: 'Multiple pages download as a ZIP; a single page downloads straight as a PNG.' },
];
const related = [
  { label: 'Images to PDF', href: localizedPath(lang, '/pdf-tools/images-to-pdf') },
  { label: 'Split PDF', href: localizedPath(lang, '/pdf-tools/split-pdf') },
];
---
<PdfToolLayout
  lang={lang}
  title="Convert PDF to Images"
  description="Convert every page of a PDF into a separate PNG image, free and entirely in your browser"
  steps={steps}
  faq={faq}
  related={related}
>
  <div id="drop-zone" class="drop-zone">
    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
    <p class="drop-text">{t('pdf.dropHereSingle')}</p>
    <button type="button" class="choose-btn" id="choose-btn">{t('pdf.chooseFile')}</button>
    <input type="file" id="file-input" accept="application/pdf" />
  </div>

  <div id="file-list" class="file-list"></div>

  <button type="button" id="action-btn" class="action-btn" disabled>Convert to Images</button>
  <div id="status" class="status-msg" hidden></div>
  <div id="thumbs" class="thumb-grid"></div>
</PdfToolLayout>

<script>
  import * as pdfjsLib from 'pdfjs-dist';
  // @ts-ignore
  import pdfjsWorker from 'pdfjs-dist/build/pdf.worker.mjs?url';
  // @ts-ignore
  import JSZip from 'jszip';

  pdfjsLib.GlobalWorkerOptions.workerSrc = pdfjsWorker;

  const dropZone = document.getElementById('drop-zone')!;
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const chooseBtn = document.getElementById('choose-btn')!;
  const fileListEl = document.getElementById('file-list')!;
  const actionBtn = document.getElementById('action-btn') as HTMLButtonElement;
  const statusEl = document.getElementById('status')!;
  const thumbsEl = document.getElementById('thumbs')!;

  let currentFile: File | null = null;

  async function loadFile(f: File) {
    currentFile = f;
    fileListEl.innerHTML = `<div class="file-item"><span class="file-name">📄 ${f.name}</span></div>`;
    thumbsEl.innerHTML = '';
    actionBtn.disabled = false;
  }

  chooseBtn.addEventListener('click', () => fileInput.click());
  dropZone.addEventListener('click', (e) => {
    if (e.target === dropZone || (e.target as HTMLElement).tagName !== 'BUTTON') fileInput.click();
  });
  fileInput.addEventListener('change', () => fileInput.files?.[0] && loadFile(fileInput.files[0]));
  dropZone.addEventListener('dragover', (e) => { e.preventDefault(); dropZone.classList.add('dragover'); });
  dropZone.addEventListener('dragleave', () => dropZone.classList.remove('dragover'));
  dropZone.addEventListener('drop', (e) => {
    e.preventDefault();
    dropZone.classList.remove('dragover');
    const f = e.dataTransfer?.files?.[0];
    if (f && f.type === 'application/pdf') loadFile(f);
  });

  actionBtn.addEventListener('click', async () => {
    if (!currentFile) return;
    statusEl.hidden = false;
    statusEl.className = 'status-msg';
    statusEl.innerHTML = '<span class="spinner"></span> Converting...';
    actionBtn.disabled = true;
    thumbsEl.innerHTML = '';
    try {
      const bytes = await currentFile.arrayBuffer();
      const pdf = await pdfjsLib.getDocument({ data: bytes }).promise;
      const images: { name: string; blob: Blob }[] = [];

      for (let i = 1; i <= pdf.numPages; i++) {
        const page = await pdf.getPage(i);
        const viewport = page.getViewport({ scale: 2 });
        const canvas = document.createElement('canvas');
        canvas.width = viewport.width;
        canvas.height = viewport.height;
        const ctx = canvas.getContext('2d')!;
        await page.render({ canvasContext: ctx, viewport, canvas }).promise;
        const blob: Blob = await new Promise((resolve) => canvas.toBlob((b) => resolve(b!), 'image/png'));
        images.push({ name: `page-${i}.png`, blob });

        const thumb = document.createElement('img');
        thumb.src = URL.createObjectURL(blob);
        thumbsEl.appendChild(thumb);
      }

      if (images.length === 1) {
        const url = URL.createObjectURL(images[0].blob);
        statusEl.innerHTML = `<a class="action-btn" href="${url}" download="page-1.png">⬇ Download Image</a>`;
      } else {
        const zip = new JSZip();
        images.forEach((img) => zip.file(img.name, img.blob));
        const zipBlob = await zip.generateAsync({ type: 'blob' });
        const url = URL.createObjectURL(zipBlob);
        statusEl.innerHTML = `<a class="action-btn" href="${url}" download="pages.zip">⬇ Download All (ZIP)</a>`;
      }
    } catch (err) {
      console.error(err);
      statusEl.className = 'status-msg error';
      statusEl.textContent = 'Something went wrong — make sure the file is a valid PDF and try again';
    } finally {
      actionBtn.disabled = false;
    }
  });
</script>
