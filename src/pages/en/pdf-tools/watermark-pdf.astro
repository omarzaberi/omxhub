---
import PdfToolLayout from '../../../layouts/PdfToolLayout.astro';
import { useTranslations } from '../../../i18n/utils';
import { relatedPdfTools } from '../../../data/pdf-tools';

const lang = 'en' as const;
const t = useTranslations(lang);

const faq = [
  { q: 'Can I change the watermark color or size?', a: "Currently it's a semi-transparent gray watermark at a medium size that fits most documents. More customization is coming soon." },
  { q: 'Does the watermark appear on every page?', a: 'Yes, it\'s placed diagonally across the center of every page in the file.' },
];
const steps = [
  { name: 'Upload a PDF', text: 'Drag the file onto the drop zone or click "Choose file".' },
  { name: 'Type your watermark text', text: 'Something like "Draft", "Confidential", or your company name. It defaults to OMXHub and you can change it.' },
  { name: 'Click "Add Watermark"', text: 'The text is placed diagonally across the middle of every page in translucent grey, so it never hides your content.' },
  { name: 'Download the result', text: 'You get a new watermarked PDF; your original file is left untouched.' },
];
const related = relatedPdfTools(lang, 'watermark-pdf');
---
<PdfToolLayout
  lang={lang}
  title="Add Watermark to PDF"
  description="Add a text watermark across every page of a PDF, free and entirely in your browser"
  steps={steps}
  faq={faq}
  related={related}
>
  <div id="drop-zone" class="drop-zone">
    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
    <p class="drop-text">{t('pdf.dropHereSingle')}</p>
    <button type="button" class="choose-btn" id="choose-btn">{t('pdf.chooseFile')}</button>
    <input type="file" id="file-input" accept="application/pdf" />
  </div>

  <div id="file-list" class="file-list"></div>

  <div id="options" class="tool-options" hidden>
    <div>
      <label for="wm-text">Watermark Text</label>
      <input type="text" id="wm-text" placeholder="e.g. Draft, Confidential, Sample" value="OMXHub" />
    </div>
  </div>

  <button type="button" id="action-btn" class="action-btn" disabled>Add Watermark</button>
  <div id="status" class="status-msg" hidden></div>
</PdfToolLayout>

<script>
  import { loadPdfLib } from '../../../lib/pdf-libs';

  const dropZone = document.getElementById('drop-zone')!;
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const chooseBtn = document.getElementById('choose-btn')!;
  const fileListEl = document.getElementById('file-list')!;
  const optionsEl = document.getElementById('options')!;
  const wmText = document.getElementById('wm-text') as HTMLInputElement;
  const actionBtn = document.getElementById('action-btn') as HTMLButtonElement;
  const statusEl = document.getElementById('status')!;

  let currentFile: File | null = null;

  async function loadFile(f: File) {
    currentFile = f;
    // Choosing a file is a commitment to the action, so start fetching the
    // engine now. It is normally parsed and ready before the button is pressed.
    void loadPdfLib();
    fileListEl.innerHTML = `<div class="file-item"><span class="file-name">📄 ${f.name}</span></div>`;
    optionsEl.hidden = false;
    actionBtn.disabled = false;
  }

  chooseBtn.addEventListener('click', () => fileInput.click());
  dropZone.addEventListener('click', (e) => {
    if (e.target === dropZone || (e.target as HTMLElement).tagName !== 'BUTTON') fileInput.click();
  });
  fileInput.addEventListener('change', () => fileInput.files?.[0] && loadFile(fileInput.files[0]));
  dropZone.addEventListener('dragover', (e) => { e.preventDefault(); dropZone.classList.add('dragover'); });
  dropZone.addEventListener('dragleave', () => dropZone.classList.remove('dragover'));
  dropZone.addEventListener('drop', (e) => {
    e.preventDefault();
    dropZone.classList.remove('dragover');
    const f = e.dataTransfer?.files?.[0];
    if (f && f.type === 'application/pdf') loadFile(f);
  });

  actionBtn.addEventListener('click', async () => {
    if (!currentFile) return;
    const text = wmText.value.trim() || 'OMXHub';
    statusEl.hidden = false;
    statusEl.className = 'status-msg';
    statusEl.innerHTML = '<span class="spinner"></span> Adding watermark...';
    actionBtn.disabled = true;
    try {
      const { PDFDocument, StandardFonts, rgb, degrees } = await loadPdfLib();
      const bytes = await currentFile.arrayBuffer();
      const doc = await PDFDocument.load(bytes);
      const font = await doc.embedFont(StandardFonts.HelveticaBold);
      const fontSize = 40;
      const textWidth = font.widthOfTextAtSize(text, fontSize);

      doc.getPages().forEach((page) => {
        const { width, height } = page.getSize();
        page.drawText(text, {
          x: width / 2 - textWidth / 2,
          y: height / 2,
          size: fontSize,
          font,
          color: rgb(0.6, 0.6, 0.6),
          opacity: 0.35,
          rotate: degrees(45),
        });
      });

      const outBytes = await doc.save();
      const blob = new Blob([outBytes], { type: 'application/pdf' });
      const url = URL.createObjectURL(blob);
      statusEl.innerHTML = `<a class="action-btn" href="${url}" download="watermarked.pdf">⬇ Download File</a>`;
    } catch (err) {
      console.error(err);
      statusEl.className = 'status-msg error';
      statusEl.textContent = 'Something went wrong — make sure the file is a valid PDF and try again';
    } finally {
      actionBtn.disabled = false;
    }
  });
</script>
