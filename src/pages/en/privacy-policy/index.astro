---
import Layout from '../../../layouts/Layout.astro';
import { trail } from '../../../lib/schema';
import { useTranslations } from '../../../i18n/utils';

const lang = 'en' as const;
const t = useTranslations(lang);

const schema = trail(lang, [{ name: t('footer.privacy') }]);
---
<Layout title={t('footer.privacy')} description="OMXHub privacy policy: how we handle your data, cookies, Google AdSense advertising, and affiliate links." schema={schema}>
  <section class="wrap section">
    <h1>Privacy Policy</h1>

    <h2>Introduction</h2>
    <p>
      At OMXHub, we respect our visitors' privacy. This policy explains what
      information we collect and how we use it.
    </p>

    <h2>Advertising and Cookies</h2>
    <p>
      This site uses Google AdSense to display ads. Google and its partners
      use cookies to serve ads based on your visits to this site and other
      sites. You can control the personalized ads you see, or opt out, via
      <a href="https://adssettings.google.com" target="_blank" rel="noopener">Google Ads Settings</a>.
    </p>
    <p>
      As a third party, Google uses cookies to serve ads on this site based
      on your prior visits to this site or other sites on the internet.
    </p>

    <h2>Affiliate Links</h2>
    <p>
      Some links on this site may be affiliate links, and we may earn a
      commission when you purchase through them at no extra cost to you.
      This does not affect the independence of our tool reviews.
    </p>

    <h2>Data We Collect</h2>
    <p>
      We may collect general, non-personal analytics data (such as visitor
      counts and page views) to improve the user experience on the site.
    </p>

    <h2>Contact About Privacy</h2>
    <p>
      For any questions about this policy, reach out via our
      <a href="/en/contact">contact page</a>.
    </p>

    <p class="updated">Last updated: August 2026</p>
  </section>
</Layout>

<style>
  .section { padding: 60px 0; max-width: 720px; }
  h1 { margin-bottom: 20px; }
  h2 { font-size: 1.1rem; margin-top: 28px; margin-bottom: 10px; }
  p { margin-bottom: 14px; color: var(--text-dim); }
  p a { color: var(--accent); }
  .updated { margin-top: 30px; font-size: 0.85rem; color: var(--text-dim); }
</style>
