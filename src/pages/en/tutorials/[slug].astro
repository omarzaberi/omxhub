---
import TutorialDetail from '../../../components/TutorialDetail.astro';
import { getCollection } from 'astro:content';
import { slugOf } from '../../../lib/tutorials';

const lang = 'en' as const;

export async function getStaticPaths() {
  const entries = (await getCollection('tutorials')).filter((e) => e.data.lang === 'en');
  return entries.map((entry) => ({
    params: { slug: slugOf(entry) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---
<TutorialDetail lang={lang} entry={entry} />
