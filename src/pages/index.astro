---
import Layout from '../layouts/Layout.astro';
import ToolCard from '../components/ToolCard.astro';
import { categories } from '../data/categories';
import { getCollection } from 'astro:content';

const allTools = await getCollection('tools');
const latest = [...allTools]
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 6);
const featured = allTools.filter((t) => t.data.featured).slice(0, 6);
---
<Layout
  title="الرئيسية"
  description="دليلك العربي لأحدث وأفضل أدوات الذكاء الاصطناعي — شرح، مميزات، أسعار وبدائل لكل أداة"
>
  <section class="hero">
    <div class="wrap">
      <h1>دليلك العربي لأدوات الذكاء الاصطناعي</h1>
      <p>اكتشف، قارن، وافهم أفضل أدوات AI — بشرح عربي واضح لكل أداة: المميزات، العيوب، الأسعار، والبدائل.</p>
      <form class="search" role="search">
        <input type="search" name="q" placeholder="دور عن أداة... مثلاً: توليد صور" />
        <button type="submit">بحث</button>
      </form>
    </div>
  </section>

  <section class="wrap section">
    <h2>أحدث الأدوات المضافة</h2>
    <div class="grid">
      {latest.map((tool) => (
        <ToolCard
          slug={tool.id}
          name={tool.data.name}
          tagline={tool.data.tagline}
          category={tool.data.category}
          pricingType={tool.data.pricingType}
          rating={tool.data.rating}
        />
      ))}
    </div>
  </section>

  <section class="wrap section">
    <h2>الأكثر شعبية</h2>
    <div class="grid">
      {featured.map((tool) => (
        <ToolCard
          slug={tool.id}
          name={tool.data.name}
          tagline={tool.data.tagline}
          category={tool.data.category}
          pricingType={tool.data.pricingType}
          rating={tool.data.rating}
        />
      ))}
    </div>
  </section>

  <section class="wrap section">
    <h2>تصفح حسب التصنيف</h2>
    <div class="cat-grid">
      {Object.values(categories).map((cat) => (
        <a href={`/ai-tools/${cat.slug}`} class="cat-pill">
          <span>{cat.icon}</span> {cat.label}
        </a>
      ))}
    </div>
  </section>
</Layout>

<style>
  .hero {
    background: linear-gradient(135deg, var(--navy) 0%, var(--navy-deep) 100%);
    color: white;
    padding: 70px 0 90px;
    text-align: center;
  }
  .hero h1 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    margin: 0 0 16px;
  }
  .hero p {
    max-width: 560px;
    margin: 0 auto 32px;
    opacity: 0.85;
  }
  .search {
    display: flex;
    max-width: 480px;
    margin: 0 auto;
    background: white;
    border-radius: 10px;
    overflow: hidden;
  }
  .search input {
    flex: 1;
    border: none;
    padding: 14px 16px;
    font-family: inherit;
    font-size: 0.95rem;
  }
  .search input:focus { outline: none; }
  .search button {
    background: var(--gold);
    color: var(--navy-deep);
    border: none;
    padding: 0 24px;
    font-weight: 700;
    cursor: pointer;
    font-family: inherit;
  }

  .section { padding: 50px 0; }
  .section h2 {
    font-size: 1.4rem;
    margin-bottom: 22px;
    border-inline-start: 4px solid var(--gold);
    padding-inline-start: 12px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 18px;
  }
  .cat-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .cat-pill {
    display: flex;
    align-items: center;
    gap: 8px;
    background: white;
    border: 1px solid var(--line);
    border-radius: 100px;
    padding: 10px 18px;
    text-decoration: none;
    color: var(--ink);
    font-size: 0.9rem;
  }
  .cat-pill:hover { border-color: var(--gold); }
</style>
