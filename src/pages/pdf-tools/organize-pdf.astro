---
import PdfToolLayout from '../../layouts/PdfToolLayout.astro';
import { useTranslations } from '../../i18n/utils';
import { relatedPdfTools } from '../../data/pdf-tools';

const lang = 'ar' as const;
const t = useTranslations(lang);

const faq = [
  {
    q: 'أقدر أرتب الصفحات بدون سحب بالماوس؟',
    a: 'نعم. كل صفحة تحتها زرين للتحريك خطوة للخلف أو للأمام، وتشتغل بالكيبورد وباللمس على الجوال. السحب خيار إضافي مو الطريقة الوحيدة.',
  },
  {
    q: 'وش فايدة زر "اعكس الترتيب"؟',
    a: 'يقلب ترتيب كل الصفحات دفعة وحدة. مفيد بالذات مع الملفات اللي طلعت من ماسح ضوئي يمسح من آخر ورقة للأولى.',
  },
  {
    q: 'الترتيب الجديد يأثر على جودة الصفحات؟',
    a: 'لا. الصفحات تُنسخ كما هي بنفس النص والصور والخطوط، والتغيير الوحيد هو ترتيبها داخل المستند.',
  },
  {
    q: 'أقدر أحذف صفحة من هنا؟',
    a: 'هذي الأداة مخصصة للترتيب فقط عشان تبقى بسيطة. للحذف استخدم أداة حذف صفحات من PDF، ثم ارجع هنا لترتيب الناتج.',
  },
];

const steps = [
  { name: 'ارفع ملف PDF', text: 'اسحب الملف لمنطقة الرفع أو اضغط "اختر ملف". الملف ينقرأ داخل متصفحك مباشرة.' },
  { name: 'رتّب الصفحات', text: 'اسحب أي صفحة لمكانها الجديد، أو استخدم الزرين تحت كل صفحة لتحريكها خطوة للخلف أو للأمام.' },
  { name: 'اضغط "حفظ الترتيب الجديد"', text: 'الأداة تبني ملف PDF جديد يتبع الترتيب اللي تشوفه بالمعاينة حرفيًا.' },
  { name: 'حمّل الملف الجديد', text: 'ينزل الملف بالترتيب الجديد، والملف الأصلي على جهازك يبقى كما هو.' },
];

const related = relatedPdfTools(lang, 'organize-pdf');
---
<PdfToolLayout
  lang={lang}
  title="ترتيب صفحات PDF"
  description="رتّب صفحات ملف PDF بالسحب أو بالأزرار، أو اعكس الترتيب كامل — مجانًا وبالكامل داخل متصفحك"
  steps={steps}
  faq={faq}
  related={related}
>
  <div id="drop-zone" class="drop-zone">
    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
    <p class="drop-text">{t('pdf.dropHereSingle')}</p>
    <button type="button" class="choose-btn" id="choose-btn">{t('pdf.chooseFile')}</button>
    <input type="file" id="file-input" accept="application/pdf" />
  </div>

  <div id="file-list" class="file-list"></div>

  <div id="toolbar" class="grid-toolbar" hidden>
    <button type="button" id="reverse">اعكس الترتيب</button>
    <button type="button" id="restore">استرجاع الترتيب الأصلي</button>
    <span class="grid-count" id="count" aria-live="polite"></span>
  </div>

  <div
    id="page-grid"
    class="page-grid"
    data-mode="reorder"
    data-page-label="صفحة"
    data-move-earlier="حرّك للخلف"
    data-move-later="حرّك للأمام"
    role="group"
    aria-label="صفحات الملف — استخدم أزرار التحريك لترتيب الصفحات"
    hidden
  ></div>

  <p id="hint" class="grid-hint" hidden>
    الرقم على كل صفحة هو رقمها بالملف الأصلي، وترتيبها بالشبكة هو ترتيبها بالملف الجديد.
  </p>

  <button type="button" id="action-btn" class="action-btn" disabled>حفظ الترتيب الجديد</button>
  <div id="status" class="status-msg" hidden></div>
</PdfToolLayout>

<script>
  import { loadPdfLib } from '../../lib/pdf-libs';
  import { createPageGrid } from '../../lib/pdf-page-grid';

  const dropZone = document.getElementById('drop-zone')!;
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const chooseBtn = document.getElementById('choose-btn')!;
  const fileListEl = document.getElementById('file-list')!;
  const toolbarEl = document.getElementById('toolbar')!;
  const countEl = document.getElementById('count')!;
  const hintEl = document.getElementById('hint')!;
  const actionBtn = document.getElementById('action-btn') as HTMLButtonElement;
  const statusEl = document.getElementById('status')!;

  let currentFile: File | null = null;

  /** True once the display order differs from the document order. */
  const isReordered = () => grid.getOrder().some((src, position) => src !== position);

  const grid = createPageGrid(document.getElementById('page-grid')!, () => {
    const n = grid.pageCount();
    countEl.textContent = isReordered()
      ? `${n} صفحة — الترتيب معدّل`
      : `${n} صفحة — الترتيب الأصلي`;
    actionBtn.disabled = n === 0;
  });

  async function loadFile(f: File) {
    currentFile = f;
    statusEl.hidden = true;
    actionBtn.disabled = true;
    void loadPdfLib();
    fileListEl.innerHTML = `<div class="file-item"><span class="file-name">📄 ${f.name}</span></div>`;
    try {
      await grid.load(f);
      toolbarEl.hidden = false;
      hintEl.hidden = false;
    } catch (err) {
      console.error(err);
      statusEl.hidden = false;
      statusEl.className = 'status-msg error';
      statusEl.textContent = 'حدث خطأ، تأكد إن الملف PDF صالح وحاول مرة ثانية';
    }
  }

  chooseBtn.addEventListener('click', () => fileInput.click());
  dropZone.addEventListener('click', (e) => {
    if (e.target === dropZone || (e.target as HTMLElement).tagName !== 'BUTTON') fileInput.click();
  });
  fileInput.addEventListener('change', () => fileInput.files?.[0] && loadFile(fileInput.files[0]));
  dropZone.addEventListener('dragover', (e) => { e.preventDefault(); dropZone.classList.add('dragover'); });
  dropZone.addEventListener('dragleave', () => dropZone.classList.remove('dragover'));
  dropZone.addEventListener('drop', (e) => {
    e.preventDefault();
    dropZone.classList.remove('dragover');
    const f = e.dataTransfer?.files?.[0];
    if (f && f.type === 'application/pdf') loadFile(f);
  });

  document.getElementById('reverse')!.addEventListener('click', () => grid.reverse());
  document.getElementById('restore')!.addEventListener('click', () => {
    if (currentFile) loadFile(currentFile);
  });

  actionBtn.addEventListener('click', async () => {
    const order = grid.getOrder();
    if (!currentFile || order.length === 0) return;
    statusEl.hidden = false;
    statusEl.className = 'status-msg';
    statusEl.innerHTML = '<span class="spinner"></span> جاري الحفظ...';
    actionBtn.disabled = true;
    try {
      const { PDFDocument } = await loadPdfLib();
      const srcDoc = await PDFDocument.load(await currentFile.arrayBuffer());
      const newDoc = await PDFDocument.create();
      // copyPages preserves the order of the indices it is given, so the grid's
      // display order becomes the document order with no further work.
      const pages = await newDoc.copyPages(srcDoc, order);
      pages.forEach((p) => newDoc.addPage(p));
      const blob = new Blob([await newDoc.save()], { type: 'application/pdf' });
      const url = URL.createObjectURL(blob);
      statusEl.innerHTML = `<a class="action-btn" href="${url}" download="organized.pdf">⬇ تحميل الملف المرتّب</a>`;
    } catch (err) {
      console.error(err);
      statusEl.className = 'status-msg error';
      statusEl.textContent = 'حدث خطأ، تأكد إن الملف PDF صالح وحاول مرة ثانية';
    } finally {
      actionBtn.disabled = grid.pageCount() === 0;
    }
  });
</script>
