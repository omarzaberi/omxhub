---
import ProsePage from '../../components/ProsePage.astro';
import { useTranslations, localizedPath } from '../../i18n/utils';
import { breadcrumbs, graph, HOME_LABEL } from '../../lib/schema';
import { pdfTools } from '../../data/pdf-tools';
import { imageTools } from '../../data/image-tools';

const lang = 'ar' as const;
const t = useTranslations(lang);

const browserToolCount = pdfTools.length + imageTools.length;

const description =
  'كيف يتعامل OMXHub مع بياناتك: إحصاءات Google Analytics 4 المجهّلة، إعلانات AdSense وملفات تعريف الارتباط، روابط العمولة، ولماذا لا تغادر ملفات أدوات PDF والصور جهازك أصلًا.';

const schema = graph(
  breadcrumbs(lang, [{ name: HOME_LABEL[lang], path: '/' }, { name: t('footer.privacy') }])
);
---
<ProsePage
  lang={lang}
  title="سياسة الخصوصية"
  metaTitle="سياسة الخصوصية — OMXHub"
  description={description}
  crumb={t('footer.privacy')}
  schema={schema}
  updated="2026-08-07"
  updatedLabel="٧ أغسطس ٢٠٢٦"
  lede="هذه الصفحة تشرح ما يُجمع عنك أثناء تصفح OMXHub، ومن يجمعه، ولماذا. كُتبت خصيصًا لهذا الموقع وتصف ما ينفّذه فعلًا — لا قالبًا عامًا."
>
  <h2>مقدمة</h2>
  <p>
    OMXHub موقع محتوى وأدوات مجانية، ولا يطلب منك إنشاء حساب ولا تسجيل الدخول.
    لا نجمع اسمك ولا بريدك ولا أي بيانات تعريفية إلا إذا راسلتنا بنفسك، ولا نبيع
    أي بيانات لأي جهة.
  </p>
  <p>
    ما يجري فعلًا شيئان اثنان: خدمة إحصاءات تقيس كيف يُستخدم الموقع بشكل مجهّل،
    وشبكة إعلانات تعرض إعلانات تموّل بقاء المحتوى مجانيًا. كلاهما من Google،
    وكلاهما موضّح أدناه بالتفصيل. وتنطبق هذه السياسة على نطاق
    <strong>omxhub.com</strong> بنسختيه العربية والإنجليزية.
  </p>
  <div class="callout">
    <p>
      ملاحظة مهمة قبل أي شيء آخر: أدوات PDF وأدوات الصور — وعددها
      {browserToolCount} أداة — تعالج ملفاتك داخل متصفحك، ولا تُرفع مستنداتك إلى
      خوادم OMXHub. تفاصيل ذلك في قسم مستقل أدناه.
    </p>
  </div>

  <h2>إحصاءات الاستخدام (Google Analytics 4)</h2>
  <p>
    نستخدم Google Analytics 4 لمعرفة الصفحات التي تُقرأ فعلًا وأيها لا يجد
    قارئًا، وهو ما يحدد ما نكتبه ونطوّره لاحقًا. البيانات التي تصلنا مجمّعة
    ومجهّلة الهوية: لا نرى من أنت، ولا نستطيع ربط زيارة بشخص بعينه.
  </p>
  <p>ما يُجمع في هذا السياق يشمل عادةً:</p>
  <ul>
    <li>الصفحات التي زرتها ومدة بقائك فيها.</li>
    <li>نوع الجهاز والمتصفح ونظام التشغيل.</li>
    <li>البلد أو المدينة على مستوى تقريبي — لا موقعًا دقيقًا.</li>
    <li>المصدر الذي وصلت منه: محرك بحث، رابط خارجي، أو زيارة مباشرة.</li>
  </ul>
  <p>
    وGoogle Analytics 4 لا يسجّل عنوان IP الخاص بك ضمن البيانات التي تُخزَّن،
    ويستخدم عنوان IP لتقدير الموقع الجغرافي التقريبي فقط ثم يتجاهله. يمكنك منع
    القياس نهائيًا عبر
    <a href="https://tools.google.com/dlpage/gaoptout" target="_blank" rel="noopener">إضافة إلغاء تفعيل Google Analytics</a>
    للمتصفح.
  </p>

  <h2>الإعلانات (Google AdSense)</h2>
  <p>
    يعرض الموقع إعلانات عبر Google AdSense، وهي المصدر الأساسي لتغطية تكاليف
    الاستضافة والتطوير التي تُبقي الأدوات مجانية بلا حد يومي.
  </p>
  <p>
    وGoogle، بصفتها مزوّدًا خارجيًا، تستخدم ملفات تعريف الارتباط لعرض إعلانات
    بناءً على زياراتك السابقة لهذا الموقع أو لمواقع أخرى على الإنترنت. كما قد
    تستخدم Google وشركاؤها ما يُعرف بمعرّف الإعلانات لتخصيص ما يُعرض لك وقياس
    أدائه ومنع تكرار الإعلان نفسه عليك.
  </p>
  <p>
    نحن لا نتحكم في محتوى هذه الإعلانات ولا في البيانات التي تجمعها Google
    عبرها، ولا نطّلع على أي بيانات شخصية من خلالها. للتحكم في الإعلانات المخصّصة
    أو إيقافها:
  </p>
  <ul>
    <li><a href="https://adssettings.google.com" target="_blank" rel="noopener">إعدادات إعلانات Google</a> — لإيقاف التخصيص من حسابك.</li>
    <li><a href="https://policies.google.com/technologies/ads" target="_blank" rel="noopener">كيف تستخدم Google ملفات تعريف الارتباط في الإعلانات</a>.</li>
    <li><a href="https://www.aboutads.info/choices/" target="_blank" rel="noopener">aboutads.info</a> — لإيقاف التخصيص عبر عدة شبكات إعلانية دفعة واحدة.</li>
  </ul>

  <h2>ملفات تعريف الارتباط (Cookies)</h2>
  <p>
    ملف تعريف الارتباط ملف نصي صغير يحفظه المتصفح ليتذكر شيئًا بين الزيارات.
    على OMXHub تأتي هذه الملفات من مصدرين فقط:
  </p>
  <div class="facts">
    <div class="fact">
      <b>ملفات Google (طرف ثالث)</b>
      <span>
        تضعها خدمتا Analytics وAdSense لقياس الاستخدام وعرض الإعلانات. لا نملكها
        ولا نقرأها، وتخضع لسياسة Google لا لسياستنا.
      </span>
    </div>
    <div class="fact">
      <b>تخزين محلي واحد يخصّنا</b>
      <span>
        مفتاح باسم <code>omxhub-theme</code> يحفظ اختيارك للوضع الداكن أو الفاتح.
        يبقى على جهازك ولا يُرسل إلى أي خادم، وليس ملف تعريف ارتباط ولا يتتبّع
        شيئًا.
      </span>
    </div>
  </div>
  <p>
    يمكنك حذف ملفات تعريف الارتباط أو تعطيلها بالكامل من إعدادات متصفحك — في
    Chrome وFirefox وSafari وEdge جميعها خيار لذلك ضمن إعدادات الخصوصية. تعطيلها
    لا يمنعك من استخدام الموقع: المحتوى والأدوات تعمل كما هي، وقد تصبح الإعلانات
    أقل ارتباطًا بك فقط.
  </p>
  <p>
    وننبّه إلى أن نصوص Google لا تُحمّل مع تحميل الصفحة الأول، بل تُؤجَّل إلى ما
    بعد أول تفاعل منك أو حتى تصبح الصفحة خاملة — قرار اتُّخذ أصلًا لأجل سرعة
    التحميل، ونتيجته أن زيارة سريعة لا يُنفَّذ فيها أي نص طرف ثالث.
  </p>

  <h2>روابط التسويق بالعمولة</h2>
  <p>
    بعض الروابط المؤدية إلى مواقع الأدوات هي روابط تسويق بالعمولة، وقد نحصل على
    عمولة إذا اشتركت عبرها — دون أي تكلفة إضافية عليك، ودون أن يتغير السعر الذي
    تدفعه.
  </p>
  <div class="callout">
    <p>
      العمولة لا تشتري تقييمًا. ترتيب الأدوات ودرجاتها وما نكتبه عن عيوبها لا
      يتأثر بوجود رابط عمولة من عدمه، وننشر عيوب الأدوات التي لدينا معها اتفاق
      عمولة بنفس الصراحة. من يزور رابطًا كهذا تنطبق عليه سياسة خصوصية الموقع
      المقصود، لا سياستنا.
    </p>
  </div>

  <h2>التواصل معنا</h2>
  <p>
    لا يوجد على OMXHub نموذج تواصل ولا حقول إدخال تُرسَل إلى خادم.
    <a href={localizedPath(lang, '/contact')}>صفحة التواصل</a> تحتوي على عنوان
    بريد إلكتروني مباشر فقط، وهذا مقصود: النموذج يعني وسيطًا يستقبل رسالتك،
    والبريد المباشر يعني أن رسالتك تذهب إلينا وحدنا.
  </p>
  <p>
    إذا راسلتنا، فسنرى ما تكتبه بنفسك: عنوان بريدك ونص رسالتك وأي مرفق ترسله.
    نستخدم ذلك للرد عليك فحسب، ولا نضيفك إلى قائمة بريدية، ولا نشارك رسالتك مع
    أحد. البريد يُدار عبر Google، وتخضع الرسائل لسياسة خصوصية Google أثناء
    مرورها بخوادمه.
  </p>

  <h2>أدوات PDF والصور: المعالجة داخل متصفحك</h2>
  <p>
    هذا هو القسم الأهم في السياسة لأنه يخالف ما يفترضه معظم الناس عن أدوات
    الإنترنت المجانية.
  </p>
  <div class="callout">
    <p>
      كل أدوات PDF وأدوات الصور على OMXHub تعالج ملفاتك محليًا داخل متصفحك كلما
      كان ذلك ممكنًا. <strong>المستندات التي تفتحها في هذه الأدوات لا تُرسَل إلى
      خوادم OMXHub</strong>، ولا إلى أي خدمة طرف ثالث، ولا تُخزَّن ولا تُفهرس ولا
      يطّلع عليها أحد.
    </p>
  </div>
  <p>
    عمليًا: حين تختار ملفًا، يقرأه المتصفح من قرصك ويعالجه في ذاكرة الجهاز
    باستخدام قدرات مدمجة فيه أصلًا، ثم يُنتج الملف الجديد عندك لتنزّله. لا توجد
    خطوة رفع في هذه العملية، ولا يوجد في هذا المشروع خادم رفع من الأساس.
    وبإغلاق التبويب يُمحى كل شيء من الذاكرة.
  </p>
  <p>يترتب على ذلك أمور عملية تستحق الوضوح:</p>
  <ul>
    <li>لا حد يومي لعدد الملفات، لأنه لا توجد جهة تحسبها.</li>
    <li>تعمل الأدوات دون اتصال بعد تحميل الصفحة، لأن المعالجة كلها محلية.</li>
    <li>حجم الملف مقيّد بذاكرة جهازك لا بحصة خادم.</li>
    <li>إعادة ترميز الصور تُزيل بيانات EXIF بما فيها إحداثيات التصوير — وهذا في صالحك عند النشر، لكن انتبه له إن كنت تحتاج تلك البيانات.</li>
  </ul>
  <p>
    وإن استحال يومًا تنفيذ أداة داخل المتصفح، فسنقول ذلك صراحةً في صفحتها قبل أن
    تستخدمها، لا أن نبني بصمت نسخة ترفع ملفاتك.
  </p>

  <h2>تخزين البيانات</h2>
  <p>
    OMXHub موقع ثابت (Static) مستضاف على Netlify، ولا توجد خلفه قاعدة بيانات ولا
    نظام حسابات ولا مساحة تخزين للمستخدمين. لا نحتفظ بملفات ولا بسجلات محتوى ولا
    بملفات شخصية، ببساطة لأنه لا يوجد مكان لدينا لحفظها.
  </p>
  <p>
    ما يُحفظ على جهازك أنت: تفضيل المظهر الداكن أو الفاتح، وملفات تعريف الارتباط
    التي تضعها Google. وما يُحفظ لدى Google: الإحصاءات المجهّلة وفق مدد الاحتفاظ
    المعمول بها لديها. وتحتفظ Netlify، كأي مستضيف، بسجلات خادم تقنية مؤقتة تشمل
    عناوين IP لأغراض التشغيل والحماية من إساءة الاستخدام، ولا نصل إليها لأغراض
    تحليلية.
  </p>

  <h2>خدمات الطرف الثالث</h2>
  <p>هذه هي كل الجهات الخارجية التي تتعامل معها زيارتك، وليست هناك غيرها:</p>
  <div class="facts">
    <div class="fact">
      <b>Google Analytics 4</b>
      <span>
        إحصاءات استخدام مجهّلة —
        <a href="https://policies.google.com/privacy" target="_blank" rel="noopener">سياسة خصوصية Google</a>.
      </span>
    </div>
    <div class="fact">
      <b>Google AdSense</b>
      <span>
        عرض الإعلانات —
        <a href="https://policies.google.com/technologies/partner-sites" target="_blank" rel="noopener">كيف تستخدم Google البيانات في مواقع شركائها</a>.
      </span>
    </div>
    <div class="fact">
      <b>Netlify</b>
      <span>استضافة الموقع وشبكة توزيع المحتوى، مع سجلات خادم تقنية فقط.</span>
    </div>
    <div class="fact">
      <b>Ko-fi</b>
      <span>
        منصة الدعم الاختياري. لا تتفاعل معها إلا إذا ضغطت زر الدعم بنفسك، وأي
        عملية دفع تتم بالكامل لديها لا عندنا — ولا نطّلع على بيانات بطاقتك.
      </span>
    </div>
  </div>
  <p>
    نحن لا نستخدم بكسلات تتبّع من شبكات التواصل، ولا خرائط حرارة، ولا تسجيل
    جلسات، ولا أدوات تعرّف على الزائر بين المواقع.
  </p>

  <h2>حقوقك</h2>
  <p>
    بما أننا لا نحتفظ بحساب لك ولا ببيانات شخصية، فإن أغلب الحقوق التي تكفلها
    أنظمة حماية البيانات — مثل اللائحة الأوروبية العامة GDPR ونظام حماية البيانات
    الشخصية السعودي — تُمارَس هنا مباشرةً وبلا وسيط:
  </p>
  <ul>
    <li><strong>الوصول والحذف:</strong> لا يوجد لدينا ما يُطلب الوصول إليه أو حذفه. وإن كنت قد راسلتنا، يمكنك طلب حذف مراسلتك.</li>
    <li><strong>الاعتراض على التتبّع:</strong> عبر إعدادات متصفحك، أو إضافة إلغاء Analytics، أو إعدادات إعلانات Google.</li>
    <li><strong>سحب الموافقة:</strong> بحذف ملفات تعريف الارتباط أو تعطيلها في أي وقت.</li>
    <li><strong>البيانات لدى Google:</strong> تُدار من <a href="https://myaccount.google.com/data-and-privacy" target="_blank" rel="noopener">حسابك في Google</a> مباشرةً.</li>
  </ul>
  <p>
    ولأي طلب أو استفسار يتعلق بالخصوصية، راسلنا وسنرد.
  </p>

  <h2>تعديلات هذه السياسة</h2>
  <p>
    قد نُحدّث هذه الصفحة عند إضافة قسم جديد للموقع أو تغيير خدمة نعتمد عليها.
    ويُحدَّث تاريخ آخر تعديل أعلى الصفحة مع كل تغيير جوهري، فهو المرجع لمعرفة ما
    إذا كانت النسخة التي قرأتها هي السارية.
  </p>
  <p>
    وإن طرأ تغيير يوسّع ما يُجمع عنك — لا يضيّقه — فلن نكتفي بتعديل التاريخ، بل
    سنوضّحه صراحةً في الصفحة نفسها.
  </p>

  <h2>معلومات التواصل</h2>
  <p>
    الجهة المسؤولة عن هذا الموقع هي <strong>عمر زبيري</strong>، مالك OMXHub
    ومحرّره. لأي سؤال عن هذه السياسة أو عن بياناتك، تواصل عبر
    <a href="mailto:omar.zaberi@gmail.com">omar.zaberi@gmail.com</a>
    أو من <a href={localizedPath(lang, '/contact')}>صفحة التواصل</a>.
  </p>
  <p>
    ولمعرفة المزيد عن المشروع ومنهجية المراجعة فيه، اطّلع على
    <a href={localizedPath(lang, '/about')}>صفحة من نحن</a>.
  </p>
</ProsePage>
